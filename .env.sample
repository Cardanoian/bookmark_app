# ============================================================================
# 「책갈피」 자격증명(credentials) 샘플
# ============================================================================
#
# ⚠️ 이 앱의 키 소스는 두 가지이며 순서가 있습니다.
#    ① ENV(process 환경변수)가 있으면 **우선** 사용합니다 — 운영자 대안 경로(선택).
#    ② ENV 가 없으면 **Rails 암호화 credentials** 로 폴백합니다 — 기본·권장 저장소.
#
#    아래 YAML 블록은 ②(credentials) 용입니다. 그대로 복사해 `bin/rails credentials:edit`
#    로 열리는 편집기에 붙여넣고, "" 자리에 실제 키를 채워 저장하세요.
#      bin/rails credentials:edit      # config/credentials.yml.enc 편집(master.key 로 복호화)
#
#    ①(ENV) 로 쓰려면 각 키 옆에 적힌 ENV 변수명을 셸에 export 하면 됩니다(예: 로컬 실험).
#    프로덕션(Kamal)은 RAILS_MASTER_KEY 만 주입하고 API 키는 credentials 에서 읽습니다.
#
# - 키가 하나도 없어도 앱은 폴백 경로로 완전히 동작합니다(사진 OCR만 비활성).
# - 실제 키는 절대 이 파일이나 git 에 커밋하지 마세요(이 샘플은 빈 값만 유지).
# - 발급처·폴백 동작·프로덕션 주입 절차는 docs/API_KEYS.md 참고.
# ============================================================================

# ┌───────────────────────────────────────────────────────────────────────────
# │ 아래를 통째로 복사 → `bin/rails credentials:edit` 에 붙여넣기 (값 "" = 폴백)
# └───────────────────────────────────────────────────────────────────────────
#
# # 프로덕션 부팅 필수 (API 키 아님, 삭제 금지 — 최초 생성 시 자동 존재)
# secret_key_base: "…(자동 생성됨, 그대로 둠)…"
#
# # Google Gemini — 사진 OCR·AI 5축 첨삭·진위 보조·퀴즈 초안 생성
# #   발급: https://aistudio.google.com   |  없으면: 규칙기반 첨삭·오프라인 퀴즈, OCR 비활성
# #   ENV: GEMINI_API_KEY
# gemini:
#   api_key: ""
#
# # 네이버 도서 검색 — 도서 검색 단독 제공자
# #   발급: https://developers.naver.com  |  없으면: 로컬 캐시(books LIKE) 폴백
# #   ENV: NAVER_CLIENT_ID / NAVER_CLIENT_SECRET
# naver:
#   client_id: ""
#   client_secret: ""
#
# # 정보나루(data4library) — 사서 대시보드 인기대출 동기화
# #   발급: https://data4library.kr       |  없으면: CSV 업로드로 대체
# #   ENV: DATA4LIBRARY_KEY
# data4library:
#   api_key: ""
#
# # NEIS 학교기본정보 — 전국 초등학교 스냅샷 갱신(bin/rails schools:fetch)
# #   발급: https://open.neis.go.kr        |  없으면: 커밋된 전국 CSV 사용, 원격 갱신만 생략
# #   ENV: NEIS_API_KEY
# neis:
#   api_key: ""
#
# # Resend — 교직원 비밀번호 재설정 · 교사 가입 이메일 인증 메일 발송
# #   발급: https://resend.com             |  없으면: 메일 미발송 + 이메일 인증 게이트 자동 비활성
# #   ENV: RESEND_API_KEY  (발신 주소 오버라이드는 MAIL_FROM, 기본 "책갈피 <admin@gbeai.net>")
# #   ※ 발신 도메인(gbeai.net)이 Resend 에서 검증돼 있어야 임의 수신자에게 발송된다.
# resend:
#   api_key: ""

# ── 프로덕션 ────────────────────────────────────────────────────────────────
# 서버는 위 credentials 를 RAILS_MASTER_KEY(= config/master.key 내용)로 복호화합니다.
# 서버에 개별 키를 넣을 필요 없이 마스터 키만 주입하면 됩니다(docs/API_KEYS.md §3.2).
#
#   RAILS_MASTER_KEY=<config/master.key 파일 내용>
