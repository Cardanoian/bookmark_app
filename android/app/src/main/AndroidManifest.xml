<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      권한은 INTERNET 하나뿐이다(계획 P3 최소 권한).
      · CAMERA 를 선언하지 않는다 — 앱이 카메라를 직접 제어하지 않고 시스템 카메라
        Intent(ACTION_IMAGE_CAPTURE)에 위임하기 때문이다.
      · READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE / WRITE_EXTERNAL_STORAGE 를 선언하지 않는다 —
        Android Photo Picker 와 문서 선택기가 권한 없이 동작한다.
      새 권한을 추가하기 전에 계획 §9.4 release Manifest 감사 항목을 먼저 확인할 것.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 카메라가 없는 기기에서도 설치·실행 가능해야 한다(사진 선택기만 제공). -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".ChaekgalpiApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Chaekgalpi"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!--
          launcher 로 export 되는 유일한 컴포넌트.
          화면 회전을 잠그지 않는다 — Galaxy Tab 가로 심사가 가능해야 한다(계획 §8.3).
          configChanges 로 회전 시 Activity 재생성을 피해 WebView 상태와 작성 중 폼을 보존한다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
