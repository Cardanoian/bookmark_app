<?xml version="1.0" encoding="utf-8"?>
<!--
  공식 `hotwire_fragment_web.xml` 에서 AppBarLayout/MaterialToolbar 만 제거한 판본이다.
  Rails 가 렌더하는 노란 브랜드 헤더가 이미 제목·내비게이션을 담당하므로 네이티브 툴바는 중복이다.

  ⚠️ `@layout/hotwire_view` include 는 **반드시 유지**한다 — 그 안에 WebView 컨테이너뿐 아니라
  로딩 progress(`hotwire_progress_container`)와 오류 화면(`hotwire_error_container`)이 들어 있다.
  이걸 빼면 툴바와 함께 오류·로딩 UI 까지 사라진다.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <include
        layout="@layout/hotwire_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
