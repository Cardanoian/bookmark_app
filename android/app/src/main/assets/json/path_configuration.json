{
  "settings": {
    "schema_version": 1,
    "minimum_supported_version": "1.0.0"
  },
  "rules": [
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "context": "default",
        "uri": "hotwire://fragment/web",
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/$",
        "^/session/new$"
      ],
      "properties": {
        "presentation": "replace_root"
      }
    },
    {
      "patterns": [
        "^/teacher/exports/reports_csv$"
      ],
      "properties": {
        "download": true,
        "download_mime": "text/csv",
        "download_filename": "5축_사전사후.csv"
      }
    },
    {
      "patterns": [
        "^/admin/analytics/export$"
      ],
      "properties": {
        "download": true,
        "download_mime": "text/csv",
        "download_filename": "전국_독서통계.csv"
      }
    },
    {
      "patterns": [
        "\\.pdf$"
      ],
      "properties": {
        "download": true,
        "download_mime": "application/pdf"
      }
    }
  ]
}
