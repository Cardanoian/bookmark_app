# See https://docs.docker.com/engine/reference/builder/#dockerignore-file for more about ignoring files.

# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore assets.
/node_modules/
/app/assets/builds/*
!/app/assets/builds/.keep
/public/assets

# Ignore CI service files.
/.github

# Ignore Kamal files.
/config/deploy*.yml
/.kamal

# Ignore development files
/.devcontainer

# Ignore Docker-related files
/.dockerignore
/Dockerfile*

# Ignore Python 몬스터 스프라이트 파이프라인 산출물(앱 런타임과 무관, 155M+)
/script/.venv
/script/output
**/__pycache__

# Ignore OMC/OMX 오퍼레이션 상태(앱과 무관)
/.omc
/.omx
/script
/docs
/manual
# Android 네이티브 셸(앱 런타임과 무관). Gradle 캐시·빌드 산출물이 수백 MB 라
# 심사위원용 `docker compose up` 과 Kamal 프로덕션 빌드 컨텍스트에서 모두 제외한다.
/android
