#!/bin/bash -e
#
# 심사·시연용 개발 컨테이너 진입점.
# 비밀키(RAILS_MASTER_KEY)·외부 API 키 없이 개발 모드로 부팅하고, 최초 1회 데모 데이터를 채운다.

echo "════════════════════════════════════════════════════════════"
echo "  📖 책갈피 (Chaekgalpi) — 심사용 개발 서버 준비 중"
echo "════════════════════════════════════════════════════════════"

# 최초 1회만: DB 생성 + 스키마 적재 + 시드(전국 학교·도서 + 데모 사용 데이터).
# 도서 8,500여 권·데모 학급까지 적재하므로 처음엔 수 분 걸릴 수 있습니다.
if [ ! -f storage/development.sqlite3 ]; then
  echo "  [1/3] 최초 실행: 데이터베이스 생성 및 데모 데이터 적재 (수 분 소요)…"
  SEED_DEMO=1 ./bin/rails db:setup
else
  echo "  [1/3] 기존 데이터베이스 발견 — 스키마만 최신화합니다."
  ./bin/rails db:prepare
fi

echo "  [2/3] 화면 스타일(Tailwind CSS) 빌드…"
./bin/rails tailwindcss:build >/dev/null

echo "  [3/3] 서버 시작"
echo "════════════════════════════════════════════════════════════"
echo "  ✅ 준비 완료!  브라우저에서 아래 주소를 여세요:"
echo ""
echo "        👉  http://localhost:3000"
echo ""
echo "  로그인 계정은 docs/JUDGE_GUIDE.md 를 참고하세요."
echo "  (종료: 이 창에서 Ctrl+C)"
echo "════════════════════════════════════════════════════════════"

exec ./bin/rails server -b 0.0.0.0 -p 3000
