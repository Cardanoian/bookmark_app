<%# 학교 선택 하이브리드 피커(계획 §2.4) — 가입/로그인 공용.
    시도(region)→시군구(gu) 캐스케이딩 + 이름검색이 **클릭 가능한 결과 목록**(results)을 채우고,
    항목 클릭이 hidden school_id 를 세팅한다(select 재조작 불필요). gu 가 비거나 부정확해도
    이름검색으로 항상 도달(graceful degrade).
    locals: regions(시도교육청명 배열), with_classroom(로그인 폼이면 true → 스코프 학급 드롭다운). %>
<% with_classroom = local_assigns.fetch(:with_classroom, false) %>
<div data-controller="school-picker" class="space-y-3">
  <div class="grid grid-cols-2 gap-3">
    <div>
      <%= label_tag :picker_region, "시도", class: "form-label" %>
      <select data-school-picker-target="region" data-action="change->school-picker#regionChanged"
              class="form-select">
        <option value="">시도 선택</option>
        <% regions.each do |region| %>
          <option value="<%= region %>"><%= school_region_label(region) %></option>
        <% end %>
      </select>
    </div>
    <div>
      <%= label_tag :picker_gu, "시군구", class: "form-label" %>
      <select data-school-picker-target="gu" data-action="change->school-picker#guChanged"
              class="form-select" disabled>
        <option value="">시군구 선택</option>
      </select>
    </div>
  </div>

  <div>
    <%= label_tag :picker_query, "학교 이름으로 찾기", class: "form-label" %>
    <%= text_field_tag :picker_query, nil,
          data: { "school-picker-target": "query", action: "input->school-picker#searchByName" },
          placeholder: "이름 일부를 입력하면 아래 목록이 채워져요", autocomplete: "off",
          class: "form-input" %>
  </div>

  <div>
    <span class="form-label" id="school_picker_label">학교</span>
    <%# 선택 학교 id 는 hidden 필드에 담긴다(클릭 선택). 결과는 아래 목록으로 렌더된다. %>
    <%= hidden_field_tag :school_id, nil, id: "school_id",
          data: { "school-picker-target": "school" } %>
    <p data-school-picker-target="selected"
       class="mt-1 rounded-lg bg-surface px-3 py-2 text-sm font-medium text-ink" hidden></p>
    <ul data-school-picker-target="results" aria-labelledby="school_picker_label"
        class="mt-2 max-h-60 space-y-1 overflow-y-auto rounded-xl border border-hairline bg-canvas p-1"
        hidden></ul>
    <p class="mt-1 text-xs text-steel">시도·시군구를 고르거나 이름으로 검색한 뒤, 목록에서 학교를 선택하세요.</p>
  </div>

  <% if with_classroom %>
    <div>
      <%= label_tag :classroom_id, "학급 (선택)", class: "form-label" %>
      <select name="classroom_id" id="classroom_id" data-school-picker-target="classroom"
              class="form-select" disabled>
        <option value="">학급 없음</option>
      </select>
    </div>
  <% end %>
</div>
