<% content_for :title, "학생 기여 문제 검토 · 책갈피" %>
<% axis_label = { "mcq" => "❓ 객관식 퀴즈", "hint_reveal" => "🕵️ 나는 누구게?" } %>
<% band_label = { "g12" => "1~2학년", "g34" => "3~4학년", "g56" => "5~6학년" } %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :dashboard %>

    <section class="min-w-0 flex-1 space-y-6">
      <header class="page-header">
        <h1 class="page-title">학생 기여 문제 검토</h1>
      </header>

      <p class="text-sm text-steel">
        학생이 낸 문제예요. 내용과 정답을 확인·수정하고 학년(밴드)을 정한 뒤 <strong>승인</strong>하면
        전국 친구들의 문제은행에 들어가요. 문제가 있으면 <strong>반려</strong>하세요.
      </p>

      <% if @contributions.any? %>
        <ul class="space-y-4">
          <% @contributions.each do |contribution| %>
            <li class="card space-y-3">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="text-sm text-slate">
                  <strong><%= contribution.user.name %></strong> ·
                  「<%= contribution.book.title %>」 ·
                  <span class="badge badge-neutral"><%= axis_label[contribution.content_axis] %></span>
                </span>
                <span class="text-xs text-steel"><%= contribution.created_at.strftime("%-m/%-d %H:%M") %></span>
              </div>

              <%# 수정 저장(PATCH update) — 독립 폼. 승인·반려와 형제(non-nested)로 분리한다: form_with
                  가 렌더하는 히든 _method=patch 가 formaction(POST)에도 실려 Rack::MethodOverride 가
                  POST 를 PATCH 로 승격시켜 404 나던 문제(중첩 formaction/버튼_to)를 원천 차단한다. %>
              <%= form_with model: contribution, url: teacher_quiz_contribution_path(contribution),
                    method: :patch, class: "space-y-3" do %>
                <div>
                  <label class="form-label" for="band-<%= contribution.id %>">학년(밴드)</label>
                  <select id="band-<%= contribution.id %>" name="quiz_contribution[band]" class="form-input">
                    <% band_label.each do |value, label| %>
                      <option value="<%= value %>" <%= "selected" if contribution.band == value %>><%= label %></option>
                    <% end %>
                  </select>
                </div>

                <% if contribution.content_axis == "mcq" %>
                  <div>
                    <label class="form-label">질문</label>
                    <%= text_field_tag "quiz_contribution[prompt]", contribution.payload_hash[:prompt], class: "form-input" %>
                  </div>
                  <fieldset class="space-y-2">
                    <legend class="form-label">보기 4개 · 정답 선택</legend>
                    <% choices = Array(contribution.payload_hash[:choices]) %>
                    <% answer_number = contribution.payload_hash[:answer_index].to_i + 1 %>
                    <% 4.times do |i| %>
                      <label class="flex items-center gap-2 text-sm text-ink">
                        <input type="radio" name="quiz_contribution[answer_number]" value="<%= i + 1 %>"
                               <%= "checked" if answer_number == i + 1 %> />
                        <span class="w-5 text-muted"><%= i + 1 %></span>
                        <%= text_field_tag "quiz_contribution[choices][]", choices[i], class: "form-input flex-1" %>
                      </label>
                    <% end %>
                  </fieldset>
                <% else %>
                  <div>
                    <label class="form-label">정답</label>
                    <%= text_field_tag "quiz_contribution[answer]", contribution.payload_hash[:answer], class: "form-input" %>
                  </div>
                  <fieldset class="space-y-2">
                    <legend class="form-label">힌트(2개 이상)</legend>
                    <% hints = Array(contribution.payload_hash[:hints]) %>
                    <% [ hints.size, 3 ].max.times do |i| %>
                      <%= text_field_tag "quiz_contribution[hints][]", hints[i], class: "form-input", placeholder: "힌트 #{i + 1}" %>
                    <% end %>
                  </fieldset>
                <% end %>

                <div>
                  <label class="form-label">해설(선택)</label>
                  <%= text_field_tag "quiz_contribution[explanation]", contribution.payload_hash[:explanation], class: "form-input" %>
                </div>

                <%= submit_tag "저장", class: "btn btn-secondary btn-sm" %>
              <% end %>

              <%# 승인·반려 — 수정 폼 밖의 독립 button_to(각각 자기 완결 폼). 승인은 "방금 저장(update)한
                  현재 페이로드"를 물질화하므로, 내용을 바꿨다면 먼저 저장 → 승인 2스텝이면 된다. %>
              <div class="flex flex-wrap items-center gap-2">
                <%= button_to "승인", approve_teacher_quiz_contribution_path(contribution), method: :post,
                      class: "btn btn-primary btn-sm" %>
                <%= button_to "반려", reject_teacher_quiz_contribution_path(contribution), method: :post,
                      class: "btn btn-danger btn-sm",
                      form: { data: { turbo_confirm: "이 문제를 반려할까요?" } } %>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <%= render "shared/empty_state", message: "검토할 학생 기여 문제가 없어요." %>
      <% end %>
    </section>
  </div>
</div>
