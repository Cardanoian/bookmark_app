<% content_for :title, "새 계정 연동 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :account_links %>

    <section class="min-w-0 flex-1 space-y-6">
      <header class="page-header">
        <h1 class="page-title">새 계정 연동</h1>
      </header>

      <%# 1) 작년 계정 이름검색 %>
      <div class="card space-y-3">
        <h2 class="font-semibold text-ink">1. 작년 계정 찾기</h2>
        <%= form_with url: new_teacher_account_link_path, method: :get, class: "flex flex-wrap gap-2" do %>
          <%= text_field_tag :old_name, params[:old_name], class: "form-input flex-1",
                placeholder: "작년 학생 이름", autocomplete: "off" %>
          <%= submit_tag "검색", class: "btn btn-secondary" %>
        <% end %>
      </div>

      <%# 2) 연동 폼(현재 학생 NEW + 후보 작년 계정 OLD) %>
      <%= form_with url: teacher_account_links_path, method: :post, class: "card space-y-4" do %>
        <div>
          <%= label_tag :new_account_id, "현재 학급 학생", class: "form-label" %>
          <%= select_tag :new_account_id,
                options_from_collection_for_select(@students, :id, :name),
                include_blank: "학생 선택", class: "form-select" %>
        </div>

        <div>
          <span class="form-label">이어받을 작년 계정</span>
          <% if @candidates.any? %>
            <ul class="space-y-2">
              <% @candidates.each do |candidate| %>
                <li>
                  <label class="flex items-center gap-2 rounded-lg bg-surface px-3 py-2">
                    <%= radio_button_tag :old_account_id, candidate.id %>
                    <span class="text-sm"><%= candidate.classroom&.label_with_year %> · <%= candidate.name %></span>
                  </label>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-steel">위에서 작년 학생 이름을 검색해 후보를 고르세요.</p>
          <% end %>
        </div>

        <%= hidden_field_tag :old_name, params[:old_name] %>
        <%= submit_tag "연동하기", class: "btn btn-primary btn-block" %>
      <% end %>

      <p class="text-center text-sm">
        <%= link_to "← 연동 목록으로", teacher_account_links_path, class: "text-steel underline" %>
      </p>
    </section>
  </div>
</div>
