<%# 미션 폼. locals: mission, classrooms %>
<%= form_with model: mission, url: (mission.persisted? ? teacher_mission_path(mission) : teacher_missions_path),
      class: "space-y-4 rounded-lg border border-gray-200 p-5" do |f| %>
  <% if mission.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
      <%= mission.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "미션 제목", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
  </div>

  <% if classrooms.size > 1 %>
    <div>
      <%= f.label :classroom_id, "학급", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :classroom_id, classrooms, :id, :label, {},
            class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :start_date, "시작일", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.date_field :start_date, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :end_date, "종료일", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.date_field :end_date, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "취소", teacher_missions_path, class: "text-sm text-gray-500" %>
  </div>
<% end %>
