<% content_for :title, "미션 수정 · 책갈피" %>

<div class="page-shell page-shell-form space-y-4">
  <%= link_to "← 미션 관리", teacher_missions_path, class: "text-sm text-steel hover:text-ink" %>
  <h1 class="page-title">미션 수정</h1>

  <% if @mission.draft? %>
    <%= render "form", mission: @mission, classrooms: @classrooms %>
  <% else %>
    <%# 발행 후 잠금: 제목·설명만 수정 가능(목표·기간·보상·학급 잠금). %>
    <%= form_with model: @mission, url: teacher_mission_path(@mission), class: "card space-y-4" do |f| %>
      <% if @mission.errors.any? %>
        <div class="state-banner state-banner--error" role="alert">
          <span aria-hidden="true">⚠️</span>
          <span><%= @mission.errors.full_messages.to_sentence %></span>
        </div>
      <% end %>
      <p class="text-sm text-steel">발행된 미션은 <strong>제목·설명</strong>만 수정할 수 있어요. 목표·기간·보상을 바꾸려면 취소 후 새로 만드세요.</p>
      <div>
        <%= f.label :title, "미션 제목", class: "form-label" %>
        <%= f.text_field :title, class: "form-input", maxlength: 80 %>
      </div>
      <div>
        <%= f.label :description, "설명", class: "form-label" %>
        <%= f.text_area :description, rows: 2, class: "form-input" %>
      </div>
      <div class="page-actions">
        <%= f.submit "저장", class: "btn btn-primary" %>
        <%= link_to "취소", teacher_mission_path(@mission), class: "btn btn-secondary" %>
      </div>
    <% end %>
  <% end %>
</div>
