<% content_for :title, "미션 관리 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :missions %>

    <section class="min-w-0 flex-1 space-y-6">
      <header class="page-header">
        <h1 class="page-title">미션 관리</h1>
        <%= link_to "새 미션", new_teacher_mission_path, class: "btn btn-blue" %>
      </header>

      <% if @missions.any? %>
        <div class="space-y-3">
          <% @missions.each do |mission| %>
            <div class="card flex items-center justify-between gap-3">
              <span class="min-w-0">
                <span class="block font-medium text-ink"><%= mission.title %></span>
                <span class="block text-xs text-steel">
                  <%= mission.classroom&.label %>
                  <% if mission.start_date || mission.end_date %>
                    · <%= mission.start_date %> ~ <%= mission.end_date %>
                  <% end %>
                </span>
              </span>
              <div class="flex shrink-0 items-center gap-2">
                <%= link_to "보기", teacher_mission_path(mission), class: "text-sm text-brand-blue" %>
                <%= link_to "수정", edit_teacher_mission_path(mission), class: "text-sm text-slate" %>
                <%= button_to "삭제", teacher_mission_path(mission), method: :delete,
                      form: { data: { turbo_confirm: "삭제할까요?" } },
                      class: "btn btn-sm btn-danger" %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "등록된 미션이 없어요.", icon: "🎯" %>
      <% end %>
    </section>
  </div>
</div>
