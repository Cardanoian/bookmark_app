<%# 미션 상태 배지. locals: mission. 발행은 날짜로 예정/진행 중/종료 파생. %>
<% label, tone =
     if mission.draft?
       [ "초안", "bg-surface text-steel" ]
     elsif mission.cancelled?
       [ "취소", "bg-red-100 text-red-700" ]
     elsif mission.archived?
       [ "보관", "bg-surface text-steel" ]
     elsif mission.scheduled?
       [ "예정", "bg-blue-100 text-blue-700" ]
     elsif mission.active?
       [ "진행 중", "bg-green-100 text-green-700" ]
     else
       [ "종료", "bg-surface text-steel" ]
     end %>
<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-semibold <%= tone %>"><%= label %></span>
