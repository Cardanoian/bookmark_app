<% content_for :title, "독후감 검토 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :reviews %>

    <section class="min-w-0 flex-1 space-y-6">
      <header class="page-header">
        <div class="min-w-0">
          <h1 class="page-title">
            <%= @report.book&.title.presence || @report.book_title %>
          </h1>
          <p class="page-subtitle"><%= @report.user.name %></p>
        </div>
        <%# 등급은 **지금 제출의 첨삭이 완성됐을 때만** 보인다 — 다시 낸 글에는 이전 제출의 등급이 남아 있다. %>
        <%= level_badge(@report.level) if @report.review_ready? %>
      </header>

      <section class="card">
        <h2 class="mb-2 text-sm font-semibold text-steel">학생이 쓴 글</h2>
        <p class="whitespace-pre-wrap text-ink"><%= @report.body %></p>
      </section>

      <%# 사진(OCR) 독후감이면 원본 손글씨를 함께 놓아 교사가 본문과 대조하며 검토한다. %>
      <%= render "reports/ocr_photo", report: @report %>

      <%# 지금 제출(현재 버전)의 첨삭이 완성된 글만 첨삭 내용·편집 칸·승인을 보인다(Report#review_ready?).
          다시 낸 글에는 **이전 제출의 첨삭**이 남아 있어, 준비 중에 그것을 보여 주면 교사가 옛 첨삭을 읽고
          새 글을 승인하게 된다. 준비 중·실패는 상태만 알리고, 실패·멈춤은 같은 버전으로 다시 요청할 수 있다. %>
      <% if @report.review_ready? %>
      <section class="card">
        <h2 class="mb-3 text-lg font-semibold text-ink">AI 첨삭</h2>
        <%= render "reports/rubric", report: @report %>
      </section>


      <%= form_with model: @report, url: teacher_review_path(@report), method: :patch, class: "card space-y-4 bg-surface-featured" do |f| %>
        <%# 교사가 이 화면에서 확인한 제출 버전. 화면을 연 뒤 학생이 다시 냈으면 서버가 저장을 받지 않는다. %>
        <%= hidden_field_tag :review_version, @report.review_version, id: "review_form_version" %>
        <h2 class="text-lg font-semibold text-brand-blue">5축 조정 · 코멘트</h2>
        <% teacher_scores = @report.teacher_rubric_scores %>
        <div class="grid gap-3 sm:grid-cols-2">
          <% @report.rubric_scores.each do |axis, score| %>
            <label class="flex items-center justify-between gap-2 text-sm">
              <span class="text-slate"><%= axis_label(axis) %> (AI <%= score %>)</span>
              <%= number_field_tag "report[teacher_rubric][#{axis}]", teacher_scores[axis] || score,
                    in: 0..5, class: "form-input w-20 text-center" %>
            </label>
          <% end %>
        </div>

        <div>
          <%= label_tag "report_teacher_comment", "교사 코멘트", class: "form-label" %>
          <%= text_area_tag "report[teacher_comment]", @report.teacher_comment, rows: 3, class: "form-textarea" %>
        </div>

        <%# AI 첨삭 텍스트 편집(승인 후 학생이 볼 최종본). 현재값은 teacher_feedback 있으면 그것,
            없으면 AI 프리필(student_feedback). 칭찬/보완=줄 단위, 성장=항목별 고정 text(성취기준 읽기전용). %>
        <% student_feedback = @report.student_feedback %>
        <div class="space-y-4 border-t border-hairline-soft pt-4">
          <div>
            <h3 class="text-base font-semibold text-brand-blue">첨삭 내용 편집</h3>
            <p class="mt-1 text-sm text-steel">칭찬·보완은 한 줄에 하나씩 적어요. 성장 제안은 문장만 고칠 수 있고, 성취기준 코드는 그대로 유지돼요.</p>
          </div>

          <div>
            <%= label_tag "report_teacher_feedback_praise", "잘한 점 (한 줄에 하나)", class: "form-label" %>
            <%= text_area_tag "report[teacher_feedback][praise]", student_feedback[:praise].join("\n"), rows: 3, class: "form-textarea" %>
          </div>

          <div>
            <%= label_tag "report_teacher_feedback_fix", "보완할 점 (한 줄에 하나)", class: "form-label" %>
            <%= text_area_tag "report[teacher_feedback][fix]", student_feedback[:fix].join("\n"), rows: 3, class: "form-textarea" %>
          </div>

          <% if student_feedback[:grow].any? %>
            <fieldset class="min-w-0 space-y-3">
              <legend class="form-label">성장 제안</legend>
              <% student_feedback[:grow].each_with_index do |grow, i| %>
                <% grow_input_id = "report_teacher_feedback_grow_#{i}_text" %>
                <% grow_standard_id = "#{grow_input_id}_standard" %>
                <div>
                  <%= label_tag grow_input_id, "성장 제안 #{i + 1}", class: "sr-only" %>
                  <%= text_area_tag "report[teacher_feedback][grow][#{i}][text]", grow[:text],
                        id: grow_input_id, rows: 3, class: "form-textarea",
                        aria: { describedby: grow_standard_id } %>
                  <%= hidden_field_tag "report[teacher_feedback][grow][#{i}][standard_code]", grow[:standard_code] %>
                  <p id="<%= grow_standard_id %>" class="form-hint">성취기준: <%= grow[:standard_code].presence || "-" %></p>
                </div>
              <% end %>
            </fieldset>
          <% end %>
        </div>

        <%= f.submit "저장", class: "btn btn-primary" %>
      <% end %>
      <% elsif @report.failed? %>
        <div class="state-banner state-banner--error">
          <%= ui_icon :warning %>
          <span>AI 첨삭에 실패했어요. 첨삭이 만들어진 뒤에 검토하고 승인할 수 있어요.</span>
        </div>
      <% else %>
        <div class="state-banner">
          <%= ui_icon :writing %>
          <span>AI 첨삭을 준비하고 있어요. 첨삭이 끝나면 이 화면에서 검토하고 승인할 수 있어요.</span>
        </div>
      <% end %>

      <%# 승인은 reviewed_at 을 덮어쓰고 뱃지·진화·미션·챌린지·몬스터 해금 캐스케이드를 통째로
          재실행하므로, 검토완료 글에는 노출하지 않는다(목록 검토완료 탭에서 이 화면에 도달 가능).
          저장은 그대로 — 승인 후 정정은 의도된 기능이고 update 가 학생 화면에 라이브 반영한다. %>
      <% if @report.reviewed? %>
        <div class="state-banner state-banner--success">
          이미 승인한 독후감이에요<% if @report.reviewed_at %> (<%= @report.reviewed_at.strftime("%Y.%m.%d") %> 승인)<% end %>.
          내용을 고쳐 저장하면 학생 화면에 바로 반영돼요.
        </div>
      <% end %>

      <div class="flex flex-wrap items-center gap-3">
        <% if @report.review_ready? && !@report.reviewed? %>
          <%= button_to "승인", approve_teacher_review_path(@report), method: :post, class: "btn btn-blue",
                params: { review_version: @report.review_version } %>
        <% end %>
        <% if policy(@report).retry_review? %>
          <%= button_to "AI 첨삭 다시 요청", retry_review_report_path(@report), method: :post, class: "btn btn-blue" %>
        <% end %>
        <%= link_to "목록으로 돌아가기", teacher_reviews_path, class: "btn btn-secondary" %>
      </div>
    </section>
  </div>
</div>
