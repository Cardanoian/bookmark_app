<% content_for :title, "검토 큐 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :reviews %>

    <section class="min-w-0 flex-1 space-y-6">
      <%= turbo_stream_from current_user.classroom, :review_queue if current_user.classroom %>

      <header class="page-header">
        <h1 class="page-title">검토 큐</h1>
        <%= link_to "대시보드", root_path, class: "text-sm text-steel" %>
      </header>

      <% if @reports.any? %>
        <div class="space-y-3">
          <div id="review_queue" class="space-y-3">
            <%= render partial: "teacher/reviews/report_row", collection: @reports, as: :report %>
          </div>
          <%= form_with url: batch_approve_teacher_reviews_path, method: :post, id: "batch_approve_reports" do %>
            <button type="submit" class="btn btn-primary">
              선택 일괄 승인
            </button>
          <% end %>
        </div>
      <% else %>
        <div id="review_queue">
          <%= render "shared/empty_state", message: "검토할 독후감이 아직 없습니다.", icon: :document %>
        </div>
      <% end %>
    </section>
  </div>
</div>
