<% content_for :title, "검토 목록 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :reviews %>

    <section class="min-w-0 flex-1 space-y-6">
      <%# AiReviewJob 은 첨삭이 끝난 **미검토** 행만 append 한다. 검토완료 탭이나 2페이지 이후에
          붙으면 목록이 거짓말을 하므로 그때는 구독하지 않는다. %>
      <% if current_user.classroom && @status != "reviewed" && @page == 1 %>
        <%= turbo_stream_from current_user.classroom, :review_queue %>
      <% end %>

      <header class="page-header">
        <h1 class="page-title">검토 목록</h1>
        <%= link_to "대시보드", root_path, class: "text-sm text-steel" %>
      </header>

      <%# 검토 상태 필터 %>
      <nav class="flex flex-wrap gap-1.5" aria-label="검토 상태 필터">
        <% [ [ "all", "모두", @total_count ], [ "pending", "미검토", @pending_count ], [ "reviewed", "검토완료", @reviewed_count ] ].each do |value, label, count| %>
          <%= link_to "#{label} #{count}", teacher_reviews_path(status: value),
                aria: { current: (@status == value ? "page" : nil) },
                class: "rounded-full px-3 py-1.5 text-sm font-medium transition #{@status == value ? "bg-primary text-white" : "text-steel hover:bg-surface"}" %>
        <% end %>
      </nav>

      <div class="space-y-3">
        <%# 빈 목록에서도 컨테이너를 유지해야 방송 append 가 착지한다. %>
        <div id="review_queue" class="space-y-3">
          <%= render partial: "teacher/reviews/report_row", collection: @reports, as: :report %>
        </div>

        <% if @reports.none? %>
          <%= render "shared/empty_state", icon: :document,
                message: { "reviewed" => "검토를 마친 독후감이 아직 없어요.",
                           "all" => "아직 독후감이 없어요." }.fetch(@status, "검토할 독후감이 아직 없습니다.") %>
        <% end %>

        <%# 검토완료 탭에는 승인할 대상이 없다. 그 외에는 빈 목록에서도 폼을 렌더해, 방송으로
            붙은 행의 체크박스(form: "batch_approve_reports")가 실제 폼을 가리키게 한다. %>
        <% if @status != "reviewed" %>
          <%= form_with url: batch_approve_teacher_reviews_path, method: :post, id: "batch_approve_reports" do %>
            <button type="submit" class="btn btn-primary">
              선택 일괄 승인
            </button>
          <% end %>
        <% end %>
      </div>

      <% if @has_next_page || @page > 1 %>
        <nav class="mt-6 flex items-center justify-between text-sm">
          <% if @page > 1 %>
            <%= link_to icon_text(:arrow_left, "이전"), teacher_reviews_path(request.query_parameters.merge("page" => @page - 1)), class: "btn btn-secondary btn-sm" %>
          <% else %>
            <span></span>
          <% end %>
          <% if @has_next_page %>
            <%= link_to text_icon("다음", :arrow_right), teacher_reviews_path(request.query_parameters.merge("page" => @page + 1)), class: "btn btn-secondary btn-sm" %>
          <% else %>
            <span></span>
          <% end %>
        </nav>
      <% end %>
    </section>
  </div>
</div>
