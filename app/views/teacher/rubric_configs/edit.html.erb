<% content_for :title, "루브릭 설정 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :rubric %>

    <section class="min-w-0 flex-1 space-y-6">
      <header class="page-header">
        <div>
          <h1 class="page-title">루브릭 가중치</h1>
          <p class="page-subtitle">
            <%= @classroom.label %> · 축별 가중치(0~5)를 조정하면 A/B/C 등급 계산에 반영돼요.
          </p>
        </div>
      </header>

      <%= form_with url: teacher_rubric_config_path(classroom_id: @classroom.id), method: :patch,
            class: "card space-y-4" do %>
        <div class="space-y-3">
          <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
            <label class="flex items-center justify-between gap-3 text-sm">
              <span class="text-slate"><%= axis_label(axis) %></span>
              <%= number_field_tag "rubric_config[weights][#{axis}]", @weights[axis], in: 0..5, class: "form-input w-20" %>
            </label>
          <% end %>
        </div>

        <div>
          <%= label_tag "rubric_config_emphasis", "강조 축(선택)", class: "form-label" %>
          <%= select_tag "rubric_config[emphasis]",
                options_for_select(ReadingDomain::RUBRIC_AXES.map { |a| [ axis_label(a), a ] }, @classroom.rubric_emphasis),
                include_blank: "없음", class: "form-select" %>
        </div>

        <div>
          <%= label_tag "rubric_config_label", "라벨(선택)", class: "form-label" %>
          <%= text_field_tag "rubric_config[label]", @classroom.rubric_config&.dig("label"), class: "form-input" %>
        </div>

        <%= submit_tag "저장", class: "btn btn-primary" %>
      <% end %>
    </section>
  </div>
</div>
