<% content_for :title, "루브릭 설정 · 책갈피" %>

<div class="flex w-full gap-6">
  <%= render "teacher/nav", active: :rubric %>

  <section class="min-w-0 flex-1 space-y-6">
    <h1 class="text-2xl font-bold text-gray-900">루브릭 가중치</h1>
    <p class="text-sm text-gray-500">
      <%= @classroom.label %> · 축별 가중치(0~5)를 조정하면 A/B/C 등급 계산에 반영돼요.
    </p>

    <%= form_with url: teacher_rubric_config_path(classroom_id: @classroom.id), method: :patch,
          class: "space-y-4 rounded-lg border border-gray-200 p-5" do %>
      <div class="space-y-3">
        <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
          <label class="flex items-center justify-between gap-3 text-sm">
            <span class="text-gray-700"><%= axis_label(axis) %></span>
            <%= number_field_tag "rubric_config[weights][#{axis}]", @weights[axis], in: 0..5,
                  class: "w-20 rounded border border-gray-300 p-1.5 text-sm" %>
          </label>
        <% end %>
      </div>

      <div>
        <%= label_tag "rubric_config_emphasis", "강조 축(선택)", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= select_tag "rubric_config[emphasis]",
              options_for_select(ReadingDomain::RUBRIC_AXES.map { |a| [ axis_label(a), a ] }, @classroom.rubric_emphasis),
              include_blank: "없음", class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
      </div>

      <div>
        <%= label_tag "rubric_config_label", "라벨(선택)", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= text_field_tag "rubric_config[label]", @classroom.rubric_config&.dig("label"),
              class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
      </div>

      <%= submit_tag "저장", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </section>
</div>
