<% content_for :title, "퀴즈 편집 · 책갈피" %>

<div class="page-shell page-shell-form space-y-4">
  <%= link_to icon_text(:arrow_left, "퀴즈 관리"), teacher_quizzes_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>
  <h1 class="page-title">퀴즈 편집</h1>

  <%= form_with model: @quiz, url: teacher_quiz_path(@quiz), method: :patch,
        class: "card space-y-5" do |f| %>
    <% if @quiz.errors.any? %>
      <div class="state-banner state-banner--error" role="alert">
        <%= ui_icon :warning %>
        <span><%= @quiz.errors.full_messages.to_sentence %></span>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "퀴즈 제목", class: "form-label" %>
      <%= f.text_field :title, class: "form-input" %>
    </div>

    <div>
      <%= f.label :book_id, "도서(선택)", class: "form-label" %>
      <%= render "books/autocomplete_field", form: f, book_id_field: :book_id,
            title_field: nil, url: autocomplete_books_path, mode: "strict",
            show_cover: false, selected_book: @quiz&.book %>
    </div>

    <fieldset class="space-y-4">
      <legend class="text-sm font-semibold text-slate">문항</legend>
      <%= f.fields_for :quiz_questions do |qf| %>
        <div class="card card-muted">
          <div class="mb-2">
            <%= qf.label :prompt, "질문", class: "form-label" %>
            <%= qf.text_field :prompt, class: "form-input" %>
          </div>
          <%# 정답 입력은 **mcq 계열 문항에만** 그린다. 이 화면은 문항 타입을 가리지 않으므로
              hint_reveal·matching 문항에도 체크박스를 그리면, 보기가 없어 체크가 0개가 되고
              `answer_indexes=` 가 그 문항을 mcq 로 덮어써 저장 자체가 불가능해진다. %>
          <% mcq = qf.object.mcq_single? || qf.object.mcq_multi? %>
          <% if mcq %>
            <p class="mb-1 text-sm text-slate">
              정답을 <strong class="font-semibold text-ink">모두</strong> 골라 주세요. 두 개 이상 고르면 복수 정답 문제가 돼요.
            </p>
            <%# 전부 해제한 상태를 서버가 인지하도록 빈 값을 하나 먼저 보낸다(체크박스 관용구). %>
            <%= hidden_field_tag "#{qf.object_name}[answer_indexes][]", "" %>
            <div class="grid gap-2 sm:grid-cols-2">
              <% qf.object.choice_list.each_with_index do |choice, index| %>
                <label class="flex items-center gap-2 text-sm text-ink">
                  <%= check_box_tag "#{qf.object_name}[answer_indexes][]", index,
                        qf.object.answer_indexes.include?(index),
                        id: "#{qf.object_name}_answer_#{index}",
                        class: "shrink-0 text-brand-blue" %>
                  <span class="w-5 text-muted"><%= index + 1 %></span>
                  <%= text_field_tag "#{qf.object_name}[choices][]", choice, class: "form-input" %>
                </label>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-steel">
              이 문항은 <strong class="font-semibold text-ink"><%= qf.object.question_type %></strong> 유형이라
              여기서 정답을 고칠 수 없어요. 질문·게시 여부만 수정할 수 있어요.
            </p>
          <% end %>
          <div class="mt-2 flex items-center justify-end">
            <label class="flex items-center gap-1 text-sm text-danger">
              <%= qf.check_box :_destroy %> 삭제
            </label>
          </div>
        </div>
      <% end %>
      <% if @quiz.quiz_questions.empty? %>
        <p class="text-sm text-steel">문항이 없어요. 도서를 지정해 다시 만들어 보세요.</p>
      <% end %>
    </fieldset>

    <label class="flex items-center gap-2 text-sm font-medium text-slate">
      <%= f.check_box :published %> 학생에게 게시(published)
    </label>

    <div class="page-actions">
      <%= f.submit "저장", class: "btn btn-primary" %>
      <%= link_to "목록", teacher_quizzes_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
