<% content_for :title, "퀴즈 편집 · 책갈피" %>

<div class="mx-auto w-full max-w-2xl space-y-4">
  <h1 class="text-2xl font-bold text-gray-900">퀴즈 편집</h1>

  <%= form_with model: @quiz, url: teacher_quiz_path(@quiz), method: :patch,
        class: "space-y-5 rounded-lg border border-gray-200 p-5" do |f| %>
    <% if @quiz.errors.any? %>
      <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
        <%= @quiz.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= f.label :title, "퀴즈 제목", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.text_field :title, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>

    <fieldset class="space-y-4">
      <legend class="text-sm font-semibold text-gray-700">문항</legend>
      <%= f.fields_for :quiz_questions do |qf| %>
        <div class="rounded-lg border border-gray-200 p-4">
          <div class="mb-2">
            <%= qf.label :prompt, "질문", class: "mb-1 block text-xs text-gray-500" %>
            <%= qf.text_field :prompt, class: "w-full rounded border border-gray-300 p-2 text-sm" %>
          </div>
          <div class="grid gap-2 sm:grid-cols-2">
            <% qf.object.choice_list.each_with_index do |choice, index| %>
              <label class="flex items-center gap-2 text-sm">
                <span class="w-5 text-gray-400"><%= index + 1 %></span>
                <%= text_field_tag "#{qf.object_name}[choices][]", choice,
                      class: "w-full rounded border border-gray-300 p-1.5 text-sm" %>
              </label>
            <% end %>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <label class="text-sm text-gray-600">
              정답 보기 번호(0부터):
              <%= qf.number_field :answer_index, in: 0..3,
                    class: "ml-1 w-16 rounded border border-gray-300 p-1 text-sm" %>
            </label>
            <label class="flex items-center gap-1 text-sm text-rose-600">
              <%= qf.check_box :_destroy %> 삭제
            </label>
          </div>
        </div>
      <% end %>
      <% if @quiz.quiz_questions.empty? %>
        <p class="text-sm text-gray-500">문항이 없어요. 도서를 지정해 다시 만들어 보세요.</p>
      <% end %>
    </fieldset>

    <label class="flex items-center gap-2 text-sm font-medium text-gray-700">
      <%= f.check_box :published %> 학생에게 게시(published)
    </label>

    <div class="flex items-center gap-3">
      <%= f.submit "저장", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
      <%= link_to "목록", teacher_quizzes_path, class: "text-sm text-gray-500" %>
    </div>
  <% end %>
</div>
