<% content_for :title, "#{@quiz.title} · 책갈피" %>

<div class="page-shell page-shell-content space-y-4">
  <%= link_to icon_text(:arrow_left, "퀴즈 관리"), teacher_quizzes_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>

  <header class="page-header">
    <h1 class="page-title"><%= @quiz.title %></h1>
    <span class="badge <%= @quiz.published? ? "badge-success" : "badge-neutral" %>">
      <%= @quiz.published? ? "게시됨" : "미게시" %>
    </span>
  </header>

  <ol class="space-y-3">
    <% @quiz.quiz_questions.each do |question| %>
      <li class="card">
        <p class="font-medium text-ink"><%= question.prompt %></p>
        <ul class="mt-2 space-y-1 text-sm">
          <% question.choice_list.each_with_index do |choice, index| %>
            <li class="<%= index == question.answer_index ? "font-semibold text-success-accent" : "text-slate" %>">
              <%= index + 1 %>. <%= choice %>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ol>

  <div class="page-actions">
    <%= link_to "편집", edit_teacher_quiz_path(@quiz), class: "btn btn-secondary btn-sm" %>
    <%= link_to "목록", teacher_quizzes_path, class: "text-sm text-steel" %>
  </div>
</div>
