<% content_for :title, "학생 관리 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :students %>

    <section class="min-w-0 flex-1 space-y-6">
      <h1 class="page-title">학생 관리</h1>

      <%= form_with url: teacher_students_path, method: :post, class: "card flex flex-wrap items-end gap-3" do %>
        <div>
          <%= label_tag "student_name", "이름", class: "form-label" %>
          <%= text_field_tag "student[name]", nil, id: "student_name", required: true, class: "form-input" %>
        </div>
        <div>
          <%= label_tag "student_password", "비밀번호 (6자 이상)", class: "form-label" %>
          <%= password_field_tag "student[password]", nil, id: "student_password", required: true,
                minlength: 6, autocomplete: "new-password", class: "form-input" %>
        </div>
        <% if @classrooms.size > 1 %>
          <div>
            <%= label_tag "student_classroom_id", "학급", class: "form-label" %>
            <%= select_tag "student[classroom_id]",
                  options_for_select(@classrooms.map { |c| [ c.label, c.id ] }),
                  id: "student_classroom_id", class: "form-select" %>
          </div>
        <% end %>
        <div class="w-full space-y-2 border-t border-hairline-soft pt-3">
          <label class="flex items-start gap-2 text-sm text-ink">
            <%= check_box_tag "student[privacy_consent]", "1", false, required: true, class: "mt-0.5" %>
            <span>보호자 <strong>개인정보 수집·이용 동의서</strong>를 받았어요 <span class="text-coral-dark">(필수)</span></span>
          </label>
          <label class="flex items-start gap-2 text-sm text-ink">
            <%= check_box_tag "student[ai_consent]", "1", false, class: "mt-0.5" %>
            <span>보호자 <strong>AI 활용 동의</strong>도 받았어요 (선택 — 미동의 시 AI 첨삭 없이 규칙기반으로 도와줘요)</span>
          </label>
          <%= link_to "동의서 양식 내려받기 (PDF)", "/agree.pdf", target: "_blank", rel: "noopener",
                class: "inline-block text-sm font-medium text-brand-blue hover:underline" %>
        </div>
        <%= submit_tag "학생 추가", class: "btn btn-primary" %>
      <% end %>

      <div class="card">
        <% if @students.any? %>
          <ul class="divide-y divide-hairline-soft">
            <% @students.each do |student| %>
              <li class="flex flex-wrap items-center justify-between gap-3 py-3 first:pt-0 last:pb-0">
                <span class="min-w-0">
                  <span class="block font-medium text-ink">
                    <%= student.name %>
                    <% if student.ai_consent? %>
                      <span class="ml-1 text-xs font-semibold text-success-accent">AI 동의</span>
                    <% else %>
                      <span class="ml-1 text-xs text-steel">AI 미동의</span>
                    <% end %>
                  </span>
                  <span class="block text-xs text-steel">
                    <%= student.classroom&.label %> · <%= student.points %>P · <%= student.experience %>XP · Lv.<%= student.trainer_level %>
                  </span>
                </span>
                <div class="flex flex-wrap items-center gap-2">
                  <%= button_to "+10P · +10XP", give_points_teacher_student_path(student), method: :post,
                        params: { points: 10 }, class: "btn btn-blue btn-sm" %>
                  <%= form_with url: reset_password_teacher_student_path(student), method: :post,
                        class: "flex items-center gap-2" do %>
                    <%= label_tag "student_password_#{student.id}", "#{student.name} 학생의 새 비밀번호",
                          class: "sr-only" %>
                    <%= password_field_tag "student[password]", nil, id: "student_password_#{student.id}",
                          required: true, minlength: 6, autocomplete: "new-password",
                          placeholder: "새 비밀번호 (6자 이상)", class: "form-input w-48" %>
                    <%= button_tag "비번 초기화", type: :submit, class: "btn btn-yellow btn-sm" %>
                  <% end %>
                  <% if student.ai_consent? %>
                    <%= button_to "AI 철회", set_ai_consent_teacher_student_path(student), method: :post,
                          params: { consent: "0" }, class: "btn btn-secondary btn-sm" %>
                  <% else %>
                    <%= button_to "AI 동의", set_ai_consent_teacher_student_path(student), method: :post,
                          params: { consent: "1" }, class: "btn btn-blue btn-sm" %>
                  <% end %>
                  <%= button_to "삭제", teacher_student_path(student), method: :delete,
                        form: { data: { turbo_confirm: "#{student.name} 학생을 삭제할까요?" } },
                        class: "btn btn-danger btn-sm" %>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="text-sm text-steel">등록된 학생이 없어요. 위에서 추가해 보세요.</p>
        <% end %>
      </div>
    </section>
  </div>
</div>
