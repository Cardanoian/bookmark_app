<% content_for :title, "독서 포트폴리오 · 책갈피" %>

<article class="space-y-6"
         data-controller="growth-card save-image"
         data-save-image-filename-value="<%= "성장카드_#{@student.name}.png" %>"
         data-growth-card-name-value="<%= @student.name %>"
         data-growth-card-avg-value="<%= @axis_averages.values.sum.fdiv([ @axis_averages.size, 1 ].max).round(1) %>"
         data-growth-card-level-value="<%= @reports.last&.level %>"
         data-growth-card-reports-value="<%= @reports.size %>">
  <header class="border-b border-hairline pb-4">
    <p class="text-sm text-brand-blue">책갈피 독서 포트폴리오</p>
    <h1 class="mt-1 text-2xl font-bold text-ink"><%= @student.name %></h1>
    <p class="mt-1 text-sm text-steel"><%= @classroom.label %> · 독후감 <%= @reports.size %>편</p>
  </header>

  <section class="grid gap-6 md:grid-cols-2">
    <div class="rounded-lg border border-hairline p-5">
      <h2 class="mb-3 text-sm font-semibold text-ink">5축 방사형</h2>
      <div class="flex justify-center">
        <%= radar_chart_svg(@axis_averages, labels: @axis_labels) %>
      </div>
    </div>

    <div class="space-y-3">
      <div class="rounded-lg border border-hairline p-4">
        <h2 class="mb-2 text-sm font-semibold text-ink">획득 뱃지</h2>
        <% if @badges.any? %>
          <div class="flex flex-wrap gap-2">
            <% @badges.each do |badge| %>
              <span class="badge badge-yellow">
                <%= badge.icon %> <%= badge.name %>
              </span>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-steel">아직 획득한 뱃지가 없어요.</p>
        <% end %>
      </div>

      <div class="no-print rounded-lg border border-hairline p-4">
        <h2 class="mb-2 text-sm font-semibold text-ink">성장카드</h2>
        <canvas data-growth-card-target="canvas" data-save-image-target="canvas"
                width="320" height="220"
                class="w-full rounded border border-hairline"></canvas>
        <%# 두 액션을 함께 건다. 웹에서는 save-image 컨트롤러가 로드되지 않아 growth-card#download 만
            돌고, 앱에서는 growth-card#download 가 스스로 물러나 브리지 저장만 남는다. %>
        <button type="button" data-action="growth-card#download save-image#save"
                class="btn btn-primary btn-sm mt-2">PNG 저장</button>
      </div>
    </div>
  </section>

  <section>
    <h2 class="mb-2 text-sm font-semibold text-ink">독후감 목록</h2>
    <ul class="divide-y divide-hairline-soft rounded-lg border border-hairline">
      <% @reports.each do |report| %>
        <li class="flex items-center justify-between p-3 text-sm">
          <span class="text-ink"><%= report.book&.title.presence || report.book_title %></span>
          <span class="text-steel">평균 <%= report.avg %> · <%= report.level %></span>
        </li>
      <% end %>
    </ul>
  </section>
</article>
