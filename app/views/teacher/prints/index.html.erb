<% content_for :title, "문서 출력 · 책갈피" %>
<%# 인쇄 문서 4종의 유일한 진입 화면. 이 화면이 생기기 전까지 award·home_letter·portfolio·
    class_report 은 웹·앱 어디에도 링크가 없어 URL 을 직접 치는 사람만 닿을 수 있었다.
    문서는 새 탭(웹)에서 열어 인쇄하는 흐름이라 target 을 지정하되, Android 앱은 target="_blank"
    를 무시하므로 **앱에서는 같은 스택 안에서 열리도록** target 을 붙이지 않는다(_ocr_photo 선례 —
    앱에서 새 탭 링크는 아무 일도 하지 않는다). %>
<% open_in_new_tab = !hotwire_native_app? %>
<% doc_link = ->(path, label, description, icon) do
     link_to path,
             target: (open_in_new_tab ? "_blank" : nil),
             rel: (open_in_new_tab ? "noopener" : nil),
             class: "flex items-start gap-3 rounded-xl border border-hairline-soft p-3 hover:bg-surface" do
       safe_join([
         ui_icon(icon, class_name: "mt-0.5 h-5 w-5"),
         tag.span(class: "min-w-0") do
           safe_join([
             tag.span(label, class: "block text-sm font-semibold text-ink"),
             tag.span(description, class: "block text-sm text-steel")
           ])
         end
       ])
     end
   end %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :prints %>

    <section class="min-w-0 flex-1 space-y-6">
      <header class="page-header">
        <div>
          <h1 class="page-title">문서 출력</h1>
          <p class="mt-1 text-sm text-slate">
            표창장·가정통신문·독서 포트폴리오·학급 성장 리포트를 인쇄용으로 열 수 있고,
            <strong>5축 원자료 엑셀 파일</strong> 도 여기에서 내려받아요.
            문서를 연 뒤 위쪽 <strong>인쇄하기</strong> 버튼을 누르면 인쇄하거나 PDF 로 저장할 수 있어요.
          </p>
        </div>
      </header>

      <% if @classrooms.size > 1 %>
        <%= form_with url: teacher_prints_path, method: :get, class: "card flex flex-wrap items-end gap-3" do %>
          <div>
            <%= label_tag :classroom_id, "학급", class: "form-label" %>
            <%= select_tag :classroom_id,
                  options_for_select(@classrooms.map { |c| [ c.label_with_year, c.id ] }, @classroom&.id),
                  class: "form-select" %>
          </div>
          <%= submit_tag "보기", class: "btn btn-secondary" %>
        <% end %>
      <% end %>

      <%# 원자료 엑셀 — **학급 분기 밖**에 둔다. 이 파일은 담당 학급이 없으면 아래 empty_state 로
          낙하하는데, exports#reports_xlsx 는 담임 학급 **전체**를 내보내는 학급-무관 산출물이라
          학급 유무와 무관하게 닿을 수 있어야 한다(안쪽에 두면 학급 없는 교사가 내려받기 경로를
          통째로 잃는다 — 교사 네비에 별도 항목이 없어진 뒤로 이 화면이 유일한 진입점이다).

          링크는 `doc_link` 를 쓰지 않고 평범한 link_to 로 둔다. doc_link 는 웹에서 target="_blank"
          를 붙이는데 이 파일은 새 탭에서 "여는" 문서가 아니라 내려받는 파일이다. 그리고 이 마크업
          (target 없음·data-turbo 없음)이 앱에서 이미 검증된 형태다 — Android 셸은 링크 마크업이
          아니라 원격 Path Configuration 의 URL 패턴(^/teacher/exports/reports_xlsx$)으로 다운로드를
          판정하므로, Turbo 방문이 제안되어야 그 핸들러가 잡는다. data-turbo="false" 를 붙이면
          그 훅이 사라져 파일명·MIME 설정을 잃는다(2026-09-03 에뮬레이터 실측). %>
      <section id="raw-export" class="card space-y-3">
        <h2 class="flex items-center gap-1.5 font-semibold text-ink">
          <%= ui_icon :download, class_name: "h-5 w-5" %> 5축 원자료 엑셀 (가명 처리)
        </h2>
        <p class="text-sm text-steel">
          학생별로 <strong class="font-semibold text-ink">처음 쓴 글</strong>과
          <strong class="font-semibold text-ink">고쳐 쓴 글</strong>의 5축 점수·등급·향상도를 표로 내려받아요.
          이름·학교·학년·반·번호는 빼고, 같은 학생의 기록을 잇는 <strong class="font-semibold text-ink">학생 가명 ID</strong>만 넣어요.
        </p>

        <div class="state-banner state-banner--warning" role="note">
          <%= ui_icon :warning, class_name: "h-5 w-5" %>
          <span>
            <strong>개인정보 보호:</strong> 가명 처리된 파일도 다른 자료와 합치면 학생을 알아볼 수 있어요.
            학교가 승인한 내부 환경에서만 사용하고, ChatGPT·Claude·Gemini 같은
            <strong>외부 AI 서비스에 업로드하지 마세요.</strong>
          </span>
        </div>

        <%# 스프라이트 아이콘은 잉크색이 박혀 있어 어두운 버튼 위에서 그냥 두면 보이지 않는다. %>
        <div>
          <%= link_to icon_text(:download, "엑셀 내려받기", icon_class: "h-4 w-4 icon-inverse"),
                teacher_exports_reports_xlsx_path, class: "btn btn-primary" %>
        </div>
      </section>

      <% if @classroom.nil? %>
        <%= render "shared/empty_state",
              message: "담당 학급이 아직 없어요. 학급이 만들어지면 문서를 출력할 수 있어요.", icon: :school %>
      <% else %>
        <section class="card space-y-3">
          <h2 class="flex items-center gap-1.5 font-semibold text-ink">
            <%= ui_icon :students, class_name: "h-5 w-5" %> 학급 문서
          </h2>
          <p class="text-sm text-steel"><%= @classroom.label %> 전체를 한 장으로 정리한 문서예요.</p>
          <%= doc_link.call(class_report_teacher_prints_path(classroom_id: @classroom.id),
                            "학급 성장 리포트",
                            "학급 전체의 5축 평균과 학생별 기록을 한눈에 정리해요.",
                            :chart) %>
        </section>

        <section class="card space-y-3">
          <h2 class="flex items-center gap-1.5 font-semibold text-ink">
            <%= ui_icon :student, class_name: "h-5 w-5" %> 학생별 문서
          </h2>
          <% if @students.empty? %>
            <%= render "shared/empty_state",
                  message: "#{@classroom.label} 학생이 아직 없어요. 학생 관리에서 추가해 주세요.", icon: :students %>
          <% else %>
            <p class="text-sm text-steel">학생을 고르면 그 학생의 문서 3종을 열 수 있어요.</p>
            <ul class="divide-y divide-hairline-soft">
              <% @students.each do |student| %>
                <li class="py-3">
                  <p class="mb-2 font-semibold text-ink"><%= student.name %></p>
                  <div class="grid gap-2 sm:grid-cols-3">
                    <%= doc_link.call(award_teacher_prints_path(classroom_id: @classroom.id, student_id: student.id),
                                      "표창장", "가장 최근 확인받은 독후감으로 만들어요.", :medal) %>
                    <%= doc_link.call(home_letter_teacher_prints_path(classroom_id: @classroom.id, student_id: student.id),
                                      "가정통신문", "가정에 보내는 독서 활동 안내예요.", :inbox) %>
                    <%= doc_link.call(portfolio_teacher_prints_path(classroom_id: @classroom.id, student_id: student.id),
                                      "독서 포트폴리오", "5축 방사형 그래프와 뱃지를 담아요.", :book_open) %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </section>
      <% end %>
    </section>
  </div>
</div>
