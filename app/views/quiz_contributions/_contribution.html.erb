<%# 내가 낸 문제 카드 1장. 내가 낸 문제 목록과 이 책의 내 기록(library_books/show)이 함께 쓴다.
    show_book 은 책 제목 표시 여부 — 책 한 권 화면에서는 끈다. %>
<%# locals: (contribution:, show_book: true) %>
<% payload = contribution.payload_hash %>
<% axis_icon, axis_label = contribution_axis_meta(contribution) %>
<% status_label, status_badge = contribution_status_meta(contribution.status) %>
<li class="card space-y-3">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <span class="flex flex-wrap items-center gap-2">
      <span class="badge badge-neutral"><%= ui_icon axis_icon, class_name: "h-4 w-4" %> <%= axis_label %></span>
      <% if show_book %>
        <span class="font-semibold text-ink">「<%= contribution.book.title %>」</span>
      <% end %>
    </span>
    <span class="badge <%= status_badge %>"><%= status_label %></span>
  </div>

  <% if contribution.mcq? %>
    <p class="font-medium text-ink"><%= payload[:prompt] %></p>
    <ol class="space-y-1 text-sm text-slate">
      <% Array(payload[:choices]).each_with_index do |choice, i| %>
        <li class="flex items-start gap-2">
          <span class="w-5 shrink-0 text-muted"><%= i + 1 %></span>
          <span class="<%= "font-semibold text-ink" if payload[:answer_index].to_i == i %>">
            <%= choice %><%= " (정답)" if payload[:answer_index].to_i == i %>
          </span>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="font-medium text-ink">정답 · <%= payload[:answer] %></p>
    <ol class="space-y-1 text-sm text-slate">
      <% Array(payload[:hints]).each_with_index do |hint, i| %>
        <li class="flex items-start gap-2">
          <span class="w-12 shrink-0 text-muted">힌트 <%= i + 1 %></span>
          <span><%= hint %></span>
        </li>
      <% end %>
    </ol>
  <% end %>

  <% if payload[:explanation].present? %>
    <p class="text-sm text-steel">해설 · <%= payload[:explanation] %></p>
  <% end %>

  <div class="flex flex-wrap items-center justify-between gap-2 border-t border-hairline pt-3">
    <p class="text-sm text-steel">
      <% case contribution.status %>
      <% when "approved" %>
        전국 친구들이 이 문제를 풀고 있어요. 고마워요!
      <% when "rejected" %>
        이 문제는 문제은행에 들어가지 않았어요. 다른 문제로 다시 도전해 보세요.
      <% else %>
        선생님이 확인하고 있어요. 조금만 기다려 주세요.
      <% end %>
    </p>
    <span class="text-xs text-steel"><%= contribution.created_at.strftime("%Y-%m-%d") %></span>
  </div>
</li>
