<% content_for :title, "도서관 대시보드 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <header class="page-header">
    <div>
      <p class="text-sm font-medium text-moss-dark">도서관 담당</p>
      <h1 class="page-title"><%= current_user.name %></h1>
      <% if current_user.school %>
        <p class="page-subtitle"><%= current_user.school.name %></p>
      <% end %>
    </div>
    <%= button_to "로그아웃", session_path, method: :delete, class: "btn btn-secondary btn-sm" %>
  </header>

  <nav class="mb-8 flex gap-4 text-sm font-medium text-steel">
    <span class="text-ink">도서관</span>
    <span>인기 대출</span>
  </nav>

  <%= render "shared/empty_state",
        message: "이달의 책과 행사를 등록해 보세요.", icon: "📖" %>
</div>
