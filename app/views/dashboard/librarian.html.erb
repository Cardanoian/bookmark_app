<% content_for :title, "도서관 대시보드 · 책갈피" %>

<div class="w-full max-w-3xl mx-auto">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-emerald-600">도서관 담당</p>
      <h1 class="text-2xl font-bold text-gray-900"><%= current_user.name %></h1>
      <% if current_user.school %>
        <p class="mt-1 text-sm text-gray-500"><%= current_user.school.name %></p>
      <% end %>
    </div>
    <%= button_to "로그아웃", session_path, method: :delete,
          class: "rounded-lg bg-gray-800 px-4 py-2 text-sm text-white" %>
  </header>

  <nav class="mb-8 flex gap-4 text-sm font-medium text-gray-500">
    <span class="text-gray-900">도서관</span>
    <span>인기 대출</span>
  </nav>

  <%= render "shared/empty_state",
        message: "이달의 책과 행사를 등록해 보세요.", icon: "📖" %>
</div>
