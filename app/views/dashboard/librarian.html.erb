<% content_for :title, "도서관 대시보드 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <header class="page-header">
    <div>
      <p class="text-sm font-medium text-moss-dark">도서관 담당</p>
      <h1 class="page-title"><%= current_user.name %></h1>
      <% if current_user.school %>
        <p class="page-subtitle"><%= current_user.school.name %></p>
      <% end %>
    </div>
  </header>

  <%# 사서 전용 화면(Librarian::*, 역할 게이트 require_librarian!)과 챌린지로 가는 진입 카드.
      예전에는 "도서관 / 인기 대출"이 링크 없는 글자라 이 홈에서 사서 도구로 갈 길이 없었다. %>
  <% entries = [
       [ "도서관 현황", "전교 독후감·참여 학생 수와 인기 도서, 행사를 한눈에 봐요.", :chart, librarian_dashboard_path ],
       [ "인기 대출", "정보나루 동기화나 CSV 로 우리 학교 인기 대출 도서를 올려요.", :books, librarian_loans_path ],
       [ "이달의 책·행사", "이달의 책과 도서관 행사를 등록하고 고쳐요.", :megaphone, librarian_events_path ],
       [ "챌린지 관리", "우리 학교 챌린지를 만들고 관리해요.", :flame, challenges_path ]
     ] %>
  <nav aria-label="사서 메뉴" class="grid gap-4 md:grid-cols-2">
    <% entries.each do |label, description, icon, path| %>
      <%= link_to path, class: "card flex items-center justify-between gap-3 hover:border-primary/40" do %>
        <span class="flex min-w-0 items-center gap-3">
          <%= ui_icon icon, class_name: "h-7 w-7" %>
          <span class="min-w-0">
            <span class="block font-semibold text-ink"><%= label %></span>
            <span class="block text-sm text-steel"><%= description %></span>
          </span>
        </span>
        <%= ui_icon :arrow_right, class_name: "h-5 w-5 text-steel" %>
      <% end %>
    <% end %>
  </nav>
</div>
