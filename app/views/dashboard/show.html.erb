<div class="w-full max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-4">책갈피</h1>

  <% if current_user %>
    <div class="rounded-lg border border-gray-200 p-6">
      <p class="text-lg">
        <span class="font-semibold"><%= current_user.name %></span>님, 환영합니다.
      </p>
      <p class="mt-2 text-gray-600">역할: <%= current_user.role %></p>
      <% if current_user.school %>
        <p class="text-gray-600">학교: <%= current_user.school.name %></p>
      <% end %>
      <% if current_user.classroom %>
        <p class="text-gray-600">학급: <%= current_user.classroom.label %></p>
      <% end %>

      <%= button_to "로그아웃", session_path, method: :delete,
            class: "mt-4 rounded bg-gray-800 px-4 py-2 text-white" %>
    </div>
  <% end %>
</div>
