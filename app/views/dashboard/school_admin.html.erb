<% content_for :title, "교무 대시보드 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <header class="page-header">
    <div>
      <p class="page-subtitle font-medium text-moss-dark">교무관리자</p>
      <h1 class="page-title"><%= current_user.name %></h1>
      <% if current_user.school %>
        <p class="mt-1 text-sm text-steel"><%= current_user.school.name %></p>
      <% end %>
    </div>
    <%= button_to "로그아웃", session_path, method: :delete, class: "btn btn-secondary btn-sm" %>
  </header>

  <nav class="mb-8 flex gap-4 text-sm font-medium text-steel">
    <span class="text-ink">전교 통계</span>
    <span>계정 관리</span>
  </nav>

  <%= render "shared/empty_state",
        message: "표시할 전교 통계가 아직 없습니다.", icon: "📊" %>
</div>
