<% content_for :title, "내 서재 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <%= turbo_stream_from current_user, :active_monster %>

  <header class="page-header">
    <div>
      <p class="text-sm font-medium text-steel">학생</p>
      <h1 class="page-title"><%= current_user.name %>님의 서재</h1>
      <p class="page-subtitle">
        <%= current_user.trainer_title %> · <%= current_user.points %>P
      </p>
    </div>
    <div class="page-actions">
      <%= button_to "로그아웃", session_path, method: :delete, class: "btn btn-secondary btn-sm" %>
    </div>
  </header>

  <%= render "shared/student_nav", active: :library %>

  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-6">
    <div class="lg:col-span-2">
      <% if current_user.active_monster.nil? %>
        <section class="card-feature">
          <h2 class="text-lg font-bold text-ink">
            <span aria-hidden="true">🥚</span> 첫 반려 몬스터를 골라 볼까요?
          </h2>
          <p class="mt-1 text-sm text-steel">함께 책을 읽으며 성장할 스타터를 선택하세요.</p>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <% MonsterSpecies.where(key: MonsterAcquisition::STARTERS).order(:dex_no).each do |starter| %>
              <%= button_to choose_starter_monsters_path, params: { key: starter.key }, class: "card text-center" do %>
                <span class="block"><%= monster_sprite(starter, img_class: "mx-auto h-20 w-20 object-contain") %></span>
                <span class="mt-2 block text-sm font-semibold text-ink"><%= starter.name %></span>
                <span class="badge <%= element_badge_classes(starter.element) %> mt-2">
                  <%= element_label(starter.element) %>
                </span>
              <% end %>
            <% end %>
          </div>
        </section>
      <% else %>
        <%= render "monsters/active_monster", monster: current_user.active_monster, user: current_user %>
      <% end %>
    </div>

    <div class="flex flex-col gap-4">
      <div class="stat-card">
        <span class="stat-card__label">보유 포인트</span>
        <span class="stat-card__value"><%= current_user.points %>P</span>
        <span class="badge badge-yellow self-start">Lv.<%= current_user.trainer_level %> · <%= current_user.trainer_title %></span>
      </div>
      <%= link_to "새 독후감 쓰기", new_report_path, class: "btn btn-primary btn-block" %>
    </div>
  </div>

  <section class="mt-6 lg:mt-8">
    <%= render "shared/empty_state",
          message: "아직 읽은 책이 없어요. 첫 독후감을 써 볼까요?", icon: "📚" %>
  </section>
</div>
