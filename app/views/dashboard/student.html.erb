<% content_for :title, "홈 · 책갈피" %>
<% goal_label = { "approved_reports" => "승인 독후감", "game_plays" => "독서 게임" } %>

<div class="page-shell page-shell-wide space-y-6">
  <%= turbo_stream_from current_user, :active_monster %>
  <h1 class="sr-only">홈</h1>
  <%= render "shared/student_nav", active: :home %>

  <%# 1) 활성 몬스터·포인트 요약 (navbar 바로 아래) %>
  <section class="grid grid-cols-1 gap-4 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <% if current_user.active_monster.nil? %>
        <div class="card-feature">
          <h2 class="text-base font-bold text-ink"><span aria-hidden="true">🥚</span> 첫 반려 몬스터를 골라 볼까요?</h2>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <% MonsterSpecies.where(key: MonsterAcquisition::STARTERS).order(:dex_no).each do |starter| %>
              <%= button_to choose_starter_monsters_path, params: { key: starter.key }, class: "card text-center" do %>
                <span class="block"><%= monster_sprite(starter, img_class: "mx-auto h-20 w-20 object-contain") %></span>
                <span class="mt-2 block text-sm font-semibold text-ink"><%= starter.name %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= render "monsters/active_monster", monster: current_user.active_monster, user: current_user %>
      <% end %>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">보유 포인트</span>
      <span class="stat-card__value"><%= current_user.points %>P</span>
      <span class="badge badge-yellow self-start">Lv.<%= current_user.trainer_level %> · <%= current_user.trainer_title %></span>
    </div>
  </section>

  <%# 2) 총괄관리자 업로드 기반 공식 추천도서 %>
  <% recommended = @home.recommended_books.to_a %>
  <% if recommended.any? %>
    <section class="space-y-3">
      <h2 class="text-lg font-bold text-ink">📖 추천도서</h2>
      <%= render "dashboard/home_book_grid", books: recommended %>
    </section>
  <% end %>

  <%# 3) 환영 및 이어하기 %>
  <section class="card-feature">
    <h2 class="text-lg font-bold text-ink"><%= current_user.name %>님, 오늘도 책 한 권 어때요?</h2>
    <% if (report = @home.continue_report) %>
      <p class="mt-1 text-sm text-steel">
        최근 활동: <span class="font-medium text-ink"><%= report.book&.title || report.book_title %></span>
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        <%= link_to "이어서 보기", report_path(report), class: "btn btn-primary btn-sm" %>
        <%= link_to "독서활동 시작", reading_activity_path, class: "btn btn-secondary btn-sm" %>
      </div>
    <% else %>
      <p class="mt-1 text-sm text-steel">첫 독서활동을 시작해 볼까요?</p>
      <%= link_to "독서활동 시작하기", reading_activity_path, class: "btn btn-primary btn-sm mt-3" %>
    <% end %>
  </section>

  <%# 4) 진행 중인 우리 반 미션 %>
  <% missions = @home.active_missions %>
  <% if missions.any? %>
    <section class="space-y-3">
      <h2 class="text-lg font-bold text-ink">🎯 진행 중인 우리 반 미션</h2>
      <% missions.each do |item| %>
        <% mission = item[:mission] %>
        <div class="card space-y-2">
          <div class="flex items-center justify-between gap-2">
            <span class="font-semibold text-ink"><%= mission.title %></span>
            <span class="text-xs text-steel"><%= mission.end_date %>까지 · <%= mission.reward_points %>P</span>
          </div>
          <% item[:progress][:goals].each do |g| %>
            <div>
              <div class="flex justify-between text-xs">
                <span class="text-steel"><%= goal_label[g[:type]] %></span>
                <span class="<%= g[:met] ? "font-semibold text-green-700" : "text-ink" %>"><%= g[:current] %>/<%= g[:target] %><%= g[:met] ? " ✓" : "" %></span>
              </div>
              <div class="progress-bar mt-1"><span style="width: <%= g[:target].positive? ? [ 100 * g[:current] / g[:target], 100 ].min : 0 %>%"></span></div>
            </div>
          <% end %>
          <% if item[:participation].rewarded_at? %>
            <p class="text-sm font-semibold text-green-700">🎉 완료! <%= item[:participation].reward_points_awarded %>P 받았어요</p>
          <% end %>
        </div>
      <% end %>
    </section>
  <% end %>

  <%# 5) 우리 반 인기 도서 %>
  <% popular = @home.popular_books.to_a %>
  <% if popular.any? %>
    <section class="space-y-3">
      <h2 class="text-lg font-bold text-ink">🔥 우리 반 인기 도서</h2>
      <%= render "dashboard/home_book_grid", books: popular %>
    </section>
  <% end %>

  <%# 6) 기존 인기·추천·고전 혼합 카탈로그의 책 발견 %>
  <% discovery = @home.discovery_books.to_a %>
  <% if discovery.any? %>
    <section id="book-discovery" class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-ink">✨ 이 책은 어때요?</h2>
        <%= link_to "↻ 다른 책 보기",
              root_path(discovery: @home.next_discovery_cycle, anchor: "book-discovery"),
              class: "btn btn-secondary btn-sm", data: { turbo_action: "replace" } %>
      </div>
      <%= render "dashboard/home_book_grid", books: discovery %>
    </section>
  <% end %>
</div>
