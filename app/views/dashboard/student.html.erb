<% content_for :title, "홈 · 책갈피" %>
<% goal_label = { "approved_reports" => "승인 독후감", "game_plays" => "독서 게임" } %>
<div class="page-shell page-shell-wide space-y-6">
  <%= turbo_stream_from current_user, :active_monster %>
  <h1 class="sr-only">홈</h1>
  <%= render "shared/student_nav", active: :home %>
  <%# 1) 활성 몬스터·포인트 요약 (navbar 바로 아래) %>
  <section id="student-overview" class="grid grid-cols-1 items-stretch gap-4 lg:grid-cols-2">
    <div class="h-full [&>*]:h-full">
      <% if current_user.active_monster.nil? %>
        <div class="card-feature h-full">
          <h2 class="text-base font-bold text-ink"><span aria-hidden="true">🥚</span> 첫 반려 몬스터를 골라 볼까요?</h2>
          <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
            <% MonsterSpecies.where(key: MonsterAcquisition::STARTERS).order(:dex_no).each do |starter| %>
              <%= button_to choose_starter_monsters_path, params: { key: starter.key }, class: "card text-center" do %>
                <span class="block"><%= monster_sprite(starter, img_class: "mx-auto h-20 w-20 object-contain") %></span>
                <span class="mt-2 block text-sm font-semibold text-ink"><%= starter.name %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <%= render "monsters/active_monster", monster: current_user.active_monster, user: current_user %>
      <% end %>
    </div>
    <div id="student-growth-summary" class="stat-card h-full">
      <div class="flex w-full items-start gap-4">
        <div class="flex min-w-0 flex-1 flex-col gap-2" data-growth-stat="experience">
          <span class="text-xs font-medium text-steel">경험치</span>
          <span class="stat-card__value"><%= current_user.experience %>XP</span>
          <span class="badge badge-yellow self-start">Lv.<%= current_user.trainer_level %> · <%= current_user.trainer_title %></span>
        </div>
        <div class="flex min-w-0 flex-1 flex-col gap-2 border-l border-hairline-soft pl-4" data-growth-stat="points">
          <span class="text-xs font-medium text-steel">보유 포인트</span>
          <span class="stat-card__value"><%= current_user.points %>P</span>
        </div>
      </div>
    </div>
  </section>
  <%# 2) 진행 중인 우리 반 미션 %>
  <% missions = @home.active_missions %>
  <% if missions.any? %>
    <section class="space-y-3">
      <h2 class="text-lg font-bold text-ink">🎯 진행 중인 우리 반 미션</h2>
      <% missions.each do |item| %>
        <% mission = item[:mission] %>
        <%# 카드 전체를 미션 상세로 링크(카드 안엔 인터랙티브 요소 없어 중첩 안전). %>
        <%= link_to mission_path(mission), class: "card block space-y-2 hover:border-primary/40" do %>
          <div class="flex items-center justify-between gap-2">
            <span class="font-semibold text-ink"><%= mission.title %></span>
            <span class="text-xs text-steel"><%= mission.end_date %>까지 · <%= mission.reward_points %>P + <%= mission.reward_points %>XP</span>
          </div>
          <% if mission.description.present? %>
            <p class="text-xs text-steel"><%= mission.description %></p>
          <% end %>
          <% item[:progress][:goals].each do |g| %>
            <div>
              <div class="flex justify-between text-xs">
                <span class="text-steel"><%= goal_label[g[:type]] %></span>
                <span class="<%= g[:met] ? "font-semibold text-green-700" : "text-ink" %>"><%= g[:current] %>/<%= g[:target] %><%= g[:met] ? " ✓" : "" %></span>
              </div>
              <div class="progress-bar mt-1"><span style="width: <%= g[:target].positive? ? [ 100 * g[:current] / g[:target], 100 ].min : 0 %>%"></span></div>
            </div>
          <% end %>
          <% if item[:participation].rewarded_at? %>
            <p class="text-sm font-semibold text-green-700">🎉 완료! <%= item[:participation].reward_points_awarded %>P + <%= item[:participation].reward_points_awarded %>XP 받았어요</p>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
  <%# 3) 챌린지 진입점(전국 + 우리 학교 챌린지). %>
  <section aria-labelledby="challenge-entry-title">
    <%= link_to challenges_path, class: "card flex items-center justify-between gap-3 hover:border-primary/40" do %>
      <span class="flex min-w-0 items-center gap-3">
        <span aria-hidden="true" class="text-2xl">🔥</span>
        <span class="min-w-0">
          <span id="challenge-entry-title" class="block font-semibold text-ink">챌린지</span>
          <span class="block text-xs text-steel">
            <% if @joinable_challenge_count.to_i.positive? %>
              참여할 수 있는 챌린지가 <%= @joinable_challenge_count %>개 있어요.
            <% else %>
              새로운 챌린지를 확인해 보세요.
            <% end %>
          </span>
        </span>
      </span>
      <span aria-hidden="true" class="shrink-0 text-steel">→</span>
    <% end %>
  </section>
  <%# 4) 총괄관리자 업로드 기반 공식 추천도서 %>
  <% recommended = @home.recommended_books.to_a %>
  <% if recommended.any? %>
    <section id="recommended-books" class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-ink">📖 추천도서</h2>
        <% if @home.more_recommended_books? %>
          <%= link_to "↻ 다른 책 보기",
                root_path(recommend: @home.next_recommend_cycle, anchor: "recommended-books"),
                class: "btn btn-secondary btn-sm", data: { turbo_action: "replace" } %>
        <% end %>
      </div>
      <%= render "dashboard/home_book_grid", books: recommended %>
    </section>
  <% end %>
  <%# 5) 우리 반 인기 도서 %>
  <% popular = @home.popular_books.to_a %>
  <% if popular.any? %>
    <section id="popular-books" class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-ink">🔥 우리 반 인기 도서</h2>
        <% if @home.more_popular_books? %>
          <%= link_to "↻ 다른 책 보기",
                root_path(popular: @home.next_popular_cycle, anchor: "popular-books"),
                class: "btn btn-secondary btn-sm", data: { turbo_action: "replace" } %>
        <% end %>
      </div>
      <%= render "dashboard/home_book_grid", books: popular %>
    </section>
  <% end %>
  <%# 5.5) 우리 반·우리 학교 책 이야기(reading_discussion 진입점). 기능 플래그가 꺼지면 숨김. %>
  <% if reading_discussion_enabled? %>
    <% topics = @home.recent_topics %>
    <% if topics.any? %>
      <section class="space-y-3">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-bold text-ink">💬 우리 반 책 이야기</h2>
          <%= link_to "토론방 가기 →", topics_path, class: "text-sm text-brand-blue underline" %>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          <% topics.each do |topic| %>
            <%= link_to topic_path(topic), class: "card flex items-center justify-between gap-2 hover:border-primary/40" do %>
              <span class="min-w-0">
                <span class="block truncate font-semibold text-ink"><%= topic.title %></span>
                <% if topic.book %>
                  <span class="block truncate text-xs text-steel"><span aria-hidden="true">📖</span> <%= topic.book.title %></span>
                <% end %>
              </span>
              <span class="shrink-0 text-xs text-steel"><span aria-hidden="true">💬</span> <%= topic.forum_posts_count %></span>
            <% end %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
  <%# 6) 기존 인기·추천·고전 혼합 카탈로그의 책 발견 %>
  <% discovery = @home.discovery_books.to_a %>
  <% if discovery.any? %>
    <section id="book-discovery" class="space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-bold text-ink">✨ 이 책은 어때요?</h2>
        <%= link_to "↻ 다른 책 보기",
              root_path(discovery: @home.next_discovery_cycle, anchor: "book-discovery"),
              class: "btn btn-secondary btn-sm", data: { turbo_action: "replace" } %>
      </div>
      <%= render "dashboard/home_book_grid", books: discovery %>
    </section>
  <% end %>
</div>
