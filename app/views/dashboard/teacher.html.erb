<% content_for :title, "교사 콘솔 · 책갈피" %>

<div class="flex w-full gap-6">
  <aside class="hidden w-52 shrink-0 md:block">
    <p class="mb-1 text-sm font-medium text-indigo-600">교사</p>
    <p class="mb-4 text-lg font-bold text-gray-900"><%= current_user.name %></p>
    <nav>
      <ul class="space-y-1 text-sm font-medium">
        <li class="rounded-lg bg-gray-100 px-3 py-2 text-gray-900">대시보드</li>
        <li class="rounded-lg px-3 py-2 text-gray-500"><%= link_to "검토", teacher_reviews_path, class: "hover:text-gray-700" %></li>
        <li class="rounded-lg px-3 py-2 text-gray-500">학생관리</li>
      </ul>
    </nav>
  </aside>

  <section class="min-w-0 flex-1">
    <header class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">교사 대시보드</h1>
      <%= button_to "로그아웃", session_path, method: :delete,
            class: "rounded-lg bg-gray-800 px-4 py-2 text-sm text-white" %>
    </header>

    <%= render "shared/empty_state",
          message: "검토할 독후감이 아직 없습니다.", icon: "📝" %>
  </section>
</div>
