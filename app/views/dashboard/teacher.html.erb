<% content_for :title, "교사 콘솔 · 책갈피" %>

<div class="flex w-full gap-6">
  <%= render "teacher/nav", active: :dashboard %>

  <section class="min-w-0 flex-1">
    <header class="mb-6 flex items-center justify-between">
      <h1 class="text-2xl font-bold text-gray-900">교사 대시보드</h1>
      <%= button_to "로그아웃", session_path, method: :delete,
            class: "rounded-lg bg-gray-800 px-4 py-2 text-sm text-white" %>
    </header>

    <div class="grid gap-4 sm:grid-cols-2">
      <%= link_to teacher_dashboard_path,
            class: "rounded-lg border border-gray-200 p-5 hover:border-indigo-300" do %>
        <p class="text-lg font-semibold text-gray-900">학급 인사이트 &rarr;</p>
        <p class="mt-1 text-sm text-gray-500">5축 평균·방사형·약점 인사이트·검토 큐</p>
      <% end %>
      <%= link_to teacher_students_path,
            class: "rounded-lg border border-gray-200 p-5 hover:border-indigo-300" do %>
        <p class="text-lg font-semibold text-gray-900">학생관리 &rarr;</p>
        <p class="mt-1 text-sm text-gray-500">학생 추가·비밀번호 초기화·포인트 지급</p>
      <% end %>
      <%= link_to teacher_missions_path,
            class: "rounded-lg border border-gray-200 p-5 hover:border-indigo-300" do %>
        <p class="text-lg font-semibold text-gray-900">미션·퀴즈 &rarr;</p>
        <p class="mt-1 text-sm text-gray-500">독서 미션과 퀴즈를 만들어요</p>
      <% end %>
      <%= link_to teacher_exports_reports_csv_path,
            class: "rounded-lg border border-gray-200 p-5 hover:border-indigo-300" do %>
        <p class="text-lg font-semibold text-gray-900">문서 출력 &rarr;</p>
        <p class="mt-1 text-sm text-gray-500">사전·사후 5축 CSV·표창장·포트폴리오</p>
      <% end %>
    </div>
  </section>
</div>
