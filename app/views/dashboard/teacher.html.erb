<% content_for :title, "교사 콘솔 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <div class="flex flex-col gap-6 lg:flex-row">
    <%= render "teacher/nav", active: :dashboard %>

    <section class="min-w-0 flex-1">
      <header class="page-header">
        <h1 class="page-title">교사 대시보드</h1>
      </header>

      <div class="grid gap-4 sm:grid-cols-2">
        <%= link_to teacher_dashboard_path, class: "card transition-colors hover:border-brand-blue" do %>
          <p class="text-lg font-semibold text-ink">학급 인사이트 &rarr;</p>
          <p class="mt-1 text-sm text-steel">5축 평균·방사형·약점 인사이트·검토 목록</p>
        <% end %>
        <%= link_to teacher_students_path, class: "card transition-colors hover:border-brand-blue" do %>
          <p class="text-lg font-semibold text-ink">학생관리 &rarr;</p>
          <p class="mt-1 text-sm text-steel">학생 추가·비밀번호 초기화·포인트와 경험치 지급</p>
        <% end %>
        <%= link_to teacher_missions_path, class: "card transition-colors hover:border-brand-blue" do %>
          <p class="text-lg font-semibold text-ink">미션·퀴즈 &rarr;</p>
          <p class="mt-1 text-sm text-steel">독서 미션과 퀴즈를 만들어요</p>
        <% end %>
        <%# 목적지는 문서 출력 **화면**이다. 예전에는 이 카드가 CSV 다운로드로 직결돼 있어,
            문서를 보러 온 교사가 영문 모를 파일을 내려받았다(라벨과 동작 불일치). %>
        <%= link_to teacher_prints_path, class: "card transition-colors hover:border-brand-blue" do %>
          <p class="text-lg font-semibold text-ink">문서 출력 &rarr;</p>
          <p class="mt-1 text-sm text-steel">표창장·가정통신문·포트폴리오·학급 리포트와 5축 원자료 CSV</p>
        <% end %>
      </div>
    </section>
  </div>
</div>
