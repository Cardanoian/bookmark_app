<%# 사진 업로드 → OCR 초안. ocr_available? 일 때만 렌더. local: report %>
<section data-controller="photo-upload"
         class="card border-2 border-dashed border-hairline-strong bg-surface-soft">
  <h2 class="mb-1 text-sm font-semibold text-ink">사진으로 불러오기</h2>
  <p class="mb-3 text-xs text-steel">손으로 쓴 독후감을 찍으면 AI가 글자를 읽어 초안을 채워 줘요.</p>

  <%= form_with url: ocr_path, method: :post, multipart: true, class: "space-y-3" do %>
    <% if report.persisted? %>
      <%= hidden_field_tag "ocr[report_id]", report.id %>
    <% end %>
    <%= hidden_field_tag "ocr[book_title]", report.book_title %>

    <input type="file" accept="image/*" name="ocr[photo]"
           data-photo-upload-target="input"
           data-action="photo-upload#preview"
           class="block w-full text-sm text-slate file:mr-3 file:rounded-full file:border-0 file:bg-brand-blue file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-on-primary">

    <canvas data-photo-upload-target="canvas" class="hidden"></canvas>
    <img data-photo-upload-target="preview" alt="미리보기"
         class="hidden max-h-48 rounded-lg border border-hairline">

    <button type="submit" class="btn btn-blue">
      사진 인식하기
    </button>
  <% end %>

  <div id="ocr_status" class="mt-2 text-sm text-steel"></div>
</section>
