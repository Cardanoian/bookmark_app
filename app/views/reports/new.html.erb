<% content_for :title, "새 독후감 · 책갈피" %>

<div class="page-shell page-shell-form">
  <%= turbo_stream_from current_user, :report_editor %>

  <header class="page-header">
    <div>
      <h1 class="page-title">새 독후감 쓰기</h1>
      <p class="page-subtitle">읽은 책을 떠올리며 생각과 느낌을 자유롭게 적어 보세요.</p>
    </div>
  </header>

  <%= render "reports/form", report: @report %>

  <% if ocr_available? %>
    <div class="mt-6">
      <%= render "reports/ocr_upload", report: @report %>
    </div>
  <% end %>
</div>
