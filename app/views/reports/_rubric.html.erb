<%# 5축 루브릭 막대 표시(+교사 조정치). local: report %>
<div class="space-y-2">
  <% teacher_scores = report.teacher_rubric_scores %>
  <% report.rubric_scores.each do |axis, score| %>
    <% adjusted = teacher_scores[axis] %>
    <div class="flex items-center gap-3">
      <span class="w-20 shrink-0 text-sm text-gray-600"><%= axis_label(axis) %></span>
      <div class="h-2 flex-1 overflow-hidden rounded-full bg-gray-100">
        <div class="h-full rounded-full bg-amber-400" style="width: <%= (score.to_i * 20) %>%"></div>
      </div>
      <span class="w-16 shrink-0 text-right text-sm font-medium text-gray-700">
        <%= score %>/5
        <% if adjusted.present? %>
          <span class="text-indigo-600">→ <%= adjusted %></span>
        <% end %>
      </span>
    </div>
  <% end %>
</div>
