<%#
  안내형 독후감 작성(guided compose, §1a). worker-1 이 ReportsController#new 에서 세팅하는
  @guided(ReadingDomain.guided_questions 결과 Hash — questions[]/ratio_hint/spelling_tip)를
  그대로 소비한다(내용 하드코딩 금지). 학년군별 질문 문항 수·문구는 전부 @guided 에서 온다.

  locals 없이 @report/@guided(컨트롤러 ivar)를 직접 참조한다(new.html.erb 가 이 partial 을
  local 없이 렌더하며, 이 화면은 항상 새 글 작성 흐름에서만 쓰이므로 @report 가 항상 존재한다).

  질문 답변 textarea 는 서버로 전송되지 않는다(name 없음) — "초안 만들기" 클릭 시
  report_guide_controller#assemble 이 클라이언트에서 답변을 이어 붙여 실제 제출 필드인
  #report_body_field(_form → _body_field)를 채운 뒤에야 폼이 드러난다. 즉 create 액션·파라미터
  계약은 기존 자유 서술 폼과 완전히 동일하다(_form/_body_field 는 이 파일에서 수정하지 않는다).
%>
<% if @guided.blank? || @guided[:questions].blank? %>
  <%# 안전 폴백: 학년군 미지원·worker-1 미완성 등으로 질문 세트가 없으면 일반 폼으로 낙하한다. %>
  <%= render "reports/form", report: @report %>
<% else %>
  <div class="space-y-6" data-controller="report-guide"
       data-report-guide-user-id-value="<%= Current.user.id %>">
    <div class="card card-feature">
      <h2 class="text-xl font-bold text-ink">이 질문에 답하면 독후감이 완성돼요</h2>
      <p class="form-hint mt-2">
        <%= ui_icon :lightbulb %>
        <%= @guided[:ratio_hint] %>
      </p>
    </div>

    <%# localStorage 에 이어 쓸 답변이 있을 때만 컨트롤러가 노출한다(기본 hidden). %>
    <div data-report-guide-target="banner" class="state-banner state-banner--info hidden" role="status">
      <%= ui_icon :save %>
      <div class="min-w-0 flex-1">
        <p>쓰다 만 답변이 있어요. 이어서 쓸까요?</p>
        <div class="mt-2 flex flex-wrap gap-2">
          <button type="button" class="btn btn-secondary btn-sm" data-action="report-guide#restoreDraft">이어서 쓰기</button>
          <button type="button" class="btn btn-secondary btn-sm" data-action="report-guide#discardDraft">새로 시작</button>
        </div>
      </div>
    </div>

    <div class="space-y-4" data-report-guide-target="questions">
      <% part_labels = { intro: "서론", body: "본론", conclusion: "결론" } %>
      <% @guided[:questions].each_with_index do |q, i| %>
        <div class="card">
          <div class="mb-2 flex items-center gap-2">
            <span class="badge badge-info"><%= part_labels[q[:part]] || q[:part] %></span>
            <span class="text-xs text-steel"><%= i + 1 %> / <%= @guided[:questions].size %></span>
          </div>
          <p class="font-bold text-ink"><%= q[:question] %></p>
          <% if q[:hint].present? %>
            <p class="form-hint"><%= ui_icon :sparkle, class_name: "h-4 w-4" %> <%= q[:hint] %></p>
          <% end %>
          <%= tag.textarea nil,
                data: { report_guide_target: "answer", action: "input->report-guide#saveDraft" },
                aria: { label: q[:question] },
                placeholder: q[:example],
                rows: 3,
                class: "form-textarea mt-2" %>
        </div>
      <% end %>

      <% if @guided[:spelling_tip].present? %>
        <div class="state-banner">
          <%= ui_icon :document %>
          <span><%= @guided[:spelling_tip] %></span>
        </div>
      <% end %>

      <div data-report-guide-target="notice" class="state-banner state-banner--error hidden" role="alert">
        <%= ui_icon :writing %>
        <span>질문에 한 가지라도 답을 써 주세요.</span>
      </div>

      <div class="page-actions">
        <button type="button" class="btn btn-primary" data-action="report-guide#assemble">
          <%= ui_icon :writing %> 초안 만들기
        </button>
      </div>

      <p class="text-center">
        <%= link_to "질문 없이 바로 쓰기",
              new_report_path(input_mode: :keyboard, report: { book_id: @report.book_id, book_title: @report.book_title }),
              class: "inline-flex min-h-[44px] items-center px-3 text-sm text-brand-blue underline" %>
      </p>
    </div>

    <%# 제출용 _form. 기본은 보이게 두고(그레이스풀: JS 미로딩 시 질문+폼이 함께 보여 직접 작성·제출
        가능), report-guide 컨트롤러가 connect 시 숨겼다가 assemble() 이 답변을 #report_body_field 로
        옮긴 뒤 다시 드러낸다. _form 을 그대로 렌더해야 create 제출 필드(name 있는 body 등)가 존재한다. %>
    <div data-report-guide-target="form">
      <%= render "reports/form", report: @report %>
    </div>
  </div>
<% end %>
