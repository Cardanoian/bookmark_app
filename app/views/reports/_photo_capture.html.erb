<%# 사진으로 쓰기 — 책 제목 선택 + 사진 업로드(카메라/갤러리) → OCR 초안 생성. local: report %>
<%= render "reports/photo_guide" %>

<div class="card space-y-4" data-controller="photo-upload">
  <p class="text-sm text-steel">손으로 쓴 독후감을 찍으면 AI가 글자를 읽어 초안을 채워 줘요.</p>

  <%= form_with url: ocr_path, scope: :ocr, method: :post, multipart: true, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :book_title, "책 제목", class: "form-label" %>
      <%# form scope 가 :ocr 이라 book_id/remote_isbn hidden 은 ocr[...] 로 생성돼 OcrController 가 소비한다. %>
      <%= render "books/autocomplete_field",
            form: f,
            book_id_field: :book_id,
            title_field: :book_title,
            url: autocomplete_books_path,
            remote_search_url: remote_search_books_path,
            isbn_field: :remote_isbn,
            isbn_value: params.dig(:report, :remote_isbn),
            title_value: report.book_title,
            show_search_button: true,
            mode: "fallback",
            show_cover: true,
            selected_book: report.book %>
    </div>

    <div>
      <span class="form-label">독후감 사진</span>
      <input type="file" accept="image/*" name="ocr[photo]"
             data-photo-upload-target="input"
             data-action="photo-upload#preview"
             class="block w-full text-sm text-slate file:mr-3 file:rounded-full file:border-0 file:bg-brand-blue file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-on-primary">

      <canvas data-photo-upload-target="canvas" class="hidden"></canvas>
      <img data-photo-upload-target="preview" alt="미리보기"
           class="hidden mt-3 max-h-48 rounded-lg border border-hairline">
    </div>

    <div class="page-actions">
      <%= f.button type: :submit, class: "btn btn-primary" do %>
        <%= ui_icon :camera %> <span>사진 인식하기</span>
      <% end %>
      <%= link_to "취소", new_report_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
