<% content_for :title, "독후감 · 책갈피" %>

<div class="page-shell page-shell-content">
  <%= render "shared/student_nav", active: :reports %>

  <% if policy(Report).create? %>
    <div class="mb-6 flex justify-end sm:mb-8" data-page-action="new-report">
      <%= link_to "새 독후감 쓰기", new_report_path, class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if current_user.student? %>
    <%= turbo_stream_from current_user, :reports %>
  <% end %>

  <% if @reports.any? %>
    <div id="reports" class="space-y-4">
      <%= render partial: "reports/report", collection: @reports,
            locals: { show_delete: current_user.student? } %>
    </div>
  <% else %>
    <%= render "shared/empty_state",
          message: "아직 독후감이 없어요. 첫 독후감을 써 볼까요?", icon: "📚" %>
  <% end %>

  <% if @has_next_page || @page > 1 %>
    <nav class="mt-6 flex items-center justify-between text-sm">
      <% if @page > 1 %>
        <%= link_to "← 이전", reports_path(page: @page - 1), class: "btn btn-secondary btn-sm" %>
      <% else %>
        <span></span>
      <% end %>
      <% if @has_next_page %>
        <%= link_to "다음 →", reports_path(page: @page + 1), class: "btn btn-secondary btn-sm" %>
      <% else %>
        <span></span>
      <% end %>
    </nav>
  <% end %>
</div>
