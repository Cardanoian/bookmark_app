<%# 재첨삭 완료 시 AiReviewJob 이 이 영역만 Turbo 로 교체한다(라이브 갱신). local: report
    데스크톱은 본문/보조 정보(좌) + AI 5축 첨삭·피드백(우)로 분할하고, 모바일은 세로 스택. %>
<% has_feedback = report.ai_status == "done" && report.rubric.present? %>
<div id="<%= dom_id(report, :detail) %>" class="space-y-6">
  <header class="page-header">
    <div class="flex min-w-0 items-start gap-3">
      <% if report.book&.cover_url.present? %>
        <%= image_tag report.book.cover_url, alt: report.book.title,
              class: "h-20 w-14 shrink-0 rounded-md border border-hairline-soft object-cover shadow-sm",
              loading: "lazy" %>
      <% end %>
      <div class="min-w-0">
        <h1 class="page-title">
          <%= report.book&.title.presence || report.book_title %>
        </h1>
        <p class="page-subtitle"><%= report.user.name %> · <%= report.created_at.strftime("%Y-%m-%d") %></p>
        <%= book_meta_badges(report.book) %>
      </div>
    </div>
    <div class="page-actions">
      <%= level_badge(report.level) %>
      <%= ai_status_badge(report) %>
    </div>
  </header>

  <% if report.ai_status == "failed" %>
    <div class="state-banner state-banner--error">
      <span aria-hidden="true">⚠️</span>
      <span>첨삭에 실패했어요. 잠시 후 다시 시도해 주세요.</span>
    </div>
  <% elsif report.ai_status != "done" %>
    <div class="state-banner">
      <span aria-hidden="true">✍️</span>
      <span>AI 선생님이 첨삭 중이에요. 조금만 기다려 주세요.</span>
    </div>
  <% end %>

  <div class="space-y-6 lg:space-y-0 lg:items-start lg:gap-6<%= " lg:grid lg:grid-cols-[minmax(0,1fr)_320px]" if has_feedback %>">
    <div class="space-y-6">
      <section class="card">
        <h2 class="mb-2 text-sm font-semibold text-steel">내가 쓴 글</h2>
        <p class="whitespace-pre-wrap text-ink"><%= report.body %></p>
      </section>

      <% if report.reviewed? %>
        <section class="card border-hairline-soft bg-surface-featured">
          <h2 class="mb-1 text-sm font-semibold text-ink">선생님 확인</h2>
          <% if report.teacher_comment.present? %>
            <p class="text-sm text-ink"><%= report.teacher_comment %></p>
          <% else %>
            <p class="text-sm text-ink">선생님이 확인했어요.</p>
          <% end %>
        </section>
      <% end %>

      <% if report.revision? && (diff = report.diff_against_original) %>
        <section class="card">
          <h2 class="mb-3 text-lg font-semibold text-ink">고쳐쓰기 전 / 후</h2>
          <% if report.improvement.present? %>
            <p class="mb-3 text-sm font-medium text-brand-blue">
              향상도: <%= report.improvement >= 0 ? "+" : "" %><%= report.improvement %>점
            </p>
          <% end %>
          <div class="grid gap-3 md:grid-cols-2">
            <div>
              <h3 class="mb-1 text-xs font-semibold text-steel">이전 글</h3>
              <p class="whitespace-pre-wrap rounded-md bg-surface p-2 text-sm text-slate"><%= diff[:original_body] %></p>
            </div>
            <div>
              <h3 class="mb-1 text-xs font-semibold text-steel">고쳐 쓴 글</h3>
              <p class="whitespace-pre-wrap rounded-md bg-surface-featured p-2 text-sm text-ink"><%= diff[:revised_body] %></p>
            </div>
          </div>
          <% if diff[:added].any? %>
            <p class="mt-2 text-xs text-success-accent">새로 넣은 표현: <%= diff[:added].first(12).join(", ") %></p>
          <% end %>
        </section>
      <% end %>
    </div>

    <% if has_feedback %>
      <div class="space-y-6">
        <section class="card">
          <h2 class="mb-3 text-lg font-semibold text-ink">AI 선생님의 5축 첨삭</h2>
          <%= render "reports/rubric", report: report %>

          <% if report.praise_list.any? %>
            <div class="mt-4">
              <h3 class="mb-1 text-sm font-semibold text-success-accent">잘한 점</h3>
              <ul class="list-inside list-disc text-sm text-slate">
                <% report.praise_list.each do |line| %><li><%= line %></li><% end %>
              </ul>
            </div>
          <% end %>

          <% if report.fix_list.any? %>
            <div class="mt-3">
              <h3 class="mb-1 text-sm font-semibold text-yellow-dark">보완할 점</h3>
              <ul class="list-inside list-disc text-sm text-slate">
                <% report.fix_list.each do |line| %><li><%= line %></li><% end %>
              </ul>
            </div>
          <% end %>

          <% if report.grow_list.any? %>
            <div class="mt-3">
              <h3 class="mb-1 text-sm font-semibold text-brand-blue">성장 제안</h3>
              <ul class="list-inside list-disc text-sm text-slate">
                <% report.grow_list.each do |grow| %>
                  <li><%= grow[:text] %> <span class="text-xs text-stone"><%= grow[:standard_code] %></span></li>
                <% end %>
              </ul>
            </div>
          <% end %>
        </section>

        <% if (spelling = report.spelling_feedback) %>
          <section class="card card-muted">
            <h2 class="mb-1 text-sm font-semibold text-slate">중간 검사 · 맞춤법</h2>
            <p class="text-sm text-slate"><%= spelling[:message] %> (<%= spelling[:score] %>/5)</p>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
