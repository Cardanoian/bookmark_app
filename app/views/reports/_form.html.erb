<%# 독후감 작성·수정 폼. local: report, (선택) first_submit, (선택) conflict %>
<%# 기존 글(고쳐쓰기/수정)만 dirty-check 대상: 본문이 달라져야 저장 활성화.
    새 글은 위저드 초안이 프리필될 수 있어 컨트롤러를 붙이지 않는다.
    OCR 초안의 첫 제출(first_submit)도 마찬가지로 컨트롤러를 떼어 낸다 — OCR이 로드 전에
    빠르게 완료되면 textarea 기준값이 이미 OCR 본문이 되어 "그대로 제출"이 막히기 때문. %>
<% first_submit = local_assigns.fetch(:first_submit, false) %>
<% dirty_check = report.persisted? && !first_submit %>
<% submit_label = dirty_check ? "수정하기" : "제출하기" %>
<%# 자동 저장(report-autosave, 2026-09-12 되살림 — docs/improve/베타피드백_통합정리.md §5-1).
    컨트롤러는 모든 작성 폼에 붙이되, 실제로 저장하는 것은 `autosave_eligible?`(제출 전 초안,
    사진 초안의 첫 제출 화면 제외)이고 **글쓴이 본인이 연 화면**일 때뿐이다. 담임도 "이어서 쓰기"로
    학생 초안의 편집 화면에 들어올 수 있는데, 서버는 담임의 초안 저장을 403 으로 막는다 — 켜 두면
    입력할 때마다 거절당하며 저장 문구만 헛돈다. 그 밖의 폼(사진 첫 제출·이미 낸 글 수정·담임)에서는
    저장 없이 "저장 안 한 내용이 있어요" 이탈 경고만 한다.
    conflict(ReportsController#reject_stale_draft_save): 다른 탭·기기가 더 고친 초안을 이 화면의 글로
    저장·제출하려 한 직후다. 쓴 글은 그대로 보여 주고 버튼(임시 저장·제출)은 남기되 자동 저장은 끈다 —
    입력만으로 다른 곳의 글을 덮지 않고, 버튼을 한 번 더 누르는 것만 "이 글로 바꾸기"가 되게. %>
<% conflict = local_assigns.fetch(:conflict, false) %>
<% draft_controls = report.autosave_eligible? && report.user_id == current_user&.id %>
<% autosave = draft_controls && !conflict %>
<% form_data = {
     controller: [ ("report-edit" if dirty_check), "report-autosave" ].compact.join(" "),
     action: "input->report-autosave#changed book:selected->report-autosave#changed " \
             "submit->report-autosave#beforeSubmit turbo:submit-start->report-autosave#submissionStarted " \
             "turbo:submit-end->report-autosave#submitEnded",
     report_autosave_enabled_value: autosave,
     report_autosave_submit_label_value: submit_label
   } %>
<%# 고쳐쓰기 초안은 "원본에서 실제로 고쳤나"로 '수정하기'를 연다(서버 resubmit? 과 같은 기준).
    페이지를 연 순간의 본문을 기준으로 삼으면, 자동 저장된 글을 다시 열었을 때 이미 고친 글인데도
    버튼이 잠겨 선생님께 낼 수 없다. %>
<% form_data[:report_edit_baseline_value] = report.revision_of&.body.to_s if dirty_check && report.draft? && report.revision? %>
<%# 자동 저장 화면은 Turbo 스냅샷을 남기지 않는다. 뒤로 가기가 옛 스냅샷(빈 질문 칸)을 되살려
    그 위에 쓰면 서버에 저장된 초안이 적은 내용으로 덮인다 — 돌아올 때마다 서버의 최신 초안을 받는다. %>
<% turbo_exempts_page_from_cache if draft_controls %>
<%# 앱 전용: 새 글 제출 뒤 뒤로가기가 **입력값이 그대로 남은 작성 폼**으로 돌아간다(에뮬레이터 실측).
    거기서 그대로 다시 제출하면 같은 독후감이 한 편 더 생긴다 — 실제로 2편이 생기는 것을 확인했고,
    학생 포인트·경험치·미션 진행이 이중 집계되며 교사 검토 큐에도 같은 글이 두 번 뜬다.
    새 글 방문만 replace 로 바꿔 작성 폼을 히스토리에서 걷어낸다.
    · 고쳐쓰기·수정(persisted)은 제외 — 같은 글을 다시 저장할 뿐이라 중복 생성이 없고,
      학생이 뒤로 돌아가 이어서 고치는 것은 정상 동선이다.
    · 웹은 이 분기 밖이라 히스토리 동작이 지금까지와 같다. %>
<% form_data = form_data.merge(turbo_action: "replace") if hotwire_native_app? && !report.persisted? %>
<%= form_with model: report, class: "space-y-6", data: form_data do |f| %>
  <%# 직접 쓰기 폼임을 못박아, create 검증 실패 render :new 재렌더 시 input_mode 우선 분기가
      _form 으로 복원되게 한다(book_title 만 남아 mode_chooser 로 새는 회귀 차단). 값은 모델의
      input_mode 를 따르므로(고정값 아님) edit 로 재사용될 때 OCR 초안의 ocr 모드를 훼손하지 않는다. %>
  <%= f.hidden_field :input_mode %>
  <%# 두 표는 자동 저장뿐 아니라 임시 저장 버튼·제출에도 실린다(서버 stale_draft_version?).
      · draft_version — "내가 마지막으로 본 초안"(Report#draft_version). 저장할 때마다 report-autosave 가
        새 값으로 바꾸고, 새 글은 빈 값으로 두었다가 첫 저장이 채운다.
      · autosave_key — 이 편집 화면의 표. report-autosave 가 화면을 열 때 만든다(스크립트가 없으면 빈 값).
        같은 화면이 다시 보낸 요청을 알아보는 데 쓴다 — 첫 저장 재시도가 초안을 또 만들지 않고, 응답만
        잃은 저장이 "다른 곳에서 고쳤어요"로 거절되지 않게. %>
  <% if draft_controls %>
    <%= hidden_field_tag :draft_version, (report.draft_version if report.persisted?),
          id: nil, autocomplete: "off", data: { report_autosave_target: "version" } %>
    <%= hidden_field_tag :autosave_key, nil, id: nil, autocomplete: "off", data: { report_autosave_target: "key" } %>
  <% end %>
  <% if conflict %>
    <div class="state-banner state-banner--error" role="alert">
      <%= ui_icon :warning %>
      <span>
        다른 탭이나 기기에서 이 글을 더 고쳤어요. 아래는 이 화면에서 쓴 글이에요.
        이 글로 바꾸려면 ‘임시 저장’이나 ‘<%= submit_label %>’를 한 번 더 누르세요.
        <%= link_to "최신 글 보기", edit_report_path(report), class: "underline font-semibold" %>
        (이 화면에서 쓴 내용은 사라지니 필요하면 먼저 복사해 두세요.)
      </span>
    </div>
  <% end %>
  <% if report.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <%= ui_icon :warning %>
      <ul class="list-inside list-disc">
        <% report.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :book_title, "책 제목", class: "form-label" %>
    <%# 도서 자동완성(WS-D). 목록에서 고르면 hidden report[book_id] 가 채워지고, 안 고르면
        표시 input(title_field: :book_title)이 report[book_title] 자유텍스트로 저장된다(fallback). %>
    <%= render "books/autocomplete_field",
          form: f,
          book_id_field: :book_id,
          title_field: :book_title,
          url: autocomplete_books_path,
          remote_search_url: remote_search_books_path,
          isbn_field: :remote_isbn,
          isbn_value: params.dig(:report, :remote_isbn),
          show_search_button: true,
          mode: "fallback",
          show_cover: true,
          selected_book: report.book %>
    <% if report.errors[:book_title].any? %>
      <p class="form-error"><%= report.errors.full_messages_for(:book_title).join(", ") %></p>
    <% end %>
  </div>

  <div>
    <%= f.label :body, "독후감", class: "form-label" %>
    <%= render "reports/body_field", report: report %>
    <% if report.errors[:body].any? %>
      <p class="form-error"><%= report.errors.full_messages_for(:body).join(", ") %></p>
    <% end %>
  </div>

  <% unless ocr_available? %>
    <div class="state-banner state-banner--info">
      <%= ui_icon :info %>
      <span>지금은 사진(OCR) 입력을 사용할 수 없어요. 키보드로 입력해 주세요.</span>
    </div>
  <% end %>

  <div class="page-actions">
    <%= f.submit submit_label,
          class: "btn btn-primary",
          data: { "report-edit-target": "submit" } %>
    <%# 임시 저장 — 자동 저장과 같은 대상(`autosave_eligible?`)에만. **사진(OCR) 초안의 첫 제출
        화면은 제외**한다: 그 화면은 "잘못 읽은 곳을 고친 뒤 제출하기를 눌러야 선생님 첨삭이
        시작돼요"를 못박고 있는데(edit.html.erb), 옆에 임시 저장이 나란히 뜨면 아이가 저장했다고
        믿고 떠나 첨삭이 영영 안 붙는다. 자동 저장이 있어도 버튼을 남기는 이유는 "지금 저장됐나"를
        아이가 직접 확인할 수 있는 손잡이이기 때문이다.
        report-edit 의 submit 타깃을 달지 않아 dirty-check 와 무관하게 항상 누를 수 있다.
        담임에게는 보이지 않는다(서버가 담임의 초안 저장을 막는다 — 위 `autosave` 주석). %>
    <% if draft_controls %>
      <%= f.submit "임시 저장", name: "save_draft", class: "btn btn-secondary" %>
    <% end %>
    <%= link_to "취소", reports_path, class: "btn btn-secondary" %>
  </div>

  <% if autosave %>
    <%# 자동 저장 상태. report-autosave 가 "저장 중 / 오후 2:14에 저장했어요 / 저장하지 못했어요"로
        바꾼다. '저장'이 '제출'로 읽히지 않게 저장 문구마다 남은 행동(제출하기)을 함께 적는다. %>
    <p class="form-hint" role="status" aria-live="polite" data-report-autosave-target="status">
      쓰는 내용은 자동으로 저장돼요. 다 쓰면 ‘<%= submit_label %>’를 눌러요.
    </p>
  <% end %>
<% end %>
