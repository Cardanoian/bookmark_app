<%# 독후감 작성·수정 폼. local: report, (선택) first_submit %>
<%# 기존 글(고쳐쓰기/수정)만 dirty-check 대상: 본문이 달라져야 저장 활성화.
    새 글은 위저드 초안이 프리필될 수 있어 컨트롤러를 붙이지 않는다.
    OCR 초안의 첫 제출(first_submit)도 마찬가지로 컨트롤러를 떼어 낸다 — OCR이 로드 전에
    빠르게 완료되면 textarea 기준값이 이미 OCR 본문이 되어 "그대로 제출"이 막히기 때문. %>
<% first_submit = local_assigns.fetch(:first_submit, false) %>
<%= form_with model: report, class: "space-y-6",
      data: ((report.persisted? && !first_submit) ? { controller: "report-edit" } : {}) do |f| %>
  <% if report.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <span aria-hidden="true">⚠️</span>
      <ul class="list-inside list-disc">
        <% report.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :book_title, "책 제목", class: "form-label" %>
    <%# 도서 자동완성(WS-D). 목록에서 고르면 hidden report[book_id] 가 채워지고, 안 고르면
        표시 input(title_field: :book_title)이 report[book_title] 자유텍스트로 저장된다(fallback). %>
    <%= render "books/autocomplete_field",
          form: f,
          book_id_field: :book_id,
          title_field: :book_title,
          url: search_books_path,
          mode: "fallback",
          show_cover: true,
          selected_book: report.book %>
    <% if report.errors[:book_title].any? %>
      <p class="form-error"><%= report.errors.full_messages_for(:book_title).join(", ") %></p>
    <% end %>
  </div>

  <div>
    <%= f.label :body, "독후감", class: "form-label" %>
    <%= render "reports/body_field", report: report %>
    <% if report.errors[:body].any? %>
      <p class="form-error"><%= report.errors.full_messages_for(:body).join(", ") %></p>
    <% end %>
  </div>

  <% unless ocr_available? %>
    <div class="state-banner state-banner--info">
      <span aria-hidden="true">ℹ️</span>
      <span>지금은 사진(OCR) 입력을 사용할 수 없어요. 키보드로 입력해 주세요.</span>
    </div>
  <% end %>

  <div class="page-actions">
    <%= f.submit (report.persisted? && !first_submit) ? "수정하기" : "제출하기",
          class: "btn btn-primary",
          data: { "report-edit-target": "submit" } %>
    <%= link_to "취소", reports_path, class: "btn btn-secondary" %>
  </div>
<% end %>
