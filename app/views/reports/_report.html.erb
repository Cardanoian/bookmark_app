<%# 내 서재 목록·승인 실시간 갱신 대상. local: report %>
<article id="<%= dom_id(report) %>" class="card relative">
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-3">
      <% if report.book&.cover_url.present? %>
        <%= image_tag report.book.cover_url, alt: report.book.title,
              class: "h-16 w-11 shrink-0 rounded border border-hairline-soft object-cover shadow-sm",
              loading: "lazy" %>
      <% end %>
      <div class="min-w-0">
        <%= link_to (report.book&.title.presence || report.book_title), report_path(report),
              class: "font-semibold text-ink hover:underline after:absolute after:inset-0 after:content-['']" %>
        <%= book_meta_badges(report.book) %>
        <p class="mt-1 line-clamp-2 text-sm text-steel"><%= truncate(report.body.to_s, length: 80) %></p>
      </div>
    </div>
    <div class="relative z-10 flex shrink-0 items-center gap-2">
      <% if report.reviewed? %>
        <%= level_badge(report.level) %>
      <% end %>
      <%= student_status_badge(report) %>
      <% if local_assigns.fetch(:show_delete, false) %>
        <%= button_to "삭제", report_path(report), method: :delete,
              form: { data: { turbo_confirm: "이 독후감을 삭제할까요? 삭제한 글은 되돌릴 수 없어요." } },
              class: "btn btn-sm btn-danger" %>
      <% end %>
    </div>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <% if report.reviewed? %>
      <span class="badge badge-success">교사 승인 완료</span>
    <% end %>
    <% if report.revision? %>
      <span class="badge badge-info">고쳐쓰기</span>
    <% end %>
    <% if report.shared? %>
      <span class="badge badge-yellow">공유됨</span>
    <% end %>
  </div>

  <%# 교사 코멘트도 승인(reviewed) 후에만 노출한다 — 승인 전 코멘트만 저장한 경우의 누출 차단
      (상세 화면 _report_detail 의 reviewed? 게이트와 대칭). %>
  <% if report.reviewed? && report.teacher_comment.present? %>
    <p class="mt-3 rounded-md border border-hairline-soft bg-surface-featured p-2 text-sm text-ink">
      선생님: <%= report.teacher_comment %>
    </p>
  <% end %>
</article>
