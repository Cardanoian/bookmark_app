<% content_for :title, "#{@report.book&.title.presence || @report.book_title} · 책갈피" %>

<div class="w-full max-w-2xl mx-auto space-y-6">
  <header class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-gray-900">
        <%= @report.book&.title.presence || @report.book_title %>
      </h1>
      <p class="mt-1 text-sm text-gray-500"><%= @report.user.name %> · <%= @report.created_at.strftime("%Y-%m-%d") %></p>
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <%= level_badge(@report.level) %>
      <%= ai_status_badge(@report) %>
    </div>
  </header>

  <section class="rounded-lg border border-gray-200 p-4">
    <h2 class="mb-2 text-sm font-semibold text-gray-500">내가 쓴 글</h2>
    <p class="whitespace-pre-wrap text-gray-800"><%= @report.body %></p>
  </section>

  <% if @report.ai_status == "done" && @report.rubric.present? %>
    <section class="rounded-lg border border-gray-200 p-4">
      <h2 class="mb-3 text-lg font-semibold text-gray-900">AI 선생님의 5축 첨삭</h2>
      <%= render "reports/rubric", report: @report %>

      <% if @report.praise_list.any? %>
        <div class="mt-4">
          <h3 class="mb-1 text-sm font-semibold text-emerald-700">잘한 점</h3>
          <ul class="list-inside list-disc text-sm text-gray-700">
            <% @report.praise_list.each do |line| %><li><%= line %></li><% end %>
          </ul>
        </div>
      <% end %>

      <% if @report.fix_list.any? %>
        <div class="mt-3">
          <h3 class="mb-1 text-sm font-semibold text-amber-700">보완할 점</h3>
          <ul class="list-inside list-disc text-sm text-gray-700">
            <% @report.fix_list.each do |line| %><li><%= line %></li><% end %>
          </ul>
        </div>
      <% end %>

      <% if @report.grow_list.any? %>
        <div class="mt-3">
          <h3 class="mb-1 text-sm font-semibold text-sky-700">성장 제안</h3>
          <ul class="list-inside list-disc text-sm text-gray-700">
            <% @report.grow_list.each do |grow| %>
              <li><%= grow[:text] %> <span class="text-xs text-gray-400"><%= grow[:standard_code] %></span></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>

    <% if (spelling = @report.spelling_feedback) %>
      <section class="rounded-lg border border-gray-200 bg-gray-50 p-4">
        <h2 class="mb-1 text-sm font-semibold text-gray-700">중간 검사 · 맞춤법</h2>
        <p class="text-sm text-gray-700"><%= spelling[:message] %> (<%= spelling[:score] %>/5)</p>
      </section>
    <% end %>
  <% elsif @report.ai_status == "failed" %>
    <section class="rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
      첨삭에 실패했어요. 잠시 후 다시 시도해 주세요.
    </section>
  <% else %>
    <section class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-700">
      AI 선생님이 첨삭 중이에요. 조금만 기다려 주세요.
    </section>
  <% end %>

  <% if @report.reviewed? %>
    <section class="rounded-lg border border-indigo-200 bg-indigo-50 p-4">
      <h2 class="mb-1 text-sm font-semibold text-indigo-800">선생님 확인</h2>
      <% if @report.teacher_comment.present? %>
        <p class="text-sm text-indigo-900"><%= @report.teacher_comment %></p>
      <% else %>
        <p class="text-sm text-indigo-900">선생님이 확인했어요.</p>
      <% end %>
    </section>
  <% end %>

  <% if @report.revision? && (diff = @report.diff_against_original) %>
    <section class="rounded-lg border border-purple-200 p-4">
      <h2 class="mb-3 text-lg font-semibold text-purple-800">고쳐쓰기 전 / 후</h2>
      <% if @report.improvement.present? %>
        <p class="mb-3 text-sm font-medium text-purple-700">
          향상도: <%= @report.improvement >= 0 ? "+" : "" %><%= @report.improvement %>점
        </p>
      <% end %>
      <div class="grid gap-3 md:grid-cols-2">
        <div>
          <h3 class="mb-1 text-xs font-semibold text-gray-500">이전 글</h3>
          <p class="whitespace-pre-wrap rounded-md bg-gray-50 p-2 text-sm text-gray-600"><%= diff[:original_body] %></p>
        </div>
        <div>
          <h3 class="mb-1 text-xs font-semibold text-gray-500">고쳐 쓴 글</h3>
          <p class="whitespace-pre-wrap rounded-md bg-purple-50 p-2 text-sm text-gray-800"><%= diff[:revised_body] %></p>
        </div>
      </div>
      <% if diff[:added].any? %>
        <p class="mt-2 text-xs text-emerald-700">새로 넣은 표현: <%= diff[:added].first(12).join(", ") %></p>
      <% end %>
    </section>
  <% end %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(@report).edit? %>
      <%= link_to "수정", edit_report_path(@report), class: "rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700" %>
    <% end %>
    <% if policy(@report).revise? %>
      <%= button_to "고쳐쓰기", revise_report_path(@report), method: :post,
            class: "rounded-lg bg-purple-500 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
    <% if policy(@report).share? %>
      <%= button_to @report.shared? ? "공유 취소" : "우수작 공유", share_report_path(@report), method: :post,
            class: "rounded-lg bg-teal-500 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
    <%= link_to "목록", reports_path, class: "text-sm text-gray-500" %>
  </div>
</div>
