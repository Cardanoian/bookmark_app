<% content_for :title, "#{@report.book&.title.presence || @report.book_title} · 책갈피" %>

<div class="w-full max-w-2xl mx-auto space-y-6">
  <%# 첨삭·재첨삭 완료 시 AiReviewJob 이 상세 영역을 실시간 교체한다(수동 새로고침 불필요). %>
  <%= turbo_stream_from @report %>

  <%= render "reports/report_detail", report: @report %>

  <div class="flex flex-wrap items-center gap-3">
    <% if policy(@report).revise? %>
      <%= button_to "고쳐쓰기", revise_report_path(@report), method: :post,
            class: "rounded-lg bg-purple-500 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
    <% if policy(@report).share? %>
      <%= button_to @report.shared? ? "공유 취소" : "우수작 공유", share_report_path(@report), method: :post,
            class: "rounded-lg bg-teal-500 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
    <%= link_to "목록", reports_path, class: "text-sm text-gray-500" %>
  </div>
</div>
