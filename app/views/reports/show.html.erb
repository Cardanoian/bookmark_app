<% content_for :title, "#{@report.book&.title.presence || @report.book_title} · 책갈피" %>

<div class="page-shell page-shell-reading space-y-6">
  <%# 첨삭·재첨삭 완료 시 AiReviewJob 이 상세 영역을 실시간 교체한다(수동 새로고침 불필요). %>
  <%= turbo_stream_from @report %>

  <%= render "reports/report_detail", report: @report %>

  <%# 사진(OCR) 독후감의 원본은 상태와 무관한 불변 자원이라 라이브 교체 영역(_report_detail)
      **밖**, show 스캐폴드에 둔다(방송 파티셜 표면 최소화). %>
  <%= render "reports/ocr_photo", report: @report %>

  <div class="page-actions">
    <%# 미제출 초안의 다음 행동은 "고쳐쓰기"가 아니라 "제출"이다. 작성자에게만 편집 화면으로
        가는 CTA 를 주고(초안 상태에서 revise 는 무의미한 사본을 늘리므로 함께 숨긴다),
        뷰어 판정이 필요한 분기라 방송 파셜(_report_detail)이 아닌 HTTP 셸인 여기에 둔다. %>
    <% if @report.draft? %>
      <% if policy(@report).edit? %>
        <%= link_to "이어서 쓰고 제출하기", edit_report_path(@report), class: "btn btn-primary" %>
      <% end %>
    <% elsif policy(@report).revise? %>
      <%= button_to "고쳐쓰기", revise_report_path(@report), method: :post,
            class: "btn btn-primary" %>
    <% end %>
    <% if policy(@report).share? %>
      <%= button_to @report.shared? ? "공유 취소" : "우수작 공유", share_report_path(@report), method: :post,
            class: "btn btn-blue" %>
    <% end %>
    <%= link_to "목록", reports_path, class: "btn btn-secondary" %>
  </div>
</div>
