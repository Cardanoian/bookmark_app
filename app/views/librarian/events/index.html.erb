<%# 이달의 책·행사 목록(P6.5). 사서의 소속 학교 행사만 표시. %>
<div class="page-shell page-shell-wide space-y-6">
  <header class="page-header">
    <h1 class="page-title">이달의 책·행사</h1>
    <div class="page-actions">
      <%= link_to "행사 등록", new_librarian_event_path, class: "btn btn-primary" %>
    </div>
  </header>

  <% if @events.empty? %>
    <%= render "shared/empty_state", message: "아직 등록된 행사가 없어요." %>
  <% else %>
    <ul class="space-y-3">
      <% @events.each do |event| %>
        <li class="card">
          <div class="flex items-center justify-between">
            <%= link_to event.title, librarian_event_path(event),
                  class: "font-medium text-ink hover:underline" %>
            <span class="text-sm text-steel"><%= event.event_on&.strftime("%Y-%m-%d") %></span>
          </div>
          <% if event.description.present? %>
            <p class="mt-1 line-clamp-2 text-sm text-slate"><%= event.description %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
