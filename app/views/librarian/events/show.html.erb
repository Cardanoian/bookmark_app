<%# 이달의 책·행사 상세(P6.5). %>
<div class="mx-auto max-w-2xl space-y-6 p-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900"><%= @event.title %></h1>
    <%= link_to "목록", librarian_events_path, class: "text-sm text-gray-500" %>
  </div>

  <div class="rounded-lg border border-gray-200 p-5">
    <dl class="space-y-3 text-sm">
      <div class="flex gap-3">
        <dt class="w-24 shrink-0 text-gray-500">행사일</dt>
        <dd class="text-gray-900"><%= @event.event_on&.strftime("%Y-%m-%d") || "미정" %></dd>
      </div>
      <% if @event.book.present? %>
        <div class="flex gap-3">
          <dt class="w-24 shrink-0 text-gray-500">추천 도서</dt>
          <dd class="text-gray-900"><%= @event.book.title %></dd>
        </div>
      <% end %>
      <% if @event.description.present? %>
        <div class="flex gap-3">
          <dt class="w-24 shrink-0 text-gray-500">설명</dt>
          <dd class="whitespace-pre-line text-gray-700"><%= @event.description %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "수정", edit_librarian_event_path(@event),
          class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <%= button_to "삭제", librarian_event_path(@event), method: :delete,
          class: "rounded-lg border border-rose-200 px-4 py-2 text-sm text-rose-600",
          form: { data: { turbo_confirm: "이 행사를 삭제할까요?" } } %>
  </div>
</div>
