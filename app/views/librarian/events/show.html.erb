<%# 이달의 책·행사 상세(P6.5). %>
<div class="page-shell page-shell-content space-y-6">
  <header class="page-header">
    <h1 class="page-title"><%= @event.title %></h1>
    <%= link_to "목록", librarian_events_path, class: "text-sm font-medium text-steel hover:text-ink hover:underline" %>
  </header>

  <div class="card">
    <dl class="space-y-3 text-sm">
      <div class="flex gap-3">
        <dt class="w-24 shrink-0 text-steel">행사일</dt>
        <dd class="text-ink"><%= @event.event_on&.strftime("%Y-%m-%d") || "미정" %></dd>
      </div>
      <% if @event.book.present? %>
        <div class="flex gap-3">
          <dt class="w-24 shrink-0 text-steel">추천 도서</dt>
          <dd class="text-ink"><%= @event.book.title %></dd>
        </div>
      <% end %>
      <% if @event.description.present? %>
        <div class="flex gap-3">
          <dt class="w-24 shrink-0 text-steel">설명</dt>
          <dd class="whitespace-pre-line text-slate"><%= @event.description %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="flex items-center gap-3">
    <%= link_to "수정", edit_librarian_event_path(@event), class: "btn btn-primary" %>
    <%= button_to "삭제", librarian_event_path(@event), method: :delete,
          class: "btn btn-danger",
          form: { data: { turbo_confirm: "이 행사를 삭제할까요?" } } %>
  </div>
</div>
