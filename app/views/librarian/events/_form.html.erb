<%# 이달의 책·행사 폼. local: event %>
<%= form_with model: event, url: (event.persisted? ? librarian_event_path(event) : librarian_events_path),
      class: "card space-y-4" do |f| %>
  <% if event.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <span aria-hidden="true">⚠️</span>
      <%= event.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "제목", class: "form-label" %>
    <%= f.text_field :title, class: "form-input" %>
  </div>

  <div>
    <%= f.label :description, "설명", class: "form-label" %>
    <%= f.text_area :description, rows: 4, class: "form-textarea" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :event_on, "행사일", class: "form-label" %>
      <%= f.date_field :event_on, class: "form-input" %>
    </div>
    <div>
      <%= f.label :book_id, "추천 도서 ID (선택)", class: "form-label" %>
      <%= f.number_field :book_id, class: "form-input" %>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "btn btn-primary" %>
    <%= link_to "취소", librarian_events_path, class: "text-sm font-medium text-steel hover:text-ink hover:underline" %>
  </div>
<% end %>
