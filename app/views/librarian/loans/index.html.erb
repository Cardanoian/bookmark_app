<% content_for :title, "인기 대출 · 책갈피" %>

<div class="page-shell page-shell-wide space-y-6">
  <header class="page-header">
    <div>
      <p class="text-sm font-medium text-moss-dark">도서관 담당 · 인기 대출</p>
      <h1 class="page-title">인기 대출 Top</h1>
    </div>
    <div class="page-actions">
      <%= link_to "대시보드", librarian_dashboard_path, class: "btn btn-secondary" %>
    </div>
  </header>

  <div class="card flex flex-wrap items-center gap-3">
    <%= button_to "정보나루 동기화", sync_data4library_librarian_loans_path, class: "btn btn-blue" %>
    <%= form_with url: import_csv_librarian_loans_path, method: :post, multipart: true,
          class: "flex flex-wrap items-center gap-2" do |f| %>
      <%= f.file_field :file, accept: ".csv,text/csv",
            class: "text-sm text-slate file:mr-2 file:rounded-full file:border-0 file:bg-surface file:px-3 file:py-1.5 file:text-sm file:font-medium file:text-ink" %>
      <%= f.submit "CSV 업로드", class: "btn btn-secondary" %>
    <% end %>
  </div>

  <section class="card">
    <h2 class="mb-3 text-lg font-semibold text-ink">대출 순위</h2>
    <% if @loans.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-steel">
              <th class="py-2 pr-3">#</th>
              <th class="py-2 pr-3">도서명</th>
              <th class="py-2 pr-3">대출</th>
              <th class="py-2 pr-3">기간</th>
              <th class="py-2 pr-3">출처</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline-soft">
            <% @loans.each_with_index do |loan, index| %>
              <tr>
                <td class="py-2 pr-3 font-bold text-moss-dark"><%= index + 1 %></td>
                <td class="py-2 pr-3 font-medium text-ink"><%= loan.book_title %></td>
                <td class="py-2 pr-3 text-slate"><%= loan.count %>회</td>
                <td class="py-2 pr-3 text-steel"><%= loan.period %></td>
                <td class="py-2 pr-3 text-steel">
                  <%= loan.school_id.nil? ? "전국(정보나루)" : (loan.data4library? ? "정보나루" : "CSV") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state",
            message: "인기 대출 데이터가 없습니다. 정보나루 동기화 또는 CSV 업로드를 사용하세요.", icon: "📚" %>
    <% end %>
  </section>

  <section class="card">
    <h2 class="mb-3 text-lg font-semibold text-ink">수동 입력</h2>
    <%= form_with model: @loan, url: librarian_loans_path, class: "grid gap-3 sm:grid-cols-2" do |f| %>
      <% if @loan.errors.any? %>
        <div class="state-banner state-banner--error sm:col-span-2" role="alert">
          <span aria-hidden="true">⚠️</span>
          <%= @loan.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <div class="sm:col-span-2">
        <%= f.label :book_title, "도서명", class: "form-label" %>
        <%= f.text_field :book_title, class: "form-input" %>
      </div>
      <div>
        <%= f.label :count, "대출 건수", class: "form-label" %>
        <%= f.number_field :count, value: f.object.count || 0, min: 0, class: "form-input" %>
      </div>
      <div>
        <%= f.label :period, "기간 (예: 2026-06)", class: "form-label" %>
        <%= f.text_field :period, class: "form-input" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.submit "추가", class: "btn btn-primary" %>
      </div>
    <% end %>
  </section>
</div>
