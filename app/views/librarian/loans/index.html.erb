<% content_for :title, "인기 대출 · 책갈피" %>

<div class="w-full max-w-3xl mx-auto space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-emerald-600">도서관 담당 · 인기 대출</p>
      <h1 class="text-2xl font-bold text-gray-900">인기 대출 Top</h1>
    </div>
    <%= link_to "대시보드", librarian_dashboard_path,
          class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700" %>
  </header>

  <div class="flex flex-wrap gap-3">
    <%= button_to "정보나루 동기화", sync_data4library_librarian_loans_path,
          class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white" %>
    <%= form_with url: import_csv_librarian_loans_path, method: :post, multipart: true,
          class: "flex items-center gap-2" do |f| %>
      <%= f.file_field :file, accept: ".csv,text/csv",
            class: "text-sm text-gray-700 file:mr-2 file:rounded-lg file:border-0 file:bg-gray-100 file:px-3 file:py-1.5" %>
      <%= f.submit "CSV 업로드", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <section class="rounded-lg border border-gray-200 p-5">
    <h2 class="mb-3 text-lg font-semibold text-gray-900">대출 순위</h2>
    <% if @loans.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500">
              <th class="py-2 pr-3">#</th>
              <th class="py-2 pr-3">도서명</th>
              <th class="py-2 pr-3">대출</th>
              <th class="py-2 pr-3">기간</th>
              <th class="py-2 pr-3">출처</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @loans.each_with_index do |loan, index| %>
              <tr>
                <td class="py-2 pr-3 font-bold text-emerald-600"><%= index + 1 %></td>
                <td class="py-2 pr-3 font-medium text-gray-900"><%= loan.book_title %></td>
                <td class="py-2 pr-3 text-gray-700"><%= loan.count %>회</td>
                <td class="py-2 pr-3 text-gray-500"><%= loan.period %></td>
                <td class="py-2 pr-3 text-gray-500">
                  <%= loan.school_id.nil? ? "전국(정보나루)" : (loan.data4library? ? "정보나루" : "CSV") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= render "shared/empty_state",
            message: "인기 대출 데이터가 없습니다. 정보나루 동기화 또는 CSV 업로드를 사용하세요.", icon: "📚" %>
    <% end %>
  </section>

  <section class="rounded-lg border border-gray-200 p-5">
    <h2 class="mb-3 text-lg font-semibold text-gray-900">수동 입력</h2>
    <%= form_with model: @loan, url: librarian_loans_path, class: "grid gap-3 sm:grid-cols-2" do |f| %>
      <% if @loan.errors.any? %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700 sm:col-span-2">
          <%= @loan.errors.full_messages.to_sentence %>
        </div>
      <% end %>
      <div class="sm:col-span-2">
        <%= f.label :book_title, "도서명", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :book_title, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
      </div>
      <div>
        <%= f.label :count, "대출 건수", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.number_field :count, value: f.object.count || 0, min: 0,
              class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
      </div>
      <div>
        <%= f.label :period, "기간 (예: 2026-06)", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= f.text_field :period, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
      </div>
      <div class="sm:col-span-2">
        <%= f.submit "추가", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
      </div>
    <% end %>
  </section>
</div>
