<% content_for :title, "도서관 대시보드 · 책갈피" %>

<div class="page-shell page-shell-wide space-y-6">
  <header class="page-header">
    <div>
      <p class="text-sm font-medium text-moss-dark">도서관 담당</p>
      <h1 class="page-title"><%= @school&.name %></h1>
    </div>
    <div class="page-actions">
      <%= link_to "인기 대출", librarian_loans_path, class: "btn btn-secondary" %>
      <%= link_to "이달의 책·행사", librarian_events_path, class: "btn btn-secondary" %>
    </div>
  </header>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    <div class="stat-card">
      <span class="stat-card__label">전교 독후감</span>
      <span class="stat-card__value"><%= @report_count %></span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">참여 학생</span>
      <span class="stat-card__value text-moss-dark"><%= @reader_count %></span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">등록 행사</span>
      <span class="stat-card__value"><%= @events.size %></span>
    </div>
  </div>

  <section class="card">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-ink">인기 도서 (대출)</h2>
      <%= link_to "관리", librarian_loans_path, class: "text-sm font-medium text-moss-dark hover:underline" %>
    </div>
    <% if @loans.any? %>
      <ol class="space-y-1 text-sm">
        <% @loans.each_with_index do |loan, index| %>
          <li class="flex items-center justify-between gap-3 py-1">
            <span class="min-w-0 truncate">
              <span class="mr-2 font-bold text-moss-dark"><%= index + 1 %></span>
              <span class="font-medium text-ink"><%= loan.book_title %></span>
              <% if loan.school_id.nil? %><span class="ml-1 text-xs text-muted">전국</span><% end %>
            </span>
            <span class="shrink-0 text-steel"><%= loan.count %>회</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <%= render "shared/empty_state",
            message: "인기 대출 데이터가 없습니다. 정보나루 동기화 또는 CSV 업로드를 사용하세요.", icon: :books %>
    <% end %>
  </section>

  <section class="card">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-ink">이달의 책·행사</h2>
      <%= link_to "새 행사", new_librarian_event_path, class: "text-sm font-medium text-moss-dark hover:underline" %>
    </div>
    <% if @events.any? %>
      <ul class="divide-y divide-hairline-soft text-sm">
        <% @events.each do |event| %>
          <li class="py-2">
            <span class="font-medium text-ink"><%= event.title %></span>
            <% if event.event_on %><span class="ml-2 text-xs text-steel"><%= event.event_on %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render "shared/empty_state", message: "이달의 책과 행사를 등록해 보세요.", icon: :book_open %>
    <% end %>
  </section>
</div>
