<% content_for :title, "도서관 대시보드 · 책갈피" %>

<div class="w-full max-w-4xl mx-auto space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-emerald-600">도서관 담당</p>
      <h1 class="text-2xl font-bold text-gray-900"><%= @school&.name %></h1>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "인기 대출", librarian_loans_path,
            class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700" %>
      <%= link_to "이달의 책·행사", librarian_events_path,
            class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700" %>
      <%= button_to "로그아웃", session_path, method: :delete,
            class: "rounded-lg bg-gray-800 px-4 py-2 text-sm text-white" %>
    </div>
  </header>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500">전교 독후감</p>
      <p class="mt-1 text-2xl font-bold text-gray-900"><%= @report_count %></p>
    </div>
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500">참여 학생</p>
      <p class="mt-1 text-2xl font-bold text-emerald-600"><%= @reader_count %></p>
    </div>
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500">등록 행사</p>
      <p class="mt-1 text-2xl font-bold text-gray-900"><%= @events.size %></p>
    </div>
  </div>

  <section class="rounded-lg border border-gray-200 p-5">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">인기 도서 (대출)</h2>
      <%= link_to "관리", librarian_loans_path, class: "text-sm text-emerald-600" %>
    </div>
    <% if @loans.any? %>
      <ol class="space-y-1 text-sm">
        <% @loans.each_with_index do |loan, index| %>
          <li class="flex items-center justify-between gap-3 py-1">
            <span class="min-w-0 truncate">
              <span class="mr-2 font-bold text-emerald-600"><%= index + 1 %></span>
              <span class="font-medium text-gray-900"><%= loan.book_title %></span>
              <% if loan.school_id.nil? %><span class="ml-1 text-xs text-gray-400">전국</span><% end %>
            </span>
            <span class="shrink-0 text-gray-500"><%= loan.count %>회</span>
          </li>
        <% end %>
      </ol>
    <% else %>
      <%= render "shared/empty_state",
            message: "인기 대출 데이터가 없습니다. 정보나루 동기화 또는 CSV 업로드를 사용하세요.", icon: "📚" %>
    <% end %>
  </section>

  <section class="rounded-lg border border-gray-200 p-5">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-900">이달의 책·행사</h2>
      <%= link_to "새 행사", new_librarian_event_path, class: "text-sm text-emerald-600" %>
    </div>
    <% if @events.any? %>
      <ul class="divide-y divide-gray-100 text-sm">
        <% @events.each do |event| %>
          <li class="py-2">
            <span class="font-medium text-gray-900"><%= event.title %></span>
            <% if event.event_on %><span class="ml-2 text-xs text-gray-500"><%= event.event_on %></span><% end %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render "shared/empty_state", message: "이달의 책과 행사를 등록해 보세요.", icon: "📖" %>
    <% end %>
  </section>
</div>
