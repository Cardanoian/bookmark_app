<% content_for :title, "#{@mission.title} · 미션" %>
<% goal_label = { "approved_reports" => "승인 독후감", "game_plays" => "독서 게임" } %>

<div class="page-shell page-shell-content space-y-4">
  <%= render "shared/student_nav", active: :missions %>
  <%# 진입 경로(미션 목록 → 상세)의 한 단계 위로 돌아간다. 미션 목록은 학생 전용이라
      교직원 뷰어(MissionPolicy#show? 로 열람 가능)에겐 홈으로 되돌린다. %>
  <% back_path, back_label = current_user.student? ? [ missions_path, "미션 목록" ] : [ root_path, "홈" ] %>
  <header>
    <%= link_to icon_text(:arrow_left, back_label), back_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>
  </header>

  <div class="card-feature space-y-3">
    <div class="flex items-start justify-between gap-2">
      <h1 class="text-2xl font-bold text-ink"><%= @mission.title %></h1>
      <span class="badge badge-info">우리 반 미션</span>
    </div>
    <% if @mission.description.present? %>
      <p class="text-sm text-steel"><%= @mission.description %></p>
    <% end %>
    <% if @mission.start_date || @mission.end_date %>
      <p class="text-xs text-muted"><%= @mission.start_date %> ~ <%= @mission.end_date %></p>
    <% end %>
    <% if @mission.reward_points.to_i.positive? %>
      <p class="text-sm text-steel"><%= ui_icon :gift, class_name: "h-4 w-4" %> 모든 목표 달성 시 <span class="font-semibold text-ink"><%= @mission.reward_points %>P + <%= @mission.reward_points %>XP</span></p>
    <% end %>
  </div>

  <%# 학생 본인 진행률. 교직원 렌더 시 @progress 는 nil 이라 이 섹션을 건너뛴다(nil 가드). %>
  <% if @progress %>
    <section class="card space-y-3">
      <h2 class="flex items-center gap-1.5 text-base font-bold text-ink"><%= ui_icon :target %> 미션 진행상황</h2>
      <% @progress[:goals].each do |g| %>
        <div>
          <div class="flex justify-between text-sm">
            <span class="text-steel"><%= goal_label[g[:type]] %> <%= g[:target] %>편</span>
            <span class="inline-flex items-center gap-1 <%= g[:met] ? "font-semibold text-green-700" : "text-ink" %>"><%= g[:current] %>/<%= g[:target] %><%= ui_icon(:check, class_name: "h-4 w-4") if g[:met] %></span>
          </div>
          <div class="progress-bar mt-1"><div class="progress-bar__fill" style="width: <%= g[:target].positive? ? [ 100 * g[:current] / g[:target], 100 ].min : 0 %>%"></div></div>
        </div>
      <% end %>
      <% if @participation&.rewarded_at? %>
        <p class="text-sm font-semibold text-green-700"><%= ui_icon :celebrate, class_name: "h-4 w-4" %> 미션 완료! <%= @participation.reward_points_awarded %>P + <%= @participation.reward_points_awarded %>XP 받았어요</p>
      <% elsif @progress[:completed] %>
        <p class="text-sm font-semibold text-green-700"><%= ui_icon :celebrate, class_name: "h-4 w-4" %> 모든 목표를 달성했어요!</p>
      <% end %>
    </section>
  <% end %>

  <%= render "shared/activity_book_list", books: @mission.mission_goals.flat_map(&:books).uniq %>
</div>
