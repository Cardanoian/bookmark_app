<% content_for :title, "#{@mission.title} · 미션" %>

<div class="w-full max-w-2xl mx-auto">
  <header class="mb-4">
    <%= link_to "← 미션 목록", missions_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </header>

  <div class="rounded-2xl border border-gray-200 p-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= @mission.title %></h1>
    <% if @mission.book %>
      <p class="mt-1 text-sm text-gray-500">도서: <%= @mission.book.title %></p>
    <% end %>
    <% if @mission.start_date || @mission.end_date %>
      <p class="mt-1 text-xs text-gray-400"><%= @mission.start_date %> ~ <%= @mission.end_date %></p>
    <% end %>

    <% if current_user.student? %>
      <div class="mt-6">
        <%= button_to "이 미션에 참여하고 독후감 쓰기", join_mission_path(@mission), method: :post,
              class: "rounded-lg bg-amber-500 px-4 py-2 text-sm font-medium text-white" %>
      </div>
    <% end %>
  </div>
</div>
