<% content_for :title, "#{@mission.title} · 미션" %>

<div class="page-shell page-shell-content space-y-4">
  <header>
    <%= link_to "← 미션 목록", missions_path, class: "text-sm text-steel hover:text-ink" %>
  </header>

  <div class="card-feature">
    <h1 class="text-2xl font-bold text-ink"><%= @mission.title %></h1>
    <% if @mission.book %>
      <p class="mt-1 text-sm text-steel">도서: <%= @mission.book.title %></p>
    <% end %>
    <% if @mission.start_date || @mission.end_date %>
      <p class="mt-1 text-xs text-muted"><%= @mission.start_date %> ~ <%= @mission.end_date %></p>
    <% end %>

    <% if current_user.student? %>
      <div class="mt-6">
        <%= button_to "이 미션에 참여하고 독후감 쓰기", join_mission_path(@mission), method: :post, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
