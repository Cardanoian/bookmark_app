<% content_for :title, "미션 · 책갈피" %>

<div class="w-full max-w-2xl mx-auto">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">학급 미션</h1>
  </header>

  <%= render "shared/student_nav", active: :missions %>

  <% if @missions.any? %>
    <div class="space-y-3">
      <% @missions.each do |mission| %>
        <div class="rounded-xl border border-gray-200 p-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-gray-900"><%= mission.title %></p>
              <% if mission.book %>
                <p class="text-xs text-gray-500"><%= mission.book.title %></p>
              <% end %>
            </div>
            <div class="flex gap-2">
              <%= link_to "상세", mission_path(mission), class: "rounded-lg border border-gray-300 px-3 py-2 text-xs font-medium text-gray-700" %>
              <% if current_user.student? %>
                <%= button_to "참여하기", join_mission_path(mission), method: :post,
                      class: "rounded-lg bg-amber-500 px-3 py-2 text-xs font-medium text-white" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "진행 중인 미션이 없어요.", icon: "🎯" %>
  <% end %>
</div>
