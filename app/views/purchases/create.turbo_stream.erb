<%= turbo_stream.update "points_balance", @balance %>

<%= turbo_stream.replace dom_id(@item, :shop) do %>
  <%= render "shops/shop_item", item: @item, purchase: @purchase %>
<% end %>

<%= turbo_stream.update "shop_flash" do %>
  <p class="state-banner <%= @ok ? "state-banner--success" : "state-banner--error" %>">
    <%= @message %>
  </p>
<% end %>
