<%# locals: (monster:, user:, celebrate: false, user_monster: nil) %>
<%# user_monster 은 Turbo 브로드캐스트가 자동 주입하는 로컬(사용하지 않음). %>
<div id="active_monster" class="rounded-2xl border border-amber-100 bg-amber-50 p-5">
  <% if monster %>
    <div class="flex items-center gap-4"
         data-controller="monster-care"
         data-monster-care-celebrate-value="<%= celebrate %>">
      <span class="text-5xl" aria-hidden="true" data-monster-care-target="sprite">
        <%= monster_emoji(monster.species) %>
      </span>
      <div>
        <p class="text-xs font-medium text-amber-600">대표 몬스터</p>
        <p class="text-lg font-bold text-gray-900"><%= monster.species.name %></p>
        <p class="text-xs text-gray-500">
          <%= monster.species.stage %>단계 · <%= element_label(monster.species.element) %>
        </p>
      </div>
    </div>
  <% else %>
    <p class="text-sm text-gray-500">아직 대표 몬스터가 없어요. 스타터를 골라 볼까요?</p>
  <% end %>
</div>
