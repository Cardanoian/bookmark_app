<% content_for :title, "#{@current_species.name} · 몬스터 도감" %>

<div class="page-shell page-shell-content space-y-6">
  <%= turbo_stream_from current_user, :active_monster %>

  <header>
    <%= link_to icon_text(:arrow_left, "도감으로"), monsters_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>
  </header>

  <% if flash[:notice] %>
    <div class="state-banner state-banner--success"><%= flash[:notice] %></div>
  <% elsif flash[:alert] %>
    <div class="state-banner state-banner--error"><%= flash[:alert] %></div>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2 lg:items-start">
    <%= render "monsters/detail",
          user_monster: @user_monster, current_species: @current_species, line: @line,
          stats: @stats, evolvable: @evolvable, dex_no: @dex_no,
          awaiting_review_count: @awaiting_review_count,
          celebrate: flash[:celebrate].present? %>

    <div class="card">
      <p class="mb-2 text-center text-xs font-medium text-steel">진화 로드맵</p>
      <%= render "monsters/evolution_roadmap", line: @line, current: @user_monster %>
    </div>
  </div>

  <% if @story %>
    <%= render "monsters/story", story: @story, line: @line, reached_stage: @reached_stage,
          owned: @user_monster.present?, current_species: @current_species %>
  <% end %>

  <% if @completion_finale %>
    <%= render "monsters/completion_finale", finale: @completion_finale %>
  <% end %>
</div>
