<%# locals: (line:, owned:, evolvable: false) %>
<% species = owned&.monster_species || line %>
<%= link_to monster_path(line.dex_no),
      class: [
        "card relative block p-4 text-center transition",
        owned ? "hover:border-brand-yellow" : "border-2 border-dashed border-hairline-strong bg-surface-soft"
      ].join(" "),
      data: { dex_target: "card", element: line.element } do %>
  <% if evolvable %>
    <span class="badge badge-yellow absolute right-2 top-2 px-1.5 py-0.5 text-[10px] font-bold">진화 가능</span>
  <% end %>
  <div class="flex h-12 items-center justify-center text-4xl" aria-hidden="true">
    <%= owned ? monster_sprite(species, img_class: "h-12 w-12 object-contain") : "🔒" %>
  </div>
  <p class="mt-2 text-xs text-muted">No.<%= format("%02d", line.dex_no) %></p>
  <p class="text-sm font-semibold text-ink">
    <%= owned ? species.name : "???" %>
    <% unless owned %><span class="sr-only"> · 잠김</span><% end %>
  </p>
  <span class="mt-1 inline-block rounded-full px-2 py-0.5 text-[10px] font-medium <%= element_badge_classes(line.element) %>">
    <%= element_label(line.element) %>
  </span>
<% end %>
