<%# locals: (line:, owned:, evolvable: false, stats: nil) %>
<% species = owned&.monster_species || line %>
<%= link_to monster_path(line.dex_no),
      class: [
        "card relative mx-auto flex w-full max-w-[16rem] items-start justify-evenly gap-3 p-2 transition lg:max-w-[20rem]",
        owned ? "hover:border-brand-yellow" : "border-2 border-dashed border-hairline-strong bg-surface-soft"
      ].join(" "),
      data: { dex_target: "card", element: line.element } do %>
  <% if evolvable %>
    <span class="badge badge-yellow absolute left-1.5 top-1.5 px-1.5 py-0.5 text-[10px] font-bold opacity-70">진화 가능</span>
  <% end %>
  <%# 좌측 열: 소유=큰 몬스터 이미지(모바일 64 / 태블릿·PC 96px) / 미소유=자물쇠(48px) + 그 아래 해금 조건. %>
  <div class="flex w-16 shrink-0 flex-col items-center gap-2 self-center sm:w-24 lg:w-32">
    <% if owned %>
      <div class="flex h-16 w-16 items-center justify-center text-4xl sm:h-24 sm:w-24 sm:text-7xl lg:h-32 lg:w-32 lg:text-8xl" aria-hidden="true">
        <%= monster_sprite(species, img_class: "h-16 w-16 object-contain sm:h-24 sm:w-24 lg:h-32 lg:w-32") %>
      </div>
    <% else %>
      <div class="flex h-12 w-12 items-center justify-center"><%= ui_icon :lock, class_name: "h-10 w-10" %></div>
      <% if stats && line.unlock_condition.present? %>
        <ul class="w-full space-y-0.5 border-t border-hairline pt-2 text-left">
          <% unlock_progress_items(stats, line.unlock_condition).each do |item| %>
            <li class="flex items-center justify-between gap-1 text-[10px] leading-tight">
              <span class="truncate text-muted"><%= item[:label] %></span>
              <span class="shrink-0 <%= item[:met] ? "font-semibold text-success-accent" : "text-steel" %>">
                <span class="inline-flex items-center gap-1"><%= item[:current] %>/<%= item[:target] %><%= ui_icon(:check, class_name: "h-4 w-4") if item[:met] %></span>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
  <%# 우측 열: 번호·이름·속성. 카드(이미지) 높이 대비 세로 중앙 정렬 + 상하 마진. %>
  <div class="flex min-w-0 flex-col gap-1 self-center my-2">
    <p class="text-xs text-muted">No.<%= format("%02d", line.dex_no) %></p>
    <p class="text-sm font-semibold text-ink">
      <%= owned ? species.name : "???" %>
      <% unless owned %><span class="sr-only"> · 잠김</span><% end %>
    </p>
    <span class="inline-block w-fit rounded-full px-2 py-0.5 text-[10px] font-medium <%= element_badge_classes(line.element) %>">
      <%= element_label(line.element) %>
    </span>
  </div>
<% end %>
