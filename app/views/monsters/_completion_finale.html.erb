<%# locals: (finale:) %>
<section class="card border-brand-yellow bg-surface-soft" aria-labelledby="dex-completion-finale-heading">
  <div class="mb-3 flex items-center gap-2">
    <%= ui_icon :sparkle, class_name: "h-5 w-5 text-yellow-dark" %>
    <p class="text-sm font-medium text-yellow-dark">도감 완성 이야기</p>
  </div>
  <h2 id="dex-completion-finale-heading" class="text-lg font-bold text-ink"><%= finale.heading %></h2>
  <div class="mt-3 space-y-3 text-sm leading-relaxed text-slate">
    <% finale.paragraphs.each do |paragraph| %>
      <p><%= paragraph %></p>
    <% end %>
  </div>
</section>
