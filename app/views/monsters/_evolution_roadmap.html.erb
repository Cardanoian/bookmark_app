<%# locals: (line:, current: nil) %>
<%# 3단계 진화 로드맵. current(UserMonster/Species) 이하 단계만 공개. %>
<% current_stage = current.respond_to?(:species) ? current.species&.stage : current&.stage %>
<% reached_flags = line.map { |species| current_stage.present? && species.stage <= current_stage } %>
<div class="flex items-center justify-center gap-1">
  <% line.each_with_index do |species, index| %>
    <% reached = reached_flags[index] %>
    <div class="flex flex-col items-center gap-1 <%= "opacity-40" unless reached %>">
      <span class="flex h-6 w-6 items-center justify-center rounded-full text-[11px] font-bold <%= reached ? "bg-primary text-on-primary" : "border-2 border-dashed border-hairline-strong text-muted" %>">
        <%= index + 1 %>
      </span>
      <div><%= reached ? monster_sprite(species, img_class: "h-10 w-10 object-contain") : ui_icon(:lock, class_name: "h-10 w-10") %></div>
      <p class="text-xs font-medium text-ink"><%= reached ? species.name : "???" %></p>
      <p class="text-[10px] text-muted"><%= species.stage %>단계</p>
    </div>
    <% unless index == line.size - 1 %>
      <div class="progress-bar mx-1 w-6 sm:w-10" aria-hidden="true">
        <div class="progress-bar__fill" style="width: <%= reached_flags[index + 1] ? 100 : 0 %>%"></div>
      </div>
    <% end %>
  <% end %>
</div>
