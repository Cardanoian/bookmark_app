<%# 내가 쓴 책 소개 카드 1장 — 이 책의 내 기록과 내 서재 '책 소개 대결' 필터가 함께 쓴다.
    show_book 이면 책 제목(→ 이 책의 내 기록)을 머리에 단다. %>
<%# locals: (intro:, show_book: false) %>
<article class="card" data-writing="intro">
  <% if show_book %>
    <%= link_to "『#{intro.book.title}』", library_book_path(intro.book), class: "mb-2 block truncate font-semibold text-ink hover:underline" %>
  <% end %>
  <p class="whitespace-pre-line wrap-break-word text-sm text-ink"><%= intro.body %></p>
  <p class="mt-2 flex flex-wrap items-center gap-3 text-xs text-steel">
    <span><%= intro.created_at.strftime("%Y.%m.%d") %></span>
    <span class="text-brand-blue"><%= ui_icon :like, class_name: "h-3.5 w-3.5" %> 받은 표 <%= intro.votes_count %></span>
  </p>
</article>
