<%# 응원 버튼 + 카운트(P5.3). cheers create/destroy Turbo Stream 대상. local: board_post %>
<% cheer = current_user && board_post.cheers.find_by(user_id: current_user.id) %>
<div id="<%= dom_id(board_post, :cheer) %>" class="flex items-center gap-3">
  <% if cheer %>
    <%= button_to "👏 응원 취소", board_post_cheer_path(board_post, cheer), method: :delete,
          class: "rounded-full bg-amber-100 px-4 py-1.5 text-sm font-medium text-amber-800" %>
  <% else %>
    <%= button_to "👏 응원하기", board_post_cheers_path(board_post), method: :post,
          class: "rounded-full bg-amber-400 px-4 py-1.5 text-sm font-medium text-white" %>
  <% end %>
  <span class="text-sm font-semibold text-gray-600"><%= board_post.report.cheers_count %>명이 응원했어요</span>
</div>
