<%# 우수작 카드(P5.3). local: board_post %>
<% report = board_post.report %>
<article id="<%= dom_id(board_post) %>" class="rounded-xl border border-gray-200 p-4">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <%= link_to (report.book&.title.presence || report.book_title), board_post_path(board_post),
            class: "font-semibold text-gray-900 hover:underline" %>
      <p class="mt-1 text-xs text-gray-500"><%= report.user.name %></p>
      <p class="mt-2 line-clamp-2 text-sm text-gray-600"><%= truncate(report.body.to_s, length: 80) %></p>
    </div>
    <span class="shrink-0 text-sm font-semibold text-amber-600">👏 <%= report.cheers_count %></span>
  </div>
</article>
