<% content_for :title, "우수작 · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header>
    <%= link_to icon_text(:arrow_left, "우수작 게시판"), board_posts_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>
  </header>

  <div class="grid gap-6 lg:grid-cols-3 lg:items-start">
    <article class="card space-y-4 lg:col-span-2">
      <div>
        <h1 class="page-title"><%= @report.book&.title.presence || @report.book_title %></h1>
        <p class="page-subtitle"><%= ui_icon :writing, class_name: "h-4 w-4" %> <%= @report.user.name %></p>
      </div>
      <p class="whitespace-pre-wrap leading-relaxed text-slate"><%= @report.body %></p>
    </article>

    <div class="space-y-6">
      <section class="card space-y-3">
        <h2 class="text-sm font-semibold text-steel">응원하기</h2>
        <%= render "board_posts/cheer_button", board_post: @board_post %>
      </section>

      <section class="card space-y-3">
        <h2 class="text-sm font-semibold text-steel">문장 스티커</h2>
        <div id="<%= dom_id(@report, :stickers) %>" class="flex flex-wrap gap-2">
          <%= render partial: "board_posts/sticker", collection: @stickers, as: :sticker %>
        </div>

        <% if policy(Sticker.new).create? %>
          <%= form_with model: @sticker, url: board_post_stickers_path(@board_post), method: :post,
                class: "flex flex-wrap items-center gap-2 border-t border-hairline-soft pt-3" do |f| %>
            <%= f.hidden_field :position, value: 0 %>
            <div class="flex items-center gap-1" role="radiogroup" aria-label="스티커 반응">
              <% sticker_reactions.each do |value, icon, label| %>
                <label class="cursor-pointer">
                  <%= f.radio_button :emoji, value, checked: ((@sticker.emoji.presence || sticker_reactions.first.first) == value), class: "peer sr-only" %>
                  <span class="flex h-10 w-10 items-center justify-center rounded-full border border-hairline bg-canvas transition peer-checked:border-primary peer-checked:bg-yellow-light" title="<%= label %>">
                    <%= ui_icon icon, class_name: "h-5 w-5" %><span class="sr-only"><%= label %></span>
                  </span>
                </label>
              <% end %>
            </div>
            <%= f.text_field :label, placeholder: "한마디 (선택)", class: "form-input w-auto flex-1" %>
            <%= f.submit "붙이기", class: "btn btn-yellow btn-sm" %>
          <% end %>
        <% end %>
      </section>
    </div>
  </div>
</div>
