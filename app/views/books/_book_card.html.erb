<%# 도서 카드(P5.2). local: book %>
<article class="flex gap-3 rounded-xl border border-gray-200 p-3">
  <div class="h-24 w-16 shrink-0 overflow-hidden rounded-md bg-gray-100">
    <% if book.cover_url.present? %>
      <%= image_tag book.cover_url, alt: book.title, class: "h-full w-full object-cover", loading: "lazy" %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-2xl">📖</div>
    <% end %>
  </div>
  <div class="min-w-0">
    <%= link_to book.title, book_path(book),
          class: "line-clamp-2 font-semibold text-gray-900 hover:underline" %>
    <p class="mt-1 text-xs text-gray-500"><%= [ book.author, book.publisher ].compact_blank.join(" · ") %></p>
    <% if book.grade_band.present? %>
      <span class="mt-2 inline-block rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-700"><%= book.grade_band %></span>
    <% end %>
  </div>
</article>
