<% content_for :title, "#{@book.title} · 책갈피" %>

<div class="mx-auto w-full max-w-2xl space-y-6">
  <header class="flex gap-4">
    <div class="h-40 w-28 shrink-0 overflow-hidden rounded-lg bg-gray-100">
      <% if @book.cover_url.present? %>
        <%= image_tag @book.cover_url, alt: @book.title, class: "h-full w-full object-cover" %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-4xl">📖</div>
      <% end %>
    </div>
    <div class="min-w-0">
      <h1 class="text-2xl font-bold text-gray-900"><%= @book.title %></h1>
      <p class="mt-1 text-sm text-gray-500"><%= [ @book.author, @book.publisher ].compact_blank.join(" · ") %></p>
      <% if @book.grade_band.present? %>
        <span class="mt-2 inline-block rounded-full bg-amber-100 px-2 py-0.5 text-xs text-amber-700"><%= @book.grade_band %></span>
      <% end %>
      <%= book_meta_badges(@book, size: :md, wrapper_class: "mt-2") %>
    </div>
  </header>

  <% if @book.summary.present? %>
    <section class="rounded-lg border border-gray-200 p-4">
      <h2 class="mb-2 text-sm font-semibold text-gray-500">책 소개</h2>
      <p class="whitespace-pre-wrap text-sm text-gray-800"><%= @book.summary %></p>
    </section>
  <% end %>

  <% if @reports.any? %>
    <section>
      <h2 class="mb-2 text-sm font-semibold text-gray-500">이 책의 공유된 독후감</h2>
      <ul class="space-y-1 text-sm">
        <% @reports.each do |report| %>
          <li><span class="text-gray-800"><%= report.user.name %></span></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%= link_to "목록으로", books_path, class: "text-sm text-gray-500" %>
</div>
