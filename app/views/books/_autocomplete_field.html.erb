<%#
  공용 도서 자동완성 필드(book-search 컨트롤러와 짝). 독후감·게임 등 여러 폼이 재사용한다.

  locals:
    form          — 폼 빌더(필수). hidden book_id·(있으면) 표시 텍스트 필드를 이 폼에 그린다.
    book_id_field — 선택한 Book PK 를 담을 hidden 필드 심볼(필수).
    url           — 자동완성(타이핑) 조회 엔드포인트(필수). 예: autocomplete_books_path / books_search_path.
    title_field   — 표시 텍스트를 매핑할 폼 필드 심볼(선택, 기본 nil). nil 이면 name 없는 순수
                    검색 입력만 두고 값은 book_id(+book:selected 이벤트)로만 전달한다.
    mode          — "fallback"(미선택 자유텍스트 허용) | "strict"(목록 선택만 유효). 기본 fallback.
    show_cover    — 선택 도서 표지 미리보기 노출 여부(선택, 기본 false).
    selected_book — 프리필용 Book(선택, 기본 nil). 있으면 input=title·hidden=id·표지=cover_url.

  opt-in locals(모두 기본 off/nil — 미전달 시 마크업·동작이 기존과 동일):
    remote_search_url  — 원격(네이버) 검색 버튼용 엔드포인트(선택, 기본 nil). 있으면 루트에
                         data-book-search-remote-search-url-value 를 출력해 manualSearch 를 켠다.
    isbn_field         — 원격 선택 isbn 을 스태시할 hidden 필드 심볼(선택, 기본 nil). 있으면
                         book_search "isbn" 타깃 hidden 을 그린다(등록은 제출 시 서버가 수행).
    isbn_value         — isbn_field hidden 의 프리필 값(선택, 기본 nil). 스텝/재렌더 라운드트립용.
                         항상 value 로 넘겨 form.hidden_field 가 모델 메서드를 호출하지 않게 한다.
    title_value        — selected_book 이 없을 때 제목 input 의 fallback 프리필 값(선택, 기본 nil).
                         비모델바인딩 폼(scope 전용)에서 원격 선택 책 제목을 채우는 용도. selected_book
                         이 있으면 그 title 이 우선한다. 미전달·nil 이면 값 미설정(모델바인딩 기존 동작 보존).
    show_search_button — 입력 옆 원격 검색 버튼 노출 여부(선택, 기본 false).
%>
<%
  title_field        = local_assigns.fetch(:title_field, nil)
  mode               = local_assigns.fetch(:mode, "fallback")
  show_cover         = local_assigns.fetch(:show_cover, false)
  selected_book      = local_assigns.fetch(:selected_book, nil)
  remote_search_url  = local_assigns.fetch(:remote_search_url, nil)
  isbn_field         = local_assigns.fetch(:isbn_field, nil)
  isbn_value         = local_assigns.fetch(:isbn_value, nil)
  title_value        = local_assigns.fetch(:title_value, nil)
  show_search_button = local_assigns.fetch(:show_search_button, false)
  block_enter_submit = local_assigns.fetch(:block_enter_submit, false)
  # 바깥 컨트롤러가 이 input 을 자기 타깃으로도 잡게 하는 opt-in. 키·값을 그대로 data 에 병합하므로
  # 호출부가 `{ book_chooser_target: "input" }` 처럼 Rails data 관용구로 넘긴다(미전달이면 무변경).
  extra_input_data = local_assigns.fetch(:extra_input_data, {})

  input_class = "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm"
  input_actions = [ "input->book-search#search" ]
  # 엔터를 폼 제출이 아니라 검색으로 돌린다. **opt-in 인 이유**: 이 파셜을 쓰는 6개 화면 중
  # 엔터가 실제로 문제인 곳은 책 고르기 스텝 하나뿐이다. 나머지는 엔터가 "독후감 제출"·"저장"
  # 같은 정상 동선이거나(fallback 3곳), `title_field: nil` 이라 입력값이 애초에 서버로 가지
  # 않는다(strict 3곳 — 거기서 엔터는 고른 책으로 진행하는 정상 키보드 동선이다).
  input_actions << "keydown.enter->book-search#submitSearch" if block_enter_submit
  input_data  = { book_search_target: "input", action: input_actions.join(" ") }.merge(extra_input_data)
  hidden_data = { book_search_target: "bookId" }
%>

<div data-controller="book-search"
     data-book-search-url-value="<%= url %>"
     data-book-search-mode-value="<%= mode %>"
<% if remote_search_url %>
     data-book-search-remote-search-url-value="<%= remote_search_url %>"
<% end %>
     class="relative">

  <% if show_cover %>
    <%= tag.img(
          src: selected_book&.cover_url.presence,
          alt: "표지 미리보기",
          data: { book_search_target: "cover" },
          class: "mb-2 h-24 w-auto rounded border border-gray-200 #{'hidden' if selected_book&.cover_url.blank?}") %>
  <% end %>

<% if show_search_button %>
  <div class="flex items-start gap-2">
<% end %>
  <% if title_field %>
    <%
      opts = { placeholder: "책 제목을 입력해 검색하세요", autocomplete: "off",
               data: input_data, class: input_class }
      if selected_book
        opts[:value] = selected_book.title
      elsif title_value.present?
        opts[:value] = title_value
      end
    %>
    <%= form.text_field title_field, opts %>
  <% else %>
    <%= text_field_tag :book_query, (selected_book&.title || title_value),
          name: nil,
          placeholder: "책 제목을 입력해 검색하세요",
          autocomplete: "off",
          data: input_data, class: input_class %>
  <% end %>
<% if show_search_button %>
    <%= tag.button(icon_text(:search, "검색"),
          type: "button",
          data: { action: "book-search#manualSearch", book_search_target: "searchButton" },
          class: "shrink-0 rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100") %>
  </div>
<% end %>

  <%
    hidden_opts = { data: hidden_data }
    hidden_opts[:value] = selected_book.id if selected_book
  %>
  <%= form.hidden_field book_id_field, hidden_opts %>
<% if isbn_field %>
  <%= form.hidden_field isbn_field, data: { book_search_target: "isbn" }, value: isbn_value %>
<% end %>

  <ul data-book-search-target="results"
      class="absolute z-10 mt-1 hidden w-full overflow-hidden rounded-lg border border-gray-200 bg-white shadow"></ul>
</div>
