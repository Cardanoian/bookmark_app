<%#
  목표별 '여러 책' 지정 바스켓 필드(book-basket + 중첩 book-search). 미션·챌린지 목표 폼 공용.
  타이핑=로컬 자동완성, 검색 버튼=원격(네이버) 검색. 고른 책은 칩으로 누적되며 로컬은 [ids][],
  원격은 [isbns][] hidden 배열로 제출된다(서버 GoalBooks 가 등록·중복 제거). 비우면 아무 책이나 인정.

  locals:
    ids_name         — 로컬 선택 book_id hidden 배열 name(예: "mission[goal_books][approved_reports][ids][]")
    isbns_name       — 원격 선택 isbn hidden 배열 name
    autocomplete_url — 타이핑 로컬 자동완성 엔드포인트(예: autocomplete_books_path)
    remote_search_url— 원격 검색 엔드포인트(예: remote_search_books_path)
    selected_books   — 프리필 도서 배열(편집 시 기존 지정, 기본 [])
%>
<% selected_books = local_assigns.fetch(:selected_books, []) %>
<div data-controller="book-basket"
     data-book-basket-ids-name-value="<%= ids_name %>"
     data-book-basket-isbns-name-value="<%= isbns_name %>">
  <div data-controller="book-search"
       data-book-search-url-value="<%= autocomplete_url %>"
       data-book-search-remote-search-url-value="<%= remote_search_url %>"
       data-book-search-mode-value="strict"
       data-action="book:selected->book-basket#add"
       class="relative">
    <div class="flex items-start gap-2">
      <%= text_field_tag :book_query, nil, name: nil,
            placeholder: "책 제목으로 검색해 추가하세요",
            autocomplete: "off",
            data: { book_search_target: "input", action: "input->book-search#search" },
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
      <%= tag.button(icon_text(:search, "검색"), type: "button",
            data: { action: "book-search#manualSearch", book_search_target: "searchButton" },
            class: "shrink-0 rounded-lg border border-gray-300 bg-gray-50 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100") %>
    </div>
    <ul data-book-search-target="results"
        class="absolute z-10 mt-1 hidden w-full overflow-hidden rounded-lg border border-gray-200 bg-white shadow"></ul>
  </div>

  <div data-book-basket-target="chips" class="mt-2 flex flex-wrap gap-2">
    <% selected_books.each do |book| %>
      <span class="badge badge-neutral inline-flex items-center gap-1" data-key="id:<%= book.id %>">
        <span><%= book.title %></span>
        <%= hidden_field_tag ids_name, book.id, id: nil %>
        <button type="button" data-action="book-basket#remove" aria-label="제거" class="text-steel hover:text-ink"><%= ui_icon :close, class_name: "h-4 w-4" %></button>
      </span>
    <% end %>
  </div>
</div>
