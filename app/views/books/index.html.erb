<% content_for :title, "도서 카탈로그 · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header>
    <h1 class="text-2xl font-bold text-gray-900">도서 카탈로그</h1>
    <p class="mt-1 text-sm text-gray-500">권장도서·고전을 둘러보고 검색해 보세요.</p>
  </header>

  <div data-controller="book-search" class="relative">
    <%= search_field_tag :q, nil,
          placeholder: "책 제목으로 검색",
          autocomplete: "off",
          data: { book_search_target: "input", action: "input->book-search#search" },
          class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm" %>
    <ul data-book-search-target="results"
        class="absolute z-10 mt-1 hidden w-full overflow-hidden rounded-lg border border-gray-200 bg-white shadow"></ul>
  </div>

  <% filters = [ [ "전체", nil ], [ "권장도서", "recommended" ], [ "고전", "classic" ] ] %>
  <nav class="flex flex-wrap gap-2">
    <% filters.each do |label, value| %>
      <%= link_to label, books_path(category: value),
            class: "rounded-full px-3 py-1 text-sm #{@category == value ? "bg-gray-900 text-white" : "bg-gray-100 text-gray-600"}" %>
    <% end %>
  </nav>

  <% if @books.any? %>
    <div class="grid gap-3 sm:grid-cols-2">
      <%= render partial: "books/book_card", collection: @books, as: :book %>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "해당하는 도서가 없어요.", icon: :books %>
  <% end %>

  <% if @has_next_page || @page > 1 %>
    <nav class="mt-2 flex items-center justify-between text-sm">
      <% if @page > 1 %>
        <%= link_to icon_text(:arrow_left, "이전"), books_path(category: @category, page: @page - 1), class: "btn btn-secondary btn-sm" %>
      <% else %>
        <span></span>
      <% end %>
      <% if @has_next_page %>
        <%= link_to text_icon("다음", :arrow_right), books_path(category: @category, page: @page + 1), class: "btn btn-secondary btn-sm" %>
      <% else %>
        <span></span>
      <% end %>
    </nav>
  <% end %>
</div>
