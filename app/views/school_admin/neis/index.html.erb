<% content_for :title, "NEIS 생기부 요약 · 책갈피" %>

<div class="w-full max-w-3xl mx-auto space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-teal-600">교무관리자 · NEIS 생기부 자동요약</p>
      <h1 class="text-2xl font-bold text-gray-900"><%= @school&.name %></h1>
    </div>
    <%= link_to "전교 통계", school_admin_stats_path,
          class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700" %>
  </header>

  <%= form_with url: school_admin_neis_path, method: :get,
        class: "flex items-end gap-3 rounded-lg border border-gray-200 p-4" do |f| %>
    <div class="flex-1">
      <%= f.label :student_id, "학생 선택", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.collection_select :student_id, @students, :id, :name,
            { include_blank: "학생을 선택하세요", selected: @student&.id },
            class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <%= f.submit "요약 생성", class: "rounded-lg bg-teal-600 px-4 py-2 text-sm font-medium text-white" %>
  <% end %>

  <% if @student %>
    <section class="rounded-lg border border-gray-200 p-5"
             data-controller="clipboard">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-lg font-semibold text-gray-900"><%= @student.name %> · 독서활동상황</h2>
        <button type="button"
                class="rounded-lg border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700"
                data-action="clipboard#copy" data-clipboard-target="button">복사</button>
      </div>
      <textarea readonly rows="6" data-clipboard-target="source"
                class="w-full resize-none rounded-lg border border-gray-200 bg-gray-50 p-3 text-sm text-gray-800"><%= @summary %></textarea>
      <p class="mt-2 text-xs text-gray-500">※ 오프라인 템플릿 요약입니다. 검토 후 NEIS에 붙여넣어 사용하세요.</p>
    </section>
  <% else %>
    <%= render "shared/empty_state", message: "학생을 선택하면 생기부 요약을 생성합니다.", icon: "📝" %>
  <% end %>
</div>
