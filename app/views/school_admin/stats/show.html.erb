<% content_for :title, "전교 통계 · 책갈피" %>

<div class="w-full max-w-4xl mx-auto space-y-6">
  <header class="flex items-center justify-between">
    <div>
      <p class="text-sm font-medium text-teal-600">교무관리자 · 전교 통계</p>
      <h1 class="text-2xl font-bold text-gray-900"><%= @school&.name %></h1>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "NEIS 생기부 요약", school_admin_neis_path,
            class: "rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700" %>
      <%= button_to "로그아웃", session_path, method: :delete,
            class: "rounded-lg bg-gray-800 px-4 py-2 text-sm text-white" %>
    </div>
  </header>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500">전교 참여율</p>
      <p class="mt-1 text-2xl font-bold text-teal-600"><%= @participation %>%</p>
    </div>
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500">학생 수</p>
      <p class="mt-1 text-2xl font-bold text-gray-900"><%= @student_count %></p>
    </div>
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500">총 독후감</p>
      <p class="mt-1 text-2xl font-bold text-gray-900"><%= @reports.size %></p>
    </div>
    <div class="rounded-lg border border-gray-200 p-4">
      <p class="text-xs text-gray-500">학급 수</p>
      <p class="mt-1 text-2xl font-bold text-gray-900"><%= @classrooms.size %></p>
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-2">
    <div class="rounded-lg border border-gray-200 p-5">
      <h2 class="mb-3 text-lg font-semibold text-gray-900">전교 5축 평균</h2>
      <div class="flex justify-center">
        <%= radar_chart_svg(@axis_averages, labels: @axis_labels) %>
      </div>
      <dl class="mt-3 grid grid-cols-5 gap-1 text-center text-xs">
        <% @axis_averages.each do |axis, value| %>
          <div>
            <dt class="text-gray-500"><%= axis_label(axis) %></dt>
            <dd class="font-semibold text-teal-600"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="space-y-4">
      <% if @weakness %>
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4">
          <h2 class="text-sm font-semibold text-amber-800">전교 약점 진단</h2>
          <p class="mt-1 text-sm text-amber-900">
            가장 낮은 축은 <strong><%= @weakness[:label] %></strong>
            (<%= @weakness[:score] %>점, <%= @weakness[:standard] %>) 입니다.
          </p>
          <p class="mt-2 text-sm text-amber-900"><%= @weakness[:activity] %></p>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "아직 채점된 독후감이 없습니다.", icon: "📊" %>
      <% end %>
    </div>
  </div>

  <section class="rounded-lg border border-gray-200 p-5">
    <h2 class="mb-3 text-lg font-semibold text-gray-900">학년별 5축 평균</h2>
    <% if @grade_stats.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500">
              <th class="py-2 pr-3">학년</th>
              <th class="py-2 pr-3">독후감</th>
              <% @axis_labels.each do |label| %><th class="py-2 pr-3"><%= label %></th><% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @grade_stats.each do |stat| %>
              <tr>
                <td class="py-2 pr-3 font-medium text-gray-900"><%= stat[:grade] %>학년</td>
                <td class="py-2 pr-3 text-gray-700"><%= stat[:report_count] %></td>
                <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                  <td class="py-2 pr-3 text-gray-700"><%= stat[:axis_averages][axis] %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">표시할 학년 데이터가 없습니다.</p>
    <% end %>
  </section>

  <section class="rounded-lg border border-gray-200 p-5">
    <h2 class="mb-3 text-lg font-semibold text-gray-900">학급별 현황</h2>
    <% if @classroom_stats.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500">
              <th class="py-2 pr-3">학급</th>
              <th class="py-2 pr-3">참여율</th>
              <th class="py-2 pr-3">독후감</th>
              <% @axis_labels.each do |label| %><th class="py-2 pr-3"><%= label %></th><% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @classroom_stats.each do |stat| %>
              <tr>
                <td class="py-2 pr-3 font-medium text-gray-900"><%= stat[:classroom].label %></td>
                <td class="py-2 pr-3 text-gray-700"><%= stat[:participation] %>%</td>
                <td class="py-2 pr-3 text-gray-700"><%= stat[:report_count] %></td>
                <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                  <td class="py-2 pr-3 text-gray-700"><%= stat[:axis_averages][axis] %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">등록된 학급이 없습니다.</p>
    <% end %>
  </section>
</div>
