<% content_for :title, "전교 통계 · 책갈피" %>

<div class="page-shell page-shell-wide">
  <header class="page-header">
    <div>
      <p class="page-subtitle font-medium text-moss-dark">교무관리자 · 전교 통계</p>
      <h1 class="page-title"><%= @school&.name %></h1>
    </div>
    <div class="page-actions">
      <%= link_to "NEIS 생기부 요약", school_admin_neis_path, class: "btn btn-secondary" %>
    </div>
  </header>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="stat-card">
      <span class="stat-card__label">전교 참여율</span>
      <span class="stat-card__value text-moss-dark"><%= @participation %>%</span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">학생 수</span>
      <span class="stat-card__value"><%= @student_count %></span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">총 독후감</span>
      <span class="stat-card__value"><%= @reports.size %></span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">학급 수</span>
      <span class="stat-card__value"><%= @classrooms.size %></span>
    </div>
  </div>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="card">
      <h2 class="mb-3 text-lg font-semibold text-ink">전교 5축 평균</h2>
      <div class="flex justify-center">
        <%= radar_chart_svg(@axis_averages, labels: @axis_labels) %>
      </div>
      <dl class="mt-3 grid grid-cols-5 gap-1 text-center text-xs">
        <% @axis_averages.each do |axis, value| %>
          <div>
            <dt class="text-steel"><%= axis_label(axis) %></dt>
            <dd class="font-semibold text-moss-dark"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>

    <div class="space-y-4">
      <% if @weakness %>
        <div class="card border-hairline bg-surface-yellow">
          <h2 class="text-sm font-semibold text-yellow-dark">전교 약점 진단</h2>
          <p class="mt-1 text-sm text-yellow-dark">
            가장 낮은 축은 <strong><%= @weakness[:label] %></strong>
            (<%= @weakness[:score] %>점, <%= @weakness[:standard] %>) 입니다.
          </p>
          <p class="mt-2 text-sm text-yellow-dark"><%= @weakness[:activity] %></p>
        </div>
      <% else %>
        <%= render "shared/empty_state", message: "아직 채점된 독후감이 없습니다.", icon: :chart %>
      <% end %>
    </div>
  </div>

  <section class="card mt-6">
    <h2 class="mb-3 text-lg font-semibold text-ink">학년별 5축 평균</h2>
    <% if @grade_stats.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-steel">
              <th class="py-2 pr-3">학년</th>
              <th class="py-2 pr-3">독후감</th>
              <% @axis_labels.each do |label| %><th class="py-2 pr-3"><%= label %></th><% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline-soft">
            <% @grade_stats.each do |stat| %>
              <tr>
                <td class="py-2 pr-3 font-medium text-ink"><%= stat[:grade] %>학년</td>
                <td class="py-2 pr-3 text-slate"><%= stat[:report_count] %></td>
                <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                  <td class="py-2 pr-3 text-slate"><%= stat[:axis_averages][axis] %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-steel">표시할 학년 데이터가 없습니다.</p>
    <% end %>
  </section>

  <section class="card mt-6">
    <h2 class="mb-3 text-lg font-semibold text-ink">학급별 현황</h2>
    <% if @classroom_stats.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-steel">
              <th class="py-2 pr-3">학급</th>
              <th class="py-2 pr-3">참여율</th>
              <th class="py-2 pr-3">독후감</th>
              <% @axis_labels.each do |label| %><th class="py-2 pr-3"><%= label %></th><% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline-soft">
            <% @classroom_stats.each do |stat| %>
              <tr>
                <td class="py-2 pr-3 font-medium text-ink"><%= stat[:classroom].label %></td>
                <td class="py-2 pr-3 text-slate"><%= stat[:participation] %>%</td>
                <td class="py-2 pr-3 text-slate"><%= stat[:report_count] %></td>
                <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                  <td class="py-2 pr-3 text-slate"><%= stat[:axis_averages][axis] %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-steel">등록된 학급이 없습니다.</p>
    <% end %>
  </section>
</div>
