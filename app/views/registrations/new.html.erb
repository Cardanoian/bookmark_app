<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-6">회원가입</h1>

  <% if flash[:alert] %>
    <div class="mb-4 rounded bg-red-100 px-4 py-2 text-red-800"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: registrations_path, method: :post, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= label_tag :role, "역할", class: "block text-sm font-medium" %>
      <%= select_tag :role,
            options_for_select([ [ "학생", "student" ], [ "교사", "teacher" ] ]),
            class: "mt-1 block w-full rounded border-gray-300" %>
    </div>

    <div>
      <%= label_tag :school_id, "학교", class: "block text-sm font-medium" %>
      <%= select_tag :school_id,
            options_from_collection_for_select(@schools, :id, :name),
            include_blank: "학교를 선택하세요",
            class: "mt-1 block w-full rounded border-gray-300" %>
    </div>

    <div>
      <%= label_tag :classroom_id, "학급 (학생)", class: "block text-sm font-medium" %>
      <%= select_tag :classroom_id,
            options_from_collection_for_select(@classrooms, :id, :label),
            include_blank: "학급 없음",
            class: "mt-1 block w-full rounded border-gray-300" %>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <%= label_tag :grade, "학년 (교사 담임 학급)", class: "block text-sm font-medium" %>
        <%= number_field_tag :grade, nil, class: "mt-1 block w-full rounded border-gray-300" %>
      </div>
      <div>
        <%= label_tag :class_no, "반", class: "block text-sm font-medium" %>
        <%= number_field_tag :class_no, nil, class: "mt-1 block w-full rounded border-gray-300" %>
      </div>
    </div>

    <div>
      <%= label_tag :name, "이름", class: "block text-sm font-medium" %>
      <%= text_field_tag :name, nil, class: "mt-1 block w-full rounded border-gray-300" %>
    </div>

    <div>
      <%= label_tag :password, "비밀번호", class: "block text-sm font-medium" %>
      <%= password_field_tag :password, nil, class: "mt-1 block w-full rounded border-gray-300" %>
    </div>

    <%= submit_tag "가입하기", class: "w-full rounded bg-blue-600 px-4 py-2 text-white" %>
  <% end %>

  <p class="mt-4 text-sm text-center">
    <%= link_to "로그인으로 돌아가기", new_session_path, class: "text-blue-600 underline" %>
  </p>
</div>
