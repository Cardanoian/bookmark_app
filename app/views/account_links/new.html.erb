<%# 계정 연동 폼(account_linking_seasons_plan §Phase 3). 작년 학교·학급·이름·비번을 증명해 두 계정을
    병합한다. 학교 피커는 로그인 폼과 같은 하이브리드(schools/_picker, with_classroom)이며 학년도 기본은
    지난 학년도(current-1)로 둔다. post → preview(인증·미리보기). %>
<div class="page-shell page-shell-form space-y-6">
  <header>
    <p class="text-sm font-medium text-steel">마이페이지 · 계정 연동</p>
    <h1 class="page-title mt-1 flex items-center gap-2"><%= ui_icon :link, class_name: "h-7 w-7" %> 작년 계정 이어받기</h1>
    <p class="page-subtitle">학년이 바뀌었나요? 작년에 쓰던 계정 정보를 확인하면 그동안의 독후감·몬스터·포인트를 지금 계정으로 가져올 수 있어요.</p>
  </header>

  <div class="card">
    <%# flash 오류는 공통 상단 토스트(shared/_flash)가 담당 — 여기서 중복 렌더하지 않음. %>
    <%= form_with url: preview_account_link_path, method: :post, local: true, class: "space-y-4" do %>
      <%= render "schools/picker", regions: @regions, with_classroom: true,
            current_academic_year: @current_academic_year - 1 %>

      <div>
        <%= label_tag :name, "작년 이름", class: "form-label" %>
        <%= text_field_tag :name, nil, class: "form-input", autocomplete: "off" %>
      </div>

      <div>
        <%= label_tag :password, "작년 비밀번호", class: "form-label" %>
        <%= password_field_tag :password, nil, class: "form-input", autocomplete: "off" %>
      </div>

      <%= submit_tag "확인하기", class: "btn btn-primary btn-block" %>
    <% end %>
  </div>

  <p class="text-center text-sm">
    <%= link_to icon_text(:arrow_left, "마이페이지로 돌아가기"), profile_path, class: "inline-flex items-center gap-1 text-steel underline" %>
  </p>
</div>
