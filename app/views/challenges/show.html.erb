<% content_for :title, "#{@challenge.title} · 챌린지" %>

<div class="w-full max-w-2xl mx-auto">
  <header class="mb-4">
    <%= link_to "← 챌린지 목록", challenges_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </header>

  <div class="rounded-2xl border border-gray-200 p-6">
    <h1 class="text-2xl font-bold text-gray-900"><%= @challenge.title %></h1>
    <p class="mt-1 text-sm text-gray-500"><%= @challenge.global? ? "전국" : "우리 학교" %> 챌린지</p>
    <% if @challenge.starts_on || @challenge.ends_on %>
      <p class="mt-1 text-xs text-gray-400"><%= @challenge.starts_on %> ~ <%= @challenge.ends_on %></p>
    <% end %>

    <% if current_user.student? %>
      <div class="mt-6">
        <%= button_to "이 챌린지에 참여하고 독후감 쓰기", join_challenge_path(@challenge), method: :post,
              class: "rounded-lg bg-amber-500 px-4 py-2 text-sm font-medium text-white" %>
      </div>
    <% end %>
  </div>
</div>
