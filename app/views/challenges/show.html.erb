<% content_for :title, "#{@challenge.title} · 챌린지" %>
<% goal_label = { "approved_reports" => "승인 독후감", "game_plays" => "독서 게임" } %>

<div class="page-shell page-shell-content space-y-4">
  <header>
    <%= link_to "← 챌린지 목록", challenges_path, class: "text-sm text-steel hover:text-ink" %>
  </header>

  <div class="card-feature space-y-3">
    <div class="flex items-start justify-between gap-2">
      <h1 class="text-2xl font-bold text-ink"><%= @challenge.title %></h1>
      <span class="badge badge-info"><%= @challenge.global? ? "전국" : "우리 학교" %> 챌린지</span>
    </div>
    <% if @challenge.description.present? %>
      <p class="whitespace-pre-line text-sm text-steel"><%= @challenge.description %></p>
    <% end %>
    <% if @challenge.starts_on || @challenge.ends_on %>
      <p class="text-xs text-muted"><%= @challenge.starts_on %> ~ <%= @challenge.ends_on %></p>
    <% end %>
    <% if @challenge.reward_points.to_i.positive? %>
      <p class="text-sm text-steel">🎁 모든 목표 달성 시 <span class="font-semibold text-ink"><%= @challenge.reward_points %>P + <%= @challenge.reward_points %>XP</span></p>
    <% end %>
  </div>

  <%# 목표 + (학생) 본인 진행률. 목표 없는 레거시 챌린지는 이 섹션을 건너뛴다. %>
  <% if @challenge.has_goals? %>
    <section class="card space-y-3">
      <h2 class="text-base font-bold text-ink">🎯 챌린지 목표</h2>

      <% if @progress %>
        <%# 학생: 본인 진행률(자동 집계). %>
        <% @progress[:goals].each do |g| %>
          <div>
            <div class="flex justify-between text-sm">
              <span class="text-steel">
                <%= goal_label[g[:type]] %> <%= g[:target] %>편<% if g[:book_title] %> · <span class="text-ink">『<%= g[:book_title] %>』</span><% end %>
              </span>
              <span class="<%= g[:met] ? "font-semibold text-green-700" : "text-ink" %>"><%= g[:current] %>/<%= g[:target] %><%= g[:met] ? " ✓" : "" %></span>
            </div>
            <div class="progress-bar mt-1"><div class="progress-bar__fill" style="width: <%= g[:target].positive? ? [ 100 * g[:current] / g[:target], 100 ].min : 0 %>%"></div></div>
          </div>
        <% end %>
        <% if @participation&.rewarded_at? %>
          <p class="text-sm font-semibold text-green-700">🎉 챌린지 완료! <%= @participation.reward_points_awarded %>P + <%= @participation.reward_points_awarded %>XP 받았어요</p>
        <% elsif @progress[:completed] %>
          <p class="text-sm font-semibold text-green-700">🎉 모든 목표를 달성했어요!</p>
        <% end %>
      <% else %>
        <%# 교직원(관리자): 목표 정의만 표시. %>
        <% @challenge.challenge_goals.includes(:books).order(:position, :id).each do |goal| %>
          <div class="flex items-center gap-2 text-sm text-ink">
            <span aria-hidden="true"><%= goal.approved_reports? ? "✏️" : "🎮" %></span>
            <span>
              <%= goal_label[goal.goal_type] %> <strong><%= goal.target_count %></strong><%= goal.approved_reports? ? "편" : "개" %>
              <% if goal.books.any? %><span class="text-steel">· 『<%= goal.books.map(&:title).join("』 『") %>』</span><% else %><span class="text-steel">· 아무 책이나</span><% end %>
            </span>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if current_user.student? %>
    <div class="card">
      <%= button_to "이 챌린지에 참여하고 독후감 쓰기", join_challenge_path(@challenge), method: :post, class: "btn btn-primary" %>
    </div>
  <% end %>

  <% if policy(@challenge).edit? || policy(@challenge).destroy? %>
    <div class="flex flex-wrap gap-2">
      <% if policy(@challenge).edit? %>
        <%= link_to "수정", edit_challenge_path(@challenge), class: "btn btn-secondary btn-sm" %>
      <% end %>
      <% if policy(@challenge).destroy? %>
        <%= button_to "삭제", challenge_path(@challenge), method: :delete,
              form: { data: { turbo_confirm: "이 챌린지를 삭제할까요?" } }, class: "btn btn-danger btn-sm" %>
      <% end %>
    </div>
  <% end %>

  <%# 하단: 목표에 지정된 책 목록(여러 목표에 중복 지정되면 uniq). 파셜이 카드·제목을 자체 렌더하며,
      지정 도서가 없으면 '자유 독서' 안내 + 독서활동 링크를 렌더한다. 책을 누르면 reading_activity 로 이동. %>
  <%= render "shared/activity_book_list", books: @challenge.challenge_goals.flat_map(&:books).uniq %>
</div>
