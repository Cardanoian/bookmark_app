<%# 좋아요 버튼 + 카운트(P5.4). forum_post_likes create/destroy Turbo Stream 대상.
   local: forum_post, (선택) liked — 목록 렌더는 liked 를 넘겨 N+1 을 피하고, 단건(turbo_stream)은 생략해 조회한다. %>
<% liked = local_assigns.fetch(:liked) { current_user && forum_post.forum_post_likes.exists?(user_id: current_user.id) } %>
<span id="<%= dom_id(forum_post, :like) %>" class="inline-flex items-center gap-2">
  <% if liked %>
    <%= button_to "👍 좋아요 취소", forum_post_like_path(forum_post), method: :delete,
          class: "rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-800" %>
  <% else %>
    <%= button_to "👍 좋아요", forum_post_like_path(forum_post), method: :post,
          class: "rounded-full bg-amber-400 px-3 py-1 text-xs font-medium text-white" %>
  <% end %>
  <span class="text-xs font-semibold text-gray-600"><%= forum_post.likes_count %></span>
</span>
