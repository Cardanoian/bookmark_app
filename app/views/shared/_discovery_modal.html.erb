<%# 몬스터 발견 축하 모달(영속 드레인). 학생이 아무 페이지나 로드하면 레이아웃이
    미연출(celebrated_at IS NULL) UserMonster 를 큐로 넘겨 순차 축하하고, discovery_controller
    가 표시 즉시 discoveries#acknowledge 로 celebrated_at 을 마킹해 재노출을 막는다.
    셀프 트리거는 redirect 된 다음 페이지에서, 교사 트리거는 학생 다음 로드에서 확인된다.
    locals: (monsters:) — monster_species 프리로드된 UserMonster 컬렉션(1개 이상). %>
<div id="discovery-modal"
     class="fixed inset-0 z-[60] flex items-center justify-center bg-black/50 px-4"
     role="dialog"
     aria-modal="true"
     aria-label="새 몬스터 발견"
     data-controller="discovery"
     data-discovery-dex-nos-value="<%= monsters.map(&:dex_no).to_json %>"
     data-discovery-acknowledge-url-value="<%= acknowledge_discoveries_path %>">
  <div class="card w-full max-w-sm text-center">
    <p class="text-sm font-semibold text-yellow-dark" aria-hidden="true">🎉 새로운 친구를 발견했어요!</p>

    <% monsters.each_with_index do |monster, index| %>
      <% species = monster.species %>
      <div class="<%= "hidden" unless index.zero? %>" data-discovery-target="card">
        <div class="mx-auto mt-3 flex h-24 w-24 items-center justify-center text-6xl"
             aria-hidden="true" data-sprite>
          <%= monster_sprite(species, img_class: "h-24 w-24 object-contain") %>
        </div>
        <p class="mt-2 text-xs text-muted">No.<%= format("%02d", monster.dex_no) %></p>
        <h2 class="text-xl font-bold text-ink"><%= species.name %></h2>
        <span class="mt-1 inline-block rounded-full px-2 py-0.5 text-xs font-medium <%= element_badge_classes(species.element) %>">
          <%= element_label(species.element) %>
        </span>
        <% if species.description.present? %>
          <p class="mt-3 text-sm text-slate"><%= species.description %></p>
        <% end %>
        <div class="mt-4">
          <%= link_to "도감에서 보기", monster_path(monster.dex_no), class: "btn btn-secondary btn-sm" %>
        </div>
      </div>
    <% end %>

    <div class="mt-5 flex items-center justify-between">
      <span class="text-xs text-muted" data-discovery-target="counter" aria-live="polite"></span>
      <button type="button" class="btn btn-yellow" data-discovery-target="advance" data-action="discovery#next">
        다음
      </button>
    </div>
  </div>
</div>
