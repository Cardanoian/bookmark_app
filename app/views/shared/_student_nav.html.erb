<%# 학생 상단 네비게이션(반응형). locals: active(심볼)로 현재 탭 강조.
    데스크톱=가로 줄바꿈 필 바 / 모바일=현재 메뉴 summary + 세로 disclosure.
    아이콘은 장식용 이모지(aria-hidden)이며 모든 조작부는 최소 44px 터치 영역을 갖는다. %>
<%# locals: (active: nil) %>
<% if current_user&.student? %>
  <%# menu_refactor 심화 PR5: 학생 상위 메뉴 5개(홈·내 서재·독서활동·도감·랭킹). 독후감·게임·상점·미션은
      상위 메뉴에서 제거(독후감·게임은 독서활동 하위 흐름, 미션은 홈·독서활동 문맥 카드). %>
  <% nav_items = [
       [ :home,     "홈",       root_path,             "🏠" ],
       [ :library,  "내 서재",  library_path,          "📚" ],
       [ :activity, "독서활동", reading_activity_path, "✏️" ],
       [ :monsters, "도감",     monsters_path,         "🐾" ],
       [ :rankings, "랭킹",     rankings_path,         "🏆" ]
     ] %>
  <% current_item = nav_items.find { |item| item.first == active } || nav_items.first %>

  <nav class="mb-6 sm:mb-8"
       aria-label="학생 메뉴"
       data-controller="student-nav"
       data-action="click@window->student-nav#closeFromOutside keydown.esc@window->student-nav#close turbo:before-cache@document->student-nav#close">
    <details class="group sm:hidden" data-student-nav-target="menu">
      <summary class="flex min-h-[2.75rem] cursor-pointer list-none items-center justify-between gap-3 rounded-card border border-hairline bg-canvas px-4 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden"
               aria-controls="student-mobile-menu"
               data-student-nav-target="summary">
        <span class="flex min-w-0 items-center gap-2">
          <span aria-hidden="true" class="text-base leading-none"><%= current_item[3] %></span>
          <span class="truncate"><%= current_item[1] %></span>
        </span>
        <span class="shrink-0">
          <span aria-hidden="true" class="text-xl leading-none group-open:hidden">☰</span>
          <span aria-hidden="true" class="hidden text-xl leading-none group-open:inline">×</span>
          <span class="sr-only">학생 메뉴 열기 또는 닫기</span>
        </span>
      </summary>

      <ul id="student-mobile-menu"
          class="mt-2 space-y-1 rounded-card border border-hairline bg-canvas p-2 shadow-sm"
          data-student-nav-layout="mobile">
        <% nav_items.each do |key, label, path, icon| %>
          <li>
            <%= link_to path,
                  aria: { current: (key == active ? "page" : nil) },
                  data: { action: "student-nav#close" },
                  class: "flex min-h-[2.75rem] w-full items-center gap-3 rounded-xl px-4 text-sm font-medium transition #{key == active ? "bg-primary text-white" : "text-steel hover:bg-surface hover:text-ink"}" do %>
              <span aria-hidden="true" class="text-base leading-none"><%= icon %></span>
              <span><%= label %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>

    <ul class="hidden gap-1.5 pb-1 sm:flex sm:flex-wrap" data-student-nav-layout="desktop">
      <% nav_items.each do |key, label, path, icon| %>
        <li class="shrink-0">
          <%= link_to path,
                aria: { current: (key == active ? "page" : nil) },
                class: "flex min-h-[2.75rem] items-center gap-2 rounded-full px-4 text-sm font-medium transition #{key == active ? "bg-primary text-white" : "text-steel hover:bg-surface"}" do %>
            <span aria-hidden="true" class="text-base leading-none"><%= icon %></span>
            <span><%= label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
