<header class="mb-6 flex min-h-[3.5rem] w-full items-center gap-2 border-b border-hairline pb-4 sm:mb-8"
        aria-label="학생 공통 헤더">
  <%= link_to student_back_path,
        class: "btn btn-icon shrink-0",
        aria: { label: "뒤로 가기" } do %>
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m15 18-6-6 6-6" />
    </svg>
  <% end %>

  <p class="min-w-0 flex-1 truncate text-lg font-bold text-ink"><%= current_user.name %></p>

  <%= link_to profile_path,
        class: "btn btn-secondary shrink-0 px-3 sm:px-4",
        aria: { current: (current_page?(profile_path) ? "page" : nil) } do %>
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21a8 8 0 0 0-16 0" />
      <circle cx="12" cy="7" r="4" />
    </svg>
    <span>마이페이지</span>
  <% end %>

  <%= button_to "로그아웃", session_path, method: :delete, class: "btn btn-secondary shrink-0" %>
</header>
