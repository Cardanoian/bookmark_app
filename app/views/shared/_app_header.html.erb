<%# 전역 브랜드 헤더 밴드(옵션 A: 상단 앱 바로 통합).
    좌: 로고(/icon.png) + 서비스명(책갈피) + 현재 학교명(○○학교 독서교육)
    우: 전 역할 계정 컨트롤(이름·로그아웃, 학생은 마이페이지 추가)
    계정 컨트롤은 전 역할 공통이고 마이페이지는 학생 한정이다(구 _student_header 대체).
    옐로 밴드 위 버튼은 브랜드 블루(btn-primary) 필이다. 흰 필은 밋밋하고 연파랑 필은 옐로 위에서 바래
    보였으며, 검은·흰 버튼은 쓰지 않기로 했다(2026-09-04). 채도 있는 블루는 옐로의 보색이라 밴드 위에서 또렷이 선다. %>
<header class="app-header app-header--sticky">
  <div class="app-header__inner px-4 sm:px-6 lg:px-8">
    <% school_name = current_user&.school&.name %>
    <% home_name = [ "책갈피", ("#{school_name} 독서교육" if school_name.present?) ].compact.join(" · ") %>
    <%= link_to root_path, class: "app-wordmark min-w-0", aria: { label: "#{home_name} 홈" } do %>
      <%= image_tag "/icon.png", alt: "", aria: { hidden: "true" }, class: "h-8 w-8 shrink-0 rounded-lg" %>
      <span class="shrink-0" data-role="service-name">책갈피</span>
      <% if school_name.present? %>
        <span class="shrink-0 text-base font-medium text-slate" aria-hidden="true">·</span>
        <span class="min-w-0 truncate text-sm font-semibold text-ink sm:max-w-none sm:text-base"
              data-role="school-context" title="<%= school_name %> 독서교육"><%= school_name %> 독서교육</span>
      <% end %>
    <% end %>

    <%# 계정 컨트롤은 **전 역할 공통**이다. 예전에는 학생만 렌더돼, 교직원은 로그아웃 버튼을
        각 대시보드 화면이 따로 그렸다(7곳에 흩어져 있었고 그 화면을 벗어나면 로그아웃할 길이
        없었다). 마이페이지는 학생 대상 화면이라 학생에게만 남긴다. %>
    <% if current_user %>
      <div class="flex min-w-0 items-center gap-3 sm:gap-4">
        <span class="hidden min-w-0 max-w-[10rem] truncate text-base font-bold text-ink sm:block"><%= current_user.name %><span class="font-medium text-slate">님</span></span>
        <div class="flex shrink-0 items-center gap-2">
          <% if current_user.student? %>
          <%# 효과음 켜기/끄기는 헤더가 아니라 마이페이지(profiles/show '효과음')에 둔다 — 헤더에 두었을 때
              390px 폭에서 버튼이 넘쳐 가로 스크롤이 생겼다(2026-09-19). %>
          <%= link_to profile_path,
                class: "btn btn-primary btn-sm shrink-0 px-3",
                aria: { current: (current_page?(profile_path) ? "page" : nil), label: "마이페이지" } do %>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21a8 8 0 0 0-16 0" />
              <circle cx="12" cy="7" r="4" />
            </svg>
            <span class="hidden sm:inline">마이페이지</span>
          <% end %>
          <% end %>
          <%= button_to "로그아웃", session_path, method: :delete,
                class: "btn btn-primary btn-sm shrink-0" %>
        </div>
      </div>
    <% end %>
  </div>
</header>
