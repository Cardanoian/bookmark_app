<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "관리자 콘솔 · 책갈피" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-screen flex-col overflow-x-hidden bg-surface text-ink">
    <%= render "shared/app_header" %>
    <%= render "shared/seasonal_banner" %>

    <%# 총괄관리자 콘솔 셸. 데스크톱(lg 이상)은 좌측 사이드바 고정, 태블릿/모바일은
        사이드바를 오프캔버스(fixed + translate)로 숨기고 상단 햄버거로 열고 닫는다.
        가로 폭은 사이트 전역 셸 상한(--shell-max-wide=1536px)까지 활용한다.
        rem 이 아닌 px — 데스크톱 루트 폰트 확대에 상한이 딸려 넓어지지 않게 한다. %>
    <div class="mx-auto flex w-full max-w-[1536px] flex-1 min-h-0" data-controller="admin-sidebar" data-action="keydown.esc@window->admin-sidebar#close">
      <%# 모바일/태블릿 전용 반투명 backdrop — 오프캔버스 열림 시에만 표시, lg 이상에서는 항상 숨김 %>
      <div data-admin-sidebar-target="backdrop" data-action="click->admin-sidebar#close"
            class="fixed inset-0 z-40 hidden bg-ink/40 lg:hidden" aria-hidden="true"></div>

      <aside data-admin-sidebar-target="panel" id="admin-sidebar-panel"
            class="fixed inset-y-0 left-0 z-50 w-64 -translate-x-full overflow-y-auto border-r border-hairline bg-surface px-4 py-6 transition-transform duration-200 ease-out lg:static lg:w-64 lg:shrink-0 lg:translate-x-0 lg:transition-none"
            role="navigation" aria-label="총괄관리자 메뉴">
        <div class="mb-4 flex items-center justify-between">
          <%= link_to "총괄관리자", admin_root_path, class: "text-lg font-bold text-ink" %>
          <button type="button" class="btn-icon lg:hidden" data-action="admin-sidebar#close" aria-label="메뉴 닫기"><%= ui_icon :close, class_name: "h-5 w-5" %></button>
        </div>
        <nav class="space-y-1">
          <% nav_items = [
               [ "통합 통계", admin_root_path ],
               [ "감사 로그", admin_audit_logs_path ],
               [ "학교 관리", admin_schools_path ],
               [ "사용자 관리", admin_users_path ],
               [ "도서", admin_books_path ],
               [ "추천도서", admin_recommendation_imports_path ],
               [ "퀴즈", admin_quizzes_path ],
               [ "챌린지", challenges_path ],
               [ "뱃지", admin_badges_path ],
               [ "몬스터 도감", admin_monster_species_index_path ],
               [ "모더레이션", admin_moderation_index_path ],
               [ "계정 연동", admin_account_links_path ],
               [ "시스템 설정", admin_settings_path ]
             ] %>
          <% nav_items.each do |label, path| %>
            <%= link_to label, path,
                  class: "block rounded-lg px-3 py-2 text-sm font-medium #{current_page?(path) ? "bg-canvas font-semibold text-ink" : "text-slate"}" %>
          <% end %>
        </nav>
        <div class="mt-6 border-t border-hairline pt-4 text-xs text-steel">
          <p><%= current_user&.name %></p>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <%# 모바일/태블릿 상단 바 — 햄버거로 오프캔버스 사이드바를 연다. lg 이상에서는 숨김. %>
        <div class="flex items-center gap-3 border-b border-hairline bg-canvas px-4 py-3 lg:hidden">
          <button type="button" class="btn-icon" data-admin-sidebar-target="menuButton" data-action="admin-sidebar#toggle"
                aria-label="메뉴 열기" aria-controls="admin-sidebar-panel" aria-expanded="false"><%= ui_icon :menu %></button>
          <%= link_to "총괄관리자", admin_root_path, class: "text-base font-bold text-ink" %>
        </div>

        <main class="flex-1 px-4 py-6 sm:px-6 lg:px-8">
          <% if notice %>
            <div class="state-banner state-banner--success mb-4" role="status" aria-live="polite"><%= notice %></div>
          <% end %>
          <% if alert %>
            <div class="state-banner state-banner--error mb-4" role="alert" aria-live="assertive"><%= alert %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
