<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "관리자 콘솔 · 책갈피" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 text-gray-900">
    <%= render "shared/seasonal_banner" %>

    <div class="mx-auto flex min-h-screen max-w-7xl">
      <aside class="w-56 shrink-0 border-r border-gray-200 bg-white p-4">
        <%= link_to "총괄관리자", admin_root_path, class: "mb-4 block text-lg font-bold text-gray-900" %>
        <nav class="space-y-1 text-sm">
          <% nav_items = [
               [ "통합 통계", admin_root_path ],
               [ "학교 관리", admin_schools_path ],
               [ "사용자 관리", admin_users_path ],
               [ "도서", admin_books_path ],
               [ "퀴즈", admin_quizzes_path ],
               [ "뱃지", admin_badges_path ],
               [ "상점 아이템", admin_shop_items_path ],
               [ "몬스터 도감", admin_monster_species_index_path ],
               [ "모더레이션", admin_moderation_index_path ],
               [ "시스템 설정", admin_settings_path ]
             ] %>
          <% nav_items.each do |label, path| %>
            <%= link_to label, path,
                  class: "block rounded-lg px-3 py-2 hover:bg-gray-100 #{"bg-gray-100 font-semibold" if current_page?(path)}" %>
          <% end %>
        </nav>
        <div class="mt-6 border-t border-gray-200 pt-4 text-xs text-gray-500">
          <p><%= current_user&.name %></p>
          <%= button_to "로그아웃", session_path, method: :delete,
                class: "mt-2 text-gray-600 hover:underline" %>
        </div>
      </aside>

      <main class="flex-1 p-6">
        <% if notice %>
          <div class="mb-4 rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-700"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="mb-4 rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
