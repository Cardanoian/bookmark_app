<% content_for :title, "뒷이야기 이어쓰기 · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header class="page-header">
    <div class="flex items-start gap-3">
      <span class="<%= game_accent("sequel") %> inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full"><%= ui_icon :writing, class_name: "h-7 w-7" %></span>
      <div>
        <h1 class="page-title">뒷이야기 이어쓰기</h1>
        <p class="page-subtitle"><%= @book.title %> · 책이 끝난 뒤 이어질 이야기를 상상해서 써 보세요. 마음에 드는 친구의 이야기에 공감할 수도 있어요!</p>
      </div>
    </div>
    <div class="page-actions">
      <%= link_to icon_text(:arrow_left, "게임 고르기"), games_catalog_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="state-banner state-banner--success"><%= flash[:notice] %></div>
  <% end %>

  <%# ── 뒷이야기 작성 폼 ── %>
  <section class="card">
    <h2 class="text-sm font-semibold text-ink">내 뒷이야기 쓰기</h2>
    <ul class="mt-2 mb-3 list-disc space-y-1 pl-5 text-xs text-steel">
      <% @tips.each do |tip| %><li><%= tip %></li><% end %>
    </ul>

    <% if @sequel.errors.any? %>
      <div class="state-banner state-banner--error mb-3">
        <%= @sequel.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with url: games_sequel_entries_path, method: :post, scope: :book_sequel, class: "space-y-3" do |f| %>
      <%= f.hidden_field :book_id, value: @book.id %>
      <%= f.text_area :body, rows: 6, value: @sequel.body,
            placeholder: "책이 끝난 다음, 어떤 이야기가 이어질까요? 자유롭게 상상해서 써 보세요. (10자 이상)",
            class: "form-textarea" %>
      <p class="text-xs text-steel">이야기를 올리면 책갈피 도우미가 네 글을 읽고 따뜻한 코멘트를 달아 줘요(나만 볼 수 있어요).</p>
      <%= f.submit "뒷이야기 올리기", class: "btn btn-primary" %>
    <% end %>
  </section>

  <%# ── 또래 뒷이야기 목록(득표순) ── %>
  <section>
    <h2 class="mb-3 text-sm font-semibold text-ink">우리 반 친구들의 뒷이야기</h2>
    <% if @sequels.any? %>
      <div class="space-y-3">
        <% @sequels.each do |sequel| %>
          <% mine = sequel.user_id == current_user.id %>
          <% voted = @voted_ids.include?(sequel.id) %>
          <%# 작성자 본인 글만 AI 코멘트 영역을 구독(완료 시 라이브 갱신). 친구 글은 구독하지 않는다. %>
          <% if mine %><%= turbo_stream_from sequel %><% end %>
          <article class="card">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="whitespace-pre-line break-words text-sm text-ink"><%= sequel.body %></p>
                <p class="mt-2 text-xs text-muted">
                  <%= sequel.user.name %><% if mine %> · <span class="text-brand-blue">내 이야기</span><% end %>
                </p>
                <%# AI 격려 코멘트는 작성자 본인에게만 노출(친구에겐 본문·공감만). %>
                <% if mine %><%= render "games/sequel/feedback", sequel: sequel %><% end %>
              </div>
              <div class="shrink-0 text-center">
                <p class="text-sm font-semibold text-brand-blue"><%= ui_icon :like, class_name: "h-4 w-4" %> <%= sequel.votes_count %></p>
                <% if mine %>
                  <span class="mt-1 block text-xs text-muted">공감 불가</span>
                <% elsif voted %>
                  <%= button_to "공감 취소", games_sequel_vote_path(sequel), method: :delete,
                        class: "btn btn-yellow btn-sm mt-1" %>
                <% else %>
                  <%= button_to "공감", games_sequel_vote_path(sequel), method: :post,
                        class: "btn btn-secondary btn-sm mt-1" %>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state",
            message: "아직 뒷이야기가 없어요. 첫 이야기를 이어 써 보세요!",
            image: "empty_states/sequel-writing.png" %>
    <% end %>
  </section>
</div>
