<% content_for :title, "나는 누구게? · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header class="page-header">
    <div class="flex items-start gap-3">
      <span class="<%= game_accent("whoami") %> inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full"><%= ui_icon :detective, class_name: "h-7 w-7" %></span>
      <div>
        <h1 class="page-title">나는 누구게?</h1>
        <p class="page-subtitle"><%= @quiz.book&.title %> · 힌트를 볼수록 점수가 줄어요. 적게 보고 맞혀 보세요!</p>
      </div>
    </div>
    <div class="page-actions">
      <%= link_to icon_text(:arrow_left, "게임 고르기"), games_catalog_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="state-banner state-banner--success"><%= flash[:notice] %></div>
  <% end %>

  <%# 힌트 공개(§3.2b). 공개 요청마다 서버 카운터(attempt.hint_reveals)가 1 오른다. 이미 공개한
      힌트만 서버 상태에서 렌더한다 — 정답·다음 힌트·잔여 힌트수는 노출하지 않는다. %>
  <div class="space-y-4">
    <% @quiz.quiz_questions.each_with_index do |question, index| %>
      <%= render "hint_card", attempt: @attempt, question: question, question_number: index + 1 %>
    <% end %>
  </div>

  <%= form_with url: games_attempts_path, method: :post, class: "card space-y-4" do |f| %>
    <%= f.hidden_field :quiz_id, value: @quiz.id %>
    <%= f.hidden_field :game, value: "whoami" %>
    <%= f.hidden_field :attempt_id, value: @attempt.id %>

    <% @quiz.quiz_questions.each_with_index do |question, index| %>
      <label class="block">
        <span class="form-label"><%= index + 1 %>번 정답</span>
        <%= text_field_tag "answers[#{question.id}]", nil, placeholder: "정답을 입력하세요",
              class: "form-input" %>
      </label>
    <% end %>

    <%= f.submit "정답 확인!", class: "btn btn-primary btn-block" %>
  <% end %>

  <%= render "games/regenerate", quiz: @quiz, game: "whoami" %>
</div>
