<% content_for :title, "나는 누구게? · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header class="page-header">
    <div class="flex items-start gap-3">
      <span class="<%= game_accent("whoami") %> inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-xl" aria-hidden="true">🕵️</span>
      <div>
        <p class="text-sm font-medium text-steel">독서 게임</p>
        <h1 class="page-title"><span aria-hidden="true">🕵️</span> 나는 누구게?</h1>
        <p class="page-subtitle"><%= @quiz.book&.title %> · 힌트를 볼수록 점수가 줄어요. 적게 보고 맞혀 보세요!</p>
      </div>
    </div>
    <div class="page-actions">
      <%= link_to "← 게임 고르기", games_catalog_path, class: "text-sm text-steel hover:text-ink" %>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="state-banner state-banner--success"><%= flash[:notice] %></div>
  <% end %>

  <%# 힌트 공개(§3.2b). 공개 요청마다 서버 카운터(attempt.hint_reveals)가 1 오른다. 이미 공개한
      힌트만 서버 상태에서 렌더한다 — 정답·다음 힌트·잔여 힌트수는 노출하지 않는다. %>
  <div class="space-y-4">
    <% @quiz.quiz_questions.each_with_index do |question, index| %>
      <% revealed = @attempt.revealed_count(question) %>
      <% hints = question.hints_list %>
      <div class="card">
        <p class="text-sm font-semibold text-ink"><%= index + 1 %>번 정답을 맞혀 보세요</p>

        <ul class="mt-2 space-y-1">
          <% hints.first(revealed).each do |hint| %>
            <li class="card-muted rounded-lg px-3 py-2 text-sm text-ink"><span aria-hidden="true">💡</span> <%= hint %></li>
          <% end %>
          <% if revealed.zero? %>
            <li class="text-sm text-muted">아직 힌트를 보지 않았어요. 바로 맞히면 점수가 가장 높아요!</li>
          <% end %>
        </ul>

        <% if revealed < hints.length %>
          <%= button_to "힌트 더 보기", games_whoami_reveal_hint_path(attempt: @attempt.id),
                params: { question_id: question.id },
                class: "btn btn-secondary btn-sm mt-2" %>
        <% else %>
          <p class="mt-2 text-xs text-muted">힌트를 모두 봤어요.</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= form_with url: games_attempts_path, method: :post, class: "card space-y-4" do |f| %>
    <%= f.hidden_field :quiz_id, value: @quiz.id %>
    <%= f.hidden_field :game, value: "whoami" %>
    <%= f.hidden_field :attempt_id, value: @attempt.id %>

    <% @quiz.quiz_questions.each_with_index do |question, index| %>
      <label class="block">
        <span class="form-label"><%= index + 1 %>번 정답</span>
        <%= text_field_tag "answers[#{question.id}]", nil, placeholder: "정답을 입력하세요",
              class: "form-input" %>
      </label>
    <% end %>

    <%= f.submit "정답 확인!", class: "btn btn-primary btn-block" %>
  <% end %>

  <%= render "games/regenerate", quiz: @quiz, game: "whoami" %>
</div>
