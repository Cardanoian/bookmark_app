<%# 다시 뽑기(§3.4) + 신고(무게이트 롤아웃 안전장치). 온디맨드(system) 판에서만 노출. locals: quiz, game %>
<% if quiz.origin == "system" %>
  <div class="mt-2 flex flex-col gap-2 rounded-xl border border-hairline bg-surface-yellow p-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="form-hint text-yellow-dark"><%= ui_icon :medal, class_name: "h-4 w-4" %> 포인트와 경험치는 최고 기록만 반영돼요. 새 문제를 뽑아도 이미 받은 보상은 줄지 않아요.</p>
    <%= button_to games_regenerate_path,
          params: { book_id: quiz.book_id, surface: game },
          class: "btn btn-subtle btn-sm shrink-0" do %>
      <%= ui_icon :dice, class_name: "h-4 w-4" %> <span>다시 뽑기</span>
    <% end %>
  </div>
  <div class="mt-2 text-right">
    <%= button_to games_content_reports_path,
          params: { quiz_id: quiz.id },
          form: { data: { turbo_confirm: "이 문제를 선생님께 신고할까요?" } },
          class: "btn btn-subtle btn-sm" do %>
      <%= ui_icon :flag, class_name: "h-4 w-4" %> <span>이상한 문제예요 (신고)</span>
    <% end %>
  </div>
<% end %>
