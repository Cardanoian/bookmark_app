<%# 독서게임 공통 4지선다 폼(mcq 표면 quiz). locals: quiz, game, submit_label %>
<%= form_with url: games_attempts_path, method: :post, class: "space-y-5" do |f| %>
  <%= f.hidden_field :quiz_id, value: quiz.id %>
  <%= f.hidden_field :game, value: game %>

  <% quiz.quiz_questions.each_with_index do |question, index| %>
    <%# 복수 정답(mcq_multi)은 체크박스 그룹으로 받는다. `required` 는 라디오에만 쓴다 —
        체크박스에 붙이면 브라우저가 "각 칸이 필수"로 해석해 전부 체크해야 제출된다.
        서버는 손댈 게 없다: AttemptsController#submitted_answers 가 to_unsafe_h 로 배열을
        원형 보존하고 QuestionScorer::McqMulti 가 그대로 채점한다. %>
    <% multi = question.mcq_multi? %>
    <fieldset class="rounded-lg border border-hairline p-4">
      <legend class="px-1 text-sm font-semibold text-ink">
        <%= index + 1 %>. <%= question.prompt %>
      </legend>
      <% if multi %>
        <p class="mt-1 text-sm text-brand-blue">정답을 모두 고르세요.</p>
      <% end %>
      <div class="mt-2 space-y-2">
        <% question.choice_list.each_with_index do |choice, choice_index| %>
          <label class="flex items-center gap-2 rounded-lg border border-hairline-strong px-3 min-h-[2.75rem] text-sm text-ink has-[:checked]:border-brand-blue has-[:checked]:bg-surface-featured">
            <% if multi %>
              <%= check_box_tag "answers[#{question.id}][]", choice_index, false,
                    id: "answer_#{question.id}_#{choice_index}", class: "text-brand-blue" %>
            <% else %>
              <%= radio_button_tag "answers[#{question.id}]", choice_index, false, required: true, class: "text-brand-blue" %>
            <% end %>
            <%= choice %>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <%= f.submit submit_label, class: "btn btn-primary btn-block" %>
<% end %>
