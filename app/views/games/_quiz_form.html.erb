<%# 독서게임 공통 4지선다 폼(mcq 표면 quiz·classic 공유). locals: quiz, game, submit_label %>
<%= form_with url: games_attempts_path, method: :post, class: "space-y-5" do |f| %>
  <%= f.hidden_field :quiz_id, value: quiz.id %>
  <%= f.hidden_field :game, value: game %>

  <% quiz.quiz_questions.each_with_index do |question, index| %>
    <fieldset class="rounded-xl border border-gray-200 p-4">
      <legend class="px-1 text-sm font-semibold text-gray-900">
        <%= index + 1 %>. <%= question.prompt %>
      </legend>
      <div class="mt-2 space-y-2">
        <% question.choice_list.each_with_index do |choice, choice_index| %>
          <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-700 hover:bg-amber-50">
            <%= radio_button_tag "answers[#{question.id}]", choice_index, false, required: true, class: "text-amber-500" %>
            <%= choice %>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <%= f.submit submit_label, class: "rounded-lg bg-amber-500 px-5 py-2 text-sm font-medium text-white" %>
<% end %>
