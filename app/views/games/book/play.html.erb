<% content_for :title, "책 소개 대결 · 책갈피" %>

<div class="w-full max-w-2xl mx-auto">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">📖 책 소개 대결</h1>
      <p class="mt-1 text-sm text-gray-500"><%= @book.title %> · 친구들에게 이 책을 소개하고, 마음에 드는 소개에 투표하세요!</p>
    </div>
    <%= link_to "← 게임 고르기", games_catalog_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </header>

  <% if flash[:notice] %>
    <div class="mb-4 rounded-lg bg-emerald-50 p-3 text-sm text-emerald-700"><%= flash[:notice] %></div>
  <% end %>

  <%# ── 소개 작성 폼 ── %>
  <section class="mb-6 rounded-xl border border-gray-200 p-4">
    <h2 class="text-sm font-semibold text-gray-900">내 소개 쓰기</h2>
    <ul class="mt-2 mb-3 list-disc space-y-1 pl-5 text-xs text-gray-500">
      <% @tips.each do |tip| %><li><%= tip %></li><% end %>
    </ul>

    <% if @intro.errors.any? %>
      <div class="mb-3 rounded-lg bg-rose-50 p-3 text-sm text-rose-700">
        <%= @intro.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with url: games_book_intros_path, method: :post, scope: :book_intro, class: "space-y-3" do |f| %>
      <%= f.hidden_field :book_id, value: @book.id %>
      <%= f.text_area :body, rows: 4, value: @intro.body,
            placeholder: "이 책을 친구에게 소개해 보세요. (10자 이상)",
            class: "w-full rounded-lg border border-gray-200 px-3 py-2 text-sm text-gray-800" %>
      <%= f.submit "소개 올리기", class: "rounded-lg bg-indigo-500 px-5 py-2 text-sm font-medium text-white" %>
    <% end %>
  </section>

  <%# ── 또래 소개 목록(득표순) ── %>
  <section>
    <h2 class="mb-3 text-sm font-semibold text-gray-900">우리 반 친구들의 소개</h2>
    <% if @intros.any? %>
      <div class="space-y-3">
        <% @intros.each do |intro| %>
          <% mine = intro.user_id == current_user.id %>
          <% voted = @voted_ids.include?(intro.id) %>
          <article class="rounded-xl border border-gray-200 p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-sm text-gray-800 whitespace-pre-line break-words"><%= intro.body %></p>
                <p class="mt-2 text-xs text-gray-400">
                  <%= intro.user.name %><% if mine %> · <span class="text-indigo-500">내 소개</span><% end %>
                </p>
              </div>
              <div class="shrink-0 text-center">
                <p class="text-sm font-semibold text-indigo-600">👍 <%= intro.votes_count %></p>
                <% if mine %>
                  <span class="mt-1 block text-xs text-gray-300">투표 불가</span>
                <% elsif voted %>
                  <%= button_to "투표 취소", games_book_vote_path(intro), method: :delete,
                        class: "mt-1 rounded-lg border border-indigo-200 px-3 py-1 text-xs text-indigo-600" %>
                <% else %>
                  <%= button_to "투표", games_book_vote_path(intro), method: :post,
                        class: "mt-1 rounded-lg bg-indigo-500 px-3 py-1 text-xs font-medium text-white" %>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "아직 소개가 없어요. 첫 소개를 남겨 보세요!" %>
    <% end %>
  </section>
</div>
