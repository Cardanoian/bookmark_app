<% content_for :title, "독서 퀴즈 · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header class="page-header">
    <div class="flex items-start gap-3">
      <span class="<%= game_accent("quiz") %> inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full"><%= ui_icon :quiz, class_name: "h-7 w-7" %></span>
      <div>
        <h1 class="page-title">독서 퀴즈</h1>
        <%# 온디맨드(system) 판은 내부 라벨("온디맨드 mcq")이 제목이라 학생에겐 책 제목을 보인다(whoami 미러). 교사 퀴즈는 교사가 지은 제목 유지. %>
        <p class="page-subtitle"><%= @quiz.origin == "system" ? @quiz.book&.title : @quiz.title %> · 정답 한 문제당 <%= Games::QuizPlay::POINTS_PER_CORRECT %>P + <%= Games::QuizPlay::POINTS_PER_CORRECT %>XP</p>
      </div>
    </div>
    <div class="page-actions">
      <%= link_to icon_text(:arrow_left, "게임 고르기"), games_catalog_path, class: "inline-flex items-center gap-1 text-sm text-steel hover:text-ink" %>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="state-banner state-banner--success"><%= flash[:notice] %></div>
  <% end %>

  <div class="card">
    <%= render "games/quiz_form", quiz: @quiz, game: "quiz", submit_label: "채점하기" %>
  </div>
  <%= render "games/regenerate", quiz: @quiz, game: "quiz" %>
</div>
