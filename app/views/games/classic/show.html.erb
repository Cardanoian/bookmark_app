<% content_for :title, "고전 읽기 여행 · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header class="page-header">
    <div class="flex items-start gap-3">
      <span class="<%= game_accent("classic") %> inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-xl" aria-hidden="true">🏛️</span>
      <div>
        <p class="text-sm font-medium text-steel">독서 게임</p>
        <h1 class="page-title"><span aria-hidden="true">🏛️</span> 고전 읽기 여행</h1>
        <p class="page-subtitle"><%= @quiz.book&.title %> · 정답 한 문제당 <%= Games::QuizPlay::POINTS_PER_CORRECT %>P + <%= Games::QuizPlay::POINTS_PER_CORRECT %>XP</p>
      </div>
    </div>
    <div class="page-actions">
      <%= link_to "← 게임 고르기", games_catalog_path, class: "text-sm text-steel hover:text-ink" %>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="state-banner state-banner--success"><%= flash[:notice] %></div>
  <% end %>

  <div class="card">
    <%= render "games/quiz_form", quiz: @quiz, game: "classic", submit_label: "채점하기" %>
  </div>
  <%= render "games/regenerate", quiz: @quiz, game: "classic" %>
</div>
