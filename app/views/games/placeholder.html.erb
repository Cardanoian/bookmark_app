<% entry = catalog_entry %>
<% content_for :title, "#{entry[:name]} · 책갈피" %>

<div class="w-full max-w-2xl mx-auto">
  <header class="mb-6 flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900"><%= entry[:icon] %> <%= entry[:name] %></h1>
    <%= link_to "← 내 서재", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </header>

  <div class="rounded-xl border border-dashed border-gray-300 p-10 text-center">
    <p class="text-4xl"><%= entry[:icon] %></p>
    <p class="mt-3 text-base font-semibold text-gray-800"><%= entry[:name] %>은(는) 준비 중이에요.</p>
    <p class="mt-1 text-sm text-gray-500">지금은 독서 퀴즈·골든벨·독서 빙고를 즐길 수 있어요.</p>
  </div>
</div>
