<% content_for :title, "독서 게임 · 책갈피" %>

<div class="w-full max-w-3xl mx-auto">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">🎮 독서 게임</h1>
      <p class="mt-1 text-sm text-gray-500">책을 고르면 바로 게임이 만들어져요. 기다릴 필요 없어요!</p>
    </div>
    <%= link_to "← 내 서재", root_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </header>

  <section class="mb-6 rounded-xl border border-gray-200 p-4">
    <h2 class="text-sm font-semibold text-gray-900">즐길 수 있는 게임</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      <% @games.each do |_key, meta| %>
        <span class="rounded-full bg-gray-100 px-3 py-1 text-xs text-gray-700"><%= meta[:icon] %> <%= meta[:name] %></span>
      <% end %>
    </div>
  </section>

  <% if @books.any? %>
    <div class="space-y-4">
      <% @books.each do |book| %>
        <article class="rounded-xl border border-gray-200 p-4">
          <div class="flex items-baseline justify-between">
            <h3 class="text-base font-semibold text-gray-900"><%= book.title %></h3>
            <% if book.author.present? %><span class="text-xs text-gray-400"><%= book.author %></span><% end %>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            <% @games.each do |key, meta| %>
              <%= link_to "#{meta[:icon]} #{meta[:name]}", public_send("games_#{key}_play_path", book_id: book.id),
                    class: "rounded-lg border border-amber-200 bg-amber-50 px-3 py-1.5 text-xs font-medium text-amber-800 hover:bg-amber-100" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "아직 고를 수 있는 책이 없어요." %>
  <% end %>
</div>
