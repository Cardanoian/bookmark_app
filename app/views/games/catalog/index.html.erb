<% content_for :title, "독서 게임 · 책갈피" %>

<div class="page-shell page-shell-wide space-y-6">
  <%= render "shared/student_nav", active: :games %>

  <% if @books.any? %>
    <div class="space-y-4">
      <% @books.each do |book| %>
        <article class="card">
          <div class="flex items-baseline justify-between">
            <h3 class="text-base font-semibold text-ink"><%= book.title %></h3>
            <% if book.author.present? %><span class="text-xs text-muted"><%= book.author %></span><% end %>
          </div>
          <div class="mt-3 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            <% @games.each do |key, meta| %>
              <%= link_to public_send("games_#{key}_play_path", book_id: book.id),
                    class: "#{game_accent(key)} inline-flex items-center justify-center gap-1 rounded-lg px-3 min-h-[2.75rem] text-sm font-medium" do %>
                <span aria-hidden="true"><%= meta[:icon] %></span> <%= meta[:name] %>
              <% end %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <%= render "shared/empty_state", message: "아직 고를 수 있는 책이 없어요." %>
  <% end %>
</div>
