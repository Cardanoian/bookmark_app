<% content_for :title, "어휘 낚시 · 책갈피" %>

<div class="w-full max-w-2xl mx-auto">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">🎣 어휘 낚시</h1>
      <p class="mt-1 text-sm text-gray-500"><%= @quiz.book&.title %> · 낱말과 뜻을 바르게 이어 보세요!</p>
    </div>
    <%= link_to "← 게임 고르기", games_catalog_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </header>

  <% if flash[:notice] %>
    <div class="mb-4 rounded-lg bg-emerald-50 p-3 text-sm text-emerald-700"><%= flash[:notice] %></div>
  <% end %>

  <%= render "games/matching_form", quiz: @quiz, game: "vocab" %>
  <%= render "games/regenerate", quiz: @quiz, game: "vocab" %>
</div>
