<% content_for :title, "어휘 낚시 · 책갈피" %>

<div class="page-shell page-shell-content space-y-6">
  <header class="page-header">
    <div class="flex items-start gap-3">
      <span class="<%= game_accent("vocab") %> inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full text-xl" aria-hidden="true">🎣</span>
      <div>
        <p class="text-sm font-medium text-steel">독서 게임</p>
        <h1 class="page-title"><span aria-hidden="true">🎣</span> 어휘 낚시</h1>
        <p class="page-subtitle"><%= @quiz.book&.title %> · 낱말과 뜻을 바르게 이어 보세요!</p>
      </div>
    </div>
    <div class="page-actions">
      <%= link_to "← 게임 고르기", games_catalog_path, class: "text-sm text-steel hover:text-ink" %>
    </div>
  </header>

  <% if flash[:notice] %>
    <div class="state-banner state-banner--success"><%= flash[:notice] %></div>
  <% end %>

  <div class="card">
    <%= render "games/matching_form", quiz: @quiz, game: "vocab" %>
  </div>
  <%= render "games/regenerate", quiz: @quiz, game: "vocab" %>
</div>
