<%# 짝짓기(matching) 폼(§3.2a). 각 왼쪽 낱말마다 오른쪽 뜻을 골라 **선택 인덱스만** 전송한다.
    정답 쌍맵(answer)은 뷰/클라이언트로 직렬화하지 않는다(무유출). locals: quiz, game %>
<%= form_with url: games_attempts_path, method: :post, class: "space-y-5" do |f| %>
  <%= f.hidden_field :quiz_id, value: quiz.id %>
  <%= f.hidden_field :game, value: game %>

  <% quiz.quiz_questions.each do |question| %>
    <% rights = question.match_rights %>
    <fieldset class="rounded-lg border border-hairline p-4">
      <legend class="px-1 text-sm font-semibold text-ink"><%= question.prompt %></legend>
      <div class="mt-3 space-y-2">
        <% question.match_lefts.each_with_index do |left, left_index| %>
          <div class="flex items-center gap-3">
            <span class="w-32 shrink-0 rounded-lg bg-teal-light px-3 py-2 text-sm font-medium text-moss-dark"><%= left %></span>
            <span class="text-muted" aria-hidden="true">↔</span>
            <%= select_tag "answers[#{question.id}][#{left_index}]",
                  options_for_select(rights.each_with_index.map { |right, right_index| [ right, right_index ] }),
                  include_blank: "— 알맞은 뜻 고르기 —", required: true,
                  class: "form-select flex-1" %>
          </div>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <%= f.submit "짝짓기 완성!", class: "btn btn-primary btn-block" %>
<% end %>
