<% content_for :title, "밸런스 게임 · 책갈피" %>

<div class="w-full max-w-2xl mx-auto">
  <header class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">⚖️ 밸런스 게임</h1>
      <p class="mt-1 text-sm text-gray-500"><%= @quiz.book&.title %> · 정답은 없어요. 내 생각을 골라 보세요!</p>
    </div>
    <%= link_to "← 게임 고르기", games_catalog_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </header>

  <% if flash[:notice] %>
    <div class="mb-4 rounded-lg bg-emerald-50 p-3 text-sm text-emerald-700"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: games_attempts_path, method: :post, class: "space-y-5" do |f| %>
    <%= f.hidden_field :quiz_id, value: @quiz.id %>
    <%= f.hidden_field :game, value: "balance" %>

    <% @quiz.quiz_questions.each_with_index do |question, index| %>
      <fieldset class="rounded-xl border border-gray-200 p-4">
        <legend class="px-1 text-sm font-semibold text-gray-900"><%= index + 1 %>. <%= question.prompt %></legend>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          <% question.balance_options.each_with_index do |option, option_index| %>
            <label class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-3 text-sm text-gray-700 hover:bg-rose-50">
              <%= radio_button_tag "answers[#{question.id}]", option_index, false, required: true, class: "text-rose-500" %>
              <%= option %>
            </label>
          <% end %>
        </div>
      </fieldset>
    <% end %>

    <%= f.submit "선택 완료!", class: "rounded-lg bg-rose-500 px-5 py-2 text-sm font-medium text-white" %>
  <% end %>

  <%= render "games/regenerate", quiz: @quiz, game: "balance" %>
</div>
