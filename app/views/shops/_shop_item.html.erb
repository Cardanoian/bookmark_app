<%# locals: (item:, purchase: nil) %>
<div id="<%= dom_id(item, :shop) %>" class="card flex items-center justify-between px-4 py-3">
  <div class="flex items-center gap-3">
    <span class="text-3xl" aria-hidden="true"><%= item.icon %></span>
    <div>
      <p class="text-sm font-semibold text-ink"><%= item.name %></p>
      <p class="text-xs text-steel">
        <span class="badge badge-neutral"><%= item.cost %>P</span>
        <% if item.consumable? && purchase&.quantity.to_i.positive? %>
          · 보유 <%= purchase.quantity %>개
        <% end %>
      </p>
    </div>
  </div>
  <% if !item.consumable? && purchase.present? %>
    <span class="badge badge-success">보유 중</span>
  <% else %>
    <%= button_to "구매", purchases_path, params: { shop_item_id: item.id },
          class: "btn btn-yellow btn-sm" %>
  <% end %>
</div>
