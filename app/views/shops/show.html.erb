<% content_for :title, "케어 상점 · 책갈피" %>

<div class="page-shell page-shell-content">
  <%= render "shared/student_nav", active: :shop %>

  <div class="mb-6 flex justify-end sm:mb-8" aria-label="보유 포인트" data-page-status="points-balance">
    <span class="badge badge-yellow">내 포인트 <span id="points_balance"><%= @balance %></span>P</span>
  </div>

  <div id="shop_flash" class="mb-4"></div>

  <% if @items_by_category.empty? %>
    <%= render "shared/empty_state", message: "상점 아이템을 준비 중이에요.", icon: "🛒" %>
  <% else %>
    <% @items_by_category.each do |category, items| %>
      <section class="mb-6">
        <h2 class="mb-2 text-sm font-semibold text-slate"><%= category_label(category) %></h2>
        <div class="space-y-2">
          <% items.each do |item| %>
            <%= render "shops/shop_item", item: item, purchase: @inventory[item.id] %>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>
</div>
