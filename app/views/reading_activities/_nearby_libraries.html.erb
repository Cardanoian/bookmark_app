<%# locals: (nearby:) %>
<%# nearby: Library::NearbyAvailability::Result 또는 nil(resolve_book 실패 방어). %>
<%# lazy src 프레임은 응답에 동일 id 프레임이 없으면 "content missing" 이 되므로 항상 감싼다. %>
<%= turbo_frame_tag "nearby_libraries" do %>
  <% status_badges = { available: [ "대출 가능", "badge badge-success" ],
                       unavailable: [ "대출 중", "badge badge-neutral" ],
                       unknown: [ "확인 필요", "badge badge-yellow" ] } %>
  <% if nearby&.state == :ok %>
    <section class="card space-y-3">
      <h3 class="flex items-center gap-1.5 font-semibold text-ink"><%= ui_icon :location %> 우리 학교 근처에서 빌리기</h3>
      <ul class="divide-y divide-hairline-soft">
        <% nearby.libraries.each do |lib| %>
          <li class="flex items-center justify-between gap-3 py-2">
            <div class="min-w-0">
              <span class="block truncate font-medium text-ink"><%= lib[:name] %></span>
              <% if lib[:address].present? %>
                <span class="block truncate text-xs text-steel"><%= lib[:address] %></span>
              <% end %>
              <% if lib[:homepage].present? %>
                <% if lib[:homepage].match?(%r{\Ahttps?://}i) %>
                  <%= link_to "홈페이지", lib[:homepage], target: "_blank", rel: "noopener noreferrer",
                        class: "text-sm text-brand-blue underline" %>
                <% else %>
                  <span class="text-xs text-steel"><%= lib[:homepage] %></span>
                <% end %>
              <% end %>
            </div>
            <% label, badge_class = status_badges[lib[:status]] || status_badges[:unknown] %>
            <span class="<%= badge_class %> shrink-0"><%= label %></span>
          </li>
        <% end %>
      </ul>
      <p class="text-xs text-steel">
        정보나루 제공<% if nearby.as_of %> · <%= [ ((Time.current - nearby.as_of) / 60).floor, 0 ].max %>분 기준<% end %> ·
        정확한 대출 상태는 도서관에서 확인해 주세요.
      </p>
    </section>
  <% elsif nearby&.state == :none %>
    <section>
      <%= render "shared/empty_state",
            message: "우리 학교 근처에는 이 책을 빌릴 수 있는 도서관이 없어요", icon: :books %>
    </section>
  <% elsif nearby&.state == :no_location %>
    <section class="card">
      <p class="text-sm text-steel">학교 주소 정보가 없어 근처 도서관을 찾지 못했어요.</p>
    </section>
  <% else %>
    <%# :no_key / :error / :no_isbn / nil → 섹션 숨김(빈 프레임). 무키·실패는 조용히 degrade. %>
  <% end %>
<% end %>
