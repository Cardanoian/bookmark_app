<%# 전역 도서 CRUD(P7.3). %>
<div class="space-y-6">
  <div class="page-header">
    <h1 class="page-title">도서 관리</h1>
    <div class="page-actions">
      <%= link_to "도서 등록", new_admin_book_path, class: "btn btn-primary" %>
    </div>
  </div>

  <%= form_with url: admin_books_path, method: :get, class: "flex gap-2" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "제목 검색", class: "form-input w-64" %>
    <%= f.submit "검색", class: "btn btn-secondary" %>
  <% end %>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-hairline text-steel">
        <tr><th class="py-2 pr-4">제목</th><th class="py-2 pr-4">저자</th><th class="py-2 pr-4">분류</th><th class="py-2"></th></tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr class="border-b border-hairline-soft">
            <td class="py-2 pr-4 font-medium text-ink"><%= link_to book.title, admin_book_path(book), class: "hover:underline" %></td>
            <td class="py-2 pr-4 text-slate"><%= book.author %></td>
            <td class="py-2 pr-4 text-slate"><%= book.category %></td>
            <td class="py-2 text-right"><%= link_to "수정", edit_admin_book_path(book), class: "btn btn-secondary btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/shared/pager", page: @page, has_next: @has_next_page %>
</div>
