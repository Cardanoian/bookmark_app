<div class="max-w-lg space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900"><%= @book.title %></h1>
    <div class="flex gap-2">
      <%= link_to "수정", edit_admin_book_path(@book), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= button_to "삭제", admin_book_path(@book), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "rounded-lg border border-rose-300 px-3 py-1.5 text-sm text-rose-600" %>
    </div>
  </div>
  <dl class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex justify-between py-1"><dt class="text-gray-500">저자</dt><dd><%= @book.author %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">출판사</dt><dd><%= @book.publisher %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">ISBN</dt><dd><%= @book.isbn %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">분류</dt><dd><%= @book.category %></dd></div>
  </dl>
  <% if @book.summary.present? %>
    <p class="rounded-lg border border-gray-200 bg-white p-4 text-sm text-gray-700"><%= @book.summary %></p>
  <% end %>
</div>
