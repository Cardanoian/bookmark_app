<%# 섹션별 페이지네이션(#4). param 만 갱신하고 다른 섹션 page 는 유지한다. %>
<% if has_next || page > 1 %>
  <nav class="mt-3 flex items-center justify-between">
    <% if page > 1 %>
      <%= link_to "← 이전", admin_moderation_index_path(request.query_parameters.merge(param => page - 1)), class: "btn btn-secondary btn-sm" %>
    <% else %>
      <span></span>
    <% end %>
    <% if has_next %>
      <%= link_to "다음 →", admin_moderation_index_path(request.query_parameters.merge(param => page + 1)), class: "btn btn-secondary btn-sm" %>
    <% else %>
      <span></span>
    <% end %>
  </nav>
<% end %>
