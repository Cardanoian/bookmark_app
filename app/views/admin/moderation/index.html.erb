<%# 모더레이션(P7.6). 게시판·토론글·토픽의 숨김/해제. 숨김 콘텐츠는 학생 화면 비노출. %>
<div class="space-y-8">
  <div class="page-header">
    <h1 class="page-title">모더레이션</h1>
  </div>

  <section>
    <h2 class="mb-3 text-base font-semibold text-ink">우수작 게시판 (<%= @board_posts.size %>)</h2>
    <ul class="space-y-2">
      <% @board_posts.each do |post| %>
        <li class="flex items-center justify-between rounded-lg border border-hairline bg-canvas p-3 text-sm">
          <span class="<%= "line-through text-muted" if post.hidden? %>">
            <%= post.report.book_title.presence || "독후감 ##{post.report_id}" %>
            <span class="text-steel">· <%= post.report.user&.name %></span>
            <% if post.hidden? %>
              <span class="badge badge-neutral">숨김</span>
            <% end %>
          </span>
          <% if post.hidden? %>
            <%= button_to "숨김 해제", unhide_admin_moderation_path(post, kind: "board_post"),
                  class: "btn btn-secondary btn-sm" %>
          <% else %>
            <%= button_to "숨기기", hide_admin_moderation_path(post, kind: "board_post"),
                  class: "btn btn-danger btn-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= render "admin/moderation/pager", page: @board_page, has_next: @has_next_board, param: :board_page %>
  </section>

  <section>
    <h2 class="mb-3 text-base font-semibold text-ink">토론글 (<%= @forum_posts.size %>)</h2>
    <ul class="space-y-2">
      <% @forum_posts.each do |post| %>
        <li class="flex items-center justify-between rounded-lg border border-hairline bg-canvas p-3 text-sm">
          <span class="<%= "line-through text-muted" if post.hidden? %>">
            <%= truncate(post.text.to_s, length: 60) %>
            <span class="text-steel">· <%= post.user&.name %></span>
            <% if post.hidden? %>
              <span class="badge badge-neutral">숨김</span>
            <% end %>
          </span>
          <% if post.hidden? %>
            <%= button_to "숨김 해제", unhide_admin_moderation_path(post, kind: "forum_post"),
                  class: "btn btn-secondary btn-sm" %>
          <% else %>
            <%= button_to "숨기기", hide_admin_moderation_path(post, kind: "forum_post"),
                  class: "btn btn-danger btn-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= render "admin/moderation/pager", page: @forum_page, has_next: @has_next_forum, param: :forum_page %>
  </section>

  <section>
    <h2 class="mb-3 text-base font-semibold text-ink">토픽 (<%= @topics.size %>)</h2>
    <ul class="space-y-2">
      <% @topics.each do |topic| %>
        <li class="flex items-center justify-between rounded-lg border border-hairline bg-canvas p-3 text-sm">
          <span class="<%= "line-through text-muted" if topic.hidden? %>">
            <%= topic.title %>
            <% if topic.hidden? %>
              <span class="badge badge-neutral">숨김</span>
            <% end %>
          </span>
          <% if topic.hidden? %>
            <%= button_to "숨김 해제", unhide_admin_moderation_path(topic, kind: "topic"),
                  class: "btn btn-secondary btn-sm" %>
          <% else %>
            <%= button_to "숨기기", hide_admin_moderation_path(topic, kind: "topic"),
                  class: "btn btn-danger btn-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
    <%= render "admin/moderation/pager", page: @topic_page, has_next: @has_next_topic, param: :topic_page %>
  </section>
</div>
