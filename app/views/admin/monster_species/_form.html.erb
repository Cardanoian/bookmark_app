<%# 몬스터 종 폼. local: species. evolve_condition 은 JSON 텍스트에어리어(안전 파싱). %>
<%= form_with model: species, url: (species.persisted? ? admin_monster_species_path(species) : admin_monster_species_index_path),
      class: "card max-w-lg space-y-4" do |f| %>
  <% if species.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <%= ui_icon :warning %>
      <span><%= species.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :key, "키(고유)", class: "form-label" %>
      <%= f.text_field :key, class: "form-input" %>
    </div>
    <div>
      <%= f.label :name, "이름", class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>
    <div>
      <%= f.label :dex_no, "Dex 번호", class: "form-label" %>
      <%= f.number_field :dex_no, class: "form-input" %>
    </div>
    <div>
      <%= f.label :stage, "진화 단계(1~3)", class: "form-label" %>
      <%= f.number_field :stage, class: "form-input" %>
    </div>
    <div>
      <%= f.label :element, "속성", class: "form-label" %>
      <%= f.select :element, MonsterSpecies.elements.keys.map { |e| [ e, e ] }, {}, class: "form-select" %>
    </div>
    <div>
      <%= f.label :rarity, "희귀도", class: "form-label" %>
      <%= f.select :rarity, MonsterSpecies.rarities.keys.map { |r| [ r, r ] }, {}, class: "form-select" %>
    </div>
  </div>

  <div>
    <%= f.label :evolves_from_id, "진화 이전 종(진화 규칙)", class: "form-label" %>
    <%= f.collection_select :evolves_from_id, MonsterSpecies.where.not(id: species.id).order(:dex_no, :stage),
          :id, ->(s) { "#{s.name.presence || s.key} (dex #{s.dex_no} · #{s.stage}단계)" },
          { include_blank: "없음(기본형)" }, class: "form-select" %>
  </div>

  <div>
    <%= f.label :evolve_condition_json, "진화 조건(evolve_condition) JSON", class: "form-label" %>
    <%= f.text_area :evolve_condition_json, value: species.evolve_condition_json, rows: 4,
          class: "form-textarea font-mono text-xs" %>
    <p class="form-hint">예: {"level": 10} · 빈 값이면 조건 없음. 잘못된 JSON 은 저장되지 않습니다.</p>
  </div>

  <div>
    <%= f.label :image_key, "이미지 키", class: "form-label" %>
    <%= f.text_field :image_key, class: "form-input" %>
  </div>

  <div class="page-actions">
    <%= f.submit "저장", class: "btn btn-primary" %>
    <%= link_to "취소", admin_monster_species_index_path, class: "text-sm text-steel hover:underline" %>
  </div>
<% end %>
