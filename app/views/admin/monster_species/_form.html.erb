<%# 몬스터 종 폼. local: species. evolve_condition 은 JSON 텍스트에어리어(안전 파싱). %>
<%= form_with model: species, url: (species.persisted? ? admin_monster_species_path(species) : admin_monster_species_index_path),
      class: "max-w-lg space-y-4 rounded-lg border border-gray-200 bg-white p-5" do |f| %>
  <% if species.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
      <%= species.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :key, "키(고유)", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.text_field :key, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :name, "이름", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :dex_no, "Dex 번호", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.number_field :dex_no, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :stage, "진화 단계(1~3)", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.number_field :stage, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :element, "속성", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.select :element, MonsterSpecies.elements.keys.map { |e| [ e, e ] }, {}, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :rarity, "희귀도", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.select :rarity, MonsterSpecies.rarities.keys.map { |r| [ r, r ] }, {}, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :evolves_from_id, "진화 이전 종(진화 규칙)", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.collection_select :evolves_from_id, MonsterSpecies.where.not(id: species.id).order(:dex_no, :stage),
          :id, ->(s) { "#{s.name.presence || s.key} (dex #{s.dex_no} · #{s.stage}단계)" },
          { include_blank: "없음(기본형)" }, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
  </div>

  <div>
    <%= f.label :evolve_condition_json, "진화 조건(evolve_condition) JSON", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_area :evolve_condition_json, value: species.evolve_condition_json, rows: 4,
          class: "w-full rounded-lg border border-gray-300 p-2 font-mono text-xs" %>
    <p class="mt-1 text-xs text-gray-500">예: {"level": 10} · 빈 값이면 조건 없음. 잘못된 JSON 은 저장되지 않습니다.</p>
  </div>

  <div>
    <%= f.label :image_key, "이미지 키", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :image_key, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "취소", admin_monster_species_index_path, class: "text-sm text-gray-500" %>
  </div>
<% end %>
