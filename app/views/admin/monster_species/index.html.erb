<%# 몬스터 도감 CRUD(P7.3). 종·진화 규칙 관리. %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900">몬스터 도감</h1>
    <%= link_to "몬스터 등록", new_admin_monster_species_path, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
  </div>

  <table class="w-full text-left text-sm">
    <thead class="border-b border-gray-200 text-gray-500">
      <tr><th class="py-2 pr-4">Dex</th><th class="py-2 pr-4">단계</th><th class="py-2 pr-4">이름</th><th class="py-2 pr-4">속성</th><th class="py-2 pr-4">희귀도</th><th class="py-2 pr-4">진화 이전</th><th class="py-2"></th></tr>
    </thead>
    <tbody>
      <% @species.each do |species| %>
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-4 text-gray-600"><%= species.dex_no %></td>
          <td class="py-2 pr-4 text-gray-600"><%= species.stage %></td>
          <td class="py-2 pr-4 font-medium text-gray-900"><%= link_to species.name.presence || species.key, admin_monster_species_path(species), class: "hover:underline" %></td>
          <td class="py-2 pr-4 text-gray-600"><%= species.element %></td>
          <td class="py-2 pr-4 text-gray-600"><%= species.rarity %></td>
          <td class="py-2 pr-4 text-gray-600"><%= species.evolves_from&.name %></td>
          <td class="py-2 text-right"><%= link_to "수정", edit_admin_monster_species_path(species), class: "text-gray-500 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
