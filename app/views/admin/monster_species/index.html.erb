<%# 몬스터 도감 CRUD(P7.3). 종·진화 규칙 관리. %>
<div class="space-y-6">
  <div class="page-header">
    <h1 class="page-title">몬스터 도감</h1>
    <div class="page-actions">
      <%= link_to "몬스터 등록", new_admin_monster_species_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-hairline text-steel">
        <tr><th class="py-2 pr-4">Dex</th><th class="py-2 pr-4">단계</th><th class="py-2 pr-4">이름</th><th class="py-2 pr-4">속성</th><th class="py-2 pr-4">희귀도</th><th class="py-2 pr-4">진화 이전</th><th class="py-2"></th></tr>
      </thead>
      <tbody>
        <% @species.each do |species| %>
          <tr class="border-b border-hairline-soft">
            <td class="py-2 pr-4 text-slate"><%= species.dex_no %></td>
            <td class="py-2 pr-4 text-slate"><%= species.stage %></td>
            <td class="py-2 pr-4 font-medium text-ink"><%= link_to species.name.presence || species.key, admin_monster_species_path(species), class: "hover:underline" %></td>
            <td class="py-2 pr-4 text-slate"><%= species.element %></td>
            <td class="py-2 pr-4 text-slate"><%= species.rarity %></td>
            <td class="py-2 pr-4 text-slate"><%= species.evolves_from&.name %></td>
            <td class="py-2 text-right"><%= link_to "수정", edit_admin_monster_species_path(species), class: "btn btn-secondary btn-sm" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
