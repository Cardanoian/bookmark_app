<div class="max-w-lg space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900"><%= @species_record.name.presence || @species_record.key %></h1>
    <div class="flex gap-2">
      <%= link_to "수정", edit_admin_monster_species_path(@species_record), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= button_to "삭제", admin_monster_species_path(@species_record), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "rounded-lg border border-rose-300 px-3 py-1.5 text-sm text-rose-600" %>
    </div>
  </div>
  <dl class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex justify-between py-1"><dt class="text-gray-500">Dex</dt><dd><%= @species_record.dex_no %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">단계</dt><dd><%= @species_record.stage %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">속성</dt><dd><%= @species_record.element %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">희귀도</dt><dd><%= @species_record.rarity %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">진화 이전</dt><dd><%= @species_record.evolves_from&.name %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">진화 조건</dt><dd class="font-mono text-xs"><%= @species_record.evolve_condition %></dd></div>
  </dl>
</div>
