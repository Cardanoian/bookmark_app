<div class="max-w-lg space-y-4">
  <div class="page-header">
    <h1 class="page-title"><%= @species_record.name.presence || @species_record.key %></h1>
    <div class="page-actions">
      <%= link_to "수정", edit_admin_monster_species_path(@species_record), class: "btn btn-secondary btn-sm" %>
      <%= button_to "삭제", admin_monster_species_path(@species_record), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "btn btn-danger btn-sm" %>
    </div>
  </div>
  <dl class="card text-sm">
    <div class="flex justify-between py-1"><dt class="text-steel">Dex</dt><dd><%= @species_record.dex_no %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">단계</dt><dd><%= @species_record.stage %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">속성</dt><dd><%= @species_record.element %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">희귀도</dt><dd><%= @species_record.rarity %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">진화 이전</dt><dd><%= @species_record.evolves_from&.name %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">진화 조건</dt><dd class="font-mono text-xs"><%= @species_record.evolve_condition %></dd></div>
  </dl>
</div>
