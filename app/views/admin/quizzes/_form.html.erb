<%# 퀴즈 폼. local: quiz. 문항은 중첩 폼(보기는 한 줄에 하나). %>
<%= form_with model: quiz, url: (quiz.persisted? ? admin_quiz_path(quiz) : admin_quizzes_path),
      class: "max-w-2xl space-y-4 rounded-lg border border-gray-200 bg-white p-5" do |f| %>
  <% if quiz.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
      <%= quiz.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "제목", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div>
      <%= f.label :scope, "범위", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.select :scope, Quiz.scopes.keys.map { |s| [ s, s ] }, {}, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :book_id, "도서 ID(선택)", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.number_field :book_id, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <label class="mt-6 flex items-center gap-2 text-sm text-gray-700">
      <%= f.check_box :published %> 공개
    </label>
  </div>

  <fieldset class="space-y-4 border-t border-gray-200 pt-4">
    <legend class="text-sm font-semibold text-gray-800">문항</legend>
    <%= f.fields_for :quiz_questions do |qf| %>
      <div class="space-y-2 rounded-lg border border-gray-200 p-3">
        <%= qf.text_field :prompt, placeholder: "문항 질문", class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
        <%= qf.text_area :choices, value: (qf.object.choices.is_a?(Array) ? qf.object.choices.join("\n") : qf.object.choices),
              rows: 4, placeholder: "보기 (한 줄에 하나)", class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
        <div class="flex items-center gap-3">
          <%= qf.number_field :answer_index, placeholder: "정답 인덱스(0부터)", class: "w-40 rounded-lg border border-gray-300 p-2 text-sm" %>
          <%= qf.number_field :position, placeholder: "순서", class: "w-24 rounded-lg border border-gray-300 p-2 text-sm" %>
          <% if qf.object.persisted? %>
            <label class="flex items-center gap-1 text-xs text-rose-600"><%= qf.check_box :_destroy %> 삭제</label>
          <% end %>
        </div>
      </div>
    <% end %>
  </fieldset>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "취소", admin_quizzes_path, class: "text-sm text-gray-500" %>
  </div>
<% end %>
