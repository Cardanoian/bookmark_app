<%# 퀴즈 폼. local: quiz. 문항은 중첩 폼(보기는 한 줄에 하나). %>
<%= form_with model: quiz, url: (quiz.persisted? ? admin_quiz_path(quiz) : admin_quizzes_path),
      class: "max-w-2xl space-y-4 card" do |f| %>
  <% if quiz.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <span aria-hidden="true">⚠️</span>
      <span><%= quiz.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "제목", class: "form-label" %>
    <%= f.text_field :title, class: "form-input" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-3">
    <div>
      <%= f.label :scope, "범위", class: "form-label" %>
      <%= f.select :scope, Quiz.scopes.keys.map { |s| [ s, s ] }, {}, class: "form-select" %>
    </div>
    <div>
      <%= f.label :book_id, "도서 ID(선택)", class: "form-label" %>
      <%= f.number_field :book_id, class: "form-input" %>
    </div>
    <label class="mt-6 flex items-center gap-2 text-sm text-slate">
      <%= f.check_box :published %> 공개
    </label>
  </div>

  <fieldset class="space-y-4 border-t border-hairline pt-4">
    <legend class="text-sm font-semibold text-ink">문항</legend>
    <%= f.fields_for :quiz_questions do |qf| %>
      <div class="card-muted space-y-2">
        <%= qf.text_field :prompt, placeholder: "문항 질문", class: "form-input" %>
        <%= qf.text_area :choices, value: (qf.object.choices.is_a?(Array) ? qf.object.choices.join("\n") : qf.object.choices),
              rows: 4, placeholder: "보기 (한 줄에 하나)", class: "form-textarea" %>
        <div class="flex items-center gap-3">
          <%= qf.number_field :answer_index, placeholder: "정답 인덱스(0부터)", class: "form-input w-40" %>
          <%= qf.number_field :position, placeholder: "순서", class: "form-input w-24" %>
          <% if qf.object.persisted? %>
            <label class="flex items-center gap-1 text-xs text-error-text"><%= qf.check_box :_destroy %> 삭제</label>
          <% end %>
        </div>
      </div>
    <% end %>
  </fieldset>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "btn btn-primary" %>
    <%= link_to "취소", admin_quizzes_path, class: "text-sm text-steel hover:underline" %>
  </div>
<% end %>
