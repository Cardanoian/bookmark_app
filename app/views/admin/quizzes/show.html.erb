<div class="max-w-2xl space-y-4">
  <div class="page-header">
    <h1 class="page-title"><%= @quiz.title %></h1>
    <div class="page-actions">
      <%= link_to "수정", edit_admin_quiz_path(@quiz), class: "btn btn-secondary btn-sm" %>
      <%= button_to "삭제", admin_quiz_path(@quiz), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "btn btn-danger btn-sm" %>
    </div>
  </div>
  <p class="text-sm text-steel">범위 <%= @quiz.scope %> · <span class="badge <%= @quiz.published? ? "badge-success" : "badge-neutral" %>"><%= @quiz.published? ? "공개" : "비공개" %></span></p>

  <ol class="space-y-3">
    <% @questions.each do |question| %>
      <li class="card text-sm">
        <p class="font-medium text-ink"><%= question.prompt %></p>
        <ul class="mt-2 space-y-1">
          <% Array(question.choices).each_with_index do |choice, index| %>
            <li class="<%= index == question.answer_index ? "font-semibold text-success-ink" : "text-slate" %>"><%= index + 1 %>. <%= choice %></li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ol>
</div>
