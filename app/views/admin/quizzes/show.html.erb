<div class="max-w-2xl space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900"><%= @quiz.title %></h1>
    <div class="flex gap-2">
      <%= link_to "수정", edit_admin_quiz_path(@quiz), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= button_to "삭제", admin_quiz_path(@quiz), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "rounded-lg border border-rose-300 px-3 py-1.5 text-sm text-rose-600" %>
    </div>
  </div>
  <p class="text-sm text-gray-500">범위 <%= @quiz.scope %> · <%= @quiz.published? ? "공개" : "비공개" %></p>

  <ol class="space-y-3">
    <% @questions.each do |question| %>
      <li class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
        <p class="font-medium text-gray-900"><%= question.prompt %></p>
        <ul class="mt-2 space-y-1">
          <% Array(question.choices).each_with_index do |choice, index| %>
            <li class="<%= "font-semibold text-emerald-700" if index == question.answer_index %>"><%= index %>. <%= choice %></li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ol>
</div>
