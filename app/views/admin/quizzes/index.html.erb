<%# 전역 퀴즈 CRUD(P7.3). %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900">퀴즈 관리</h1>
    <%= link_to "퀴즈 등록", new_admin_quiz_path, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
  </div>

  <table class="w-full text-left text-sm">
    <thead class="border-b border-gray-200 text-gray-500">
      <tr><th class="py-2 pr-4">제목</th><th class="py-2 pr-4">범위</th><th class="py-2 pr-4">문항수</th><th class="py-2 pr-4">공개</th><th class="py-2"></th></tr>
    </thead>
    <tbody>
      <% @quizzes.each do |quiz| %>
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-4 font-medium text-gray-900"><%= link_to quiz.title, admin_quiz_path(quiz), class: "hover:underline" %></td>
          <td class="py-2 pr-4 text-gray-600"><%= quiz.scope %></td>
          <td class="py-2 pr-4 text-gray-600"><%= quiz.quiz_questions.size %></td>
          <td class="py-2 pr-4 text-gray-600"><%= quiz.published? ? "공개" : "비공개" %></td>
          <td class="py-2 text-right"><%= link_to "수정", edit_admin_quiz_path(quiz), class: "text-gray-500 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "admin/shared/pager", page: @page, has_next: @has_next_page %>
</div>
