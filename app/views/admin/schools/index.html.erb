<%# 학교 관리 목록(P7.2). 검색 + 등록. %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900">학교 관리</h1>
    <%= link_to "학교 등록", new_admin_school_path,
          class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
  </div>

  <%= form_with url: admin_schools_path, method: :get, class: "flex gap-2" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "학교명 검색",
          class: "w-64 rounded-lg border border-gray-300 p-2 text-sm" %>
    <%= f.submit "검색", class: "rounded-lg border border-gray-300 px-4 py-2 text-sm" %>
  <% end %>

  <table class="w-full text-left text-sm">
    <thead class="border-b border-gray-200 text-gray-500">
      <tr><th class="py-2 pr-4">학교명</th><th class="py-2 pr-4">지역</th><th class="py-2 pr-4">NEIS</th><th class="py-2"></th></tr>
    </thead>
    <tbody>
      <% @schools.each do |school| %>
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-4 font-medium text-gray-900"><%= link_to school.name, admin_school_path(school), class: "hover:underline" %></td>
          <td class="py-2 pr-4 text-gray-600"><%= school.region %></td>
          <td class="py-2 pr-4 text-gray-600"><%= school.neis_code %></td>
          <td class="py-2 text-right"><%= link_to "수정", edit_admin_school_path(school), class: "text-gray-500 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= render "admin/shared/pager", page: @page, has_next: @has_next_page %>
</div>
