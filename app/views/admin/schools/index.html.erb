<%# 학교 관리 목록(P7.2). 검색 + 등록. %>
<div class="space-y-6">
  <div class="page-header">
    <h1 class="page-title">학교 관리</h1>
    <div class="page-actions">
      <%= link_to "학교 등록", new_admin_school_path, class: "btn btn-primary" %>
    </div>
  </div>

  <%= form_with url: admin_schools_path, method: :get, class: "flex gap-2" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "학교명 검색", class: "form-input w-64" %>
    <%= f.submit "검색", class: "btn btn-secondary" %>
  <% end %>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-hairline text-steel">
        <tr><th class="py-2 pr-4">학교명</th><th class="py-2 pr-4">지역</th><th class="py-2 pr-4">NEIS</th><th class="py-2"></th></tr>
      </thead>
      <tbody>
        <% @schools.each do |school| %>
          <tr class="border-b border-hairline-soft">
            <td class="py-2 pr-4 font-medium text-ink"><%= link_to school.name, admin_school_path(school), class: "hover:underline" %></td>
            <td class="py-2 pr-4 text-slate"><%= school.region %></td>
            <td class="py-2 pr-4 text-slate"><%= school.neis_code %></td>
            <td class="py-2 text-right"><%= link_to "수정", edit_admin_school_path(school), class: "text-sm text-brand-blue hover:underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/shared/pager", page: @page, has_next: @has_next_page %>
</div>
