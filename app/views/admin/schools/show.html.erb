<div class="max-w-lg space-y-4">
  <div class="page-header">
    <h1 class="page-title"><%= @school.name %></h1>
    <div class="page-actions">
      <%= link_to "수정", edit_admin_school_path(@school), class: "btn btn-secondary btn-sm" %>
      <%= button_to "삭제", admin_school_path(@school), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "btn btn-danger btn-sm" %>
    </div>
  </div>
  <dl class="card text-sm">
    <div class="flex justify-between py-1"><dt class="text-steel">지역</dt><dd class="text-ink"><%= @school.region %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">시군구</dt><dd class="text-ink"><%= @school.gu %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">NEIS 코드</dt><dd class="text-ink"><%= @school.neis_code %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">상태</dt><dd class="text-ink"><%= @school.active? ? "운영" : "비활성" %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">데이터 출처</dt><dd class="text-ink"><%= @school.data_source %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">도로명주소</dt><dd class="text-ink"><%= @school.address %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">학급 수</dt><dd class="text-ink"><%= @school.classrooms.size %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">사용자 수</dt><dd class="text-ink"><%= @school.users.size %></dd></div>
  </dl>
</div>
