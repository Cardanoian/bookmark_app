<div class="max-w-lg space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900"><%= @school.name %></h1>
    <div class="flex gap-2">
      <%= link_to "수정", edit_admin_school_path(@school), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= button_to "삭제", admin_school_path(@school), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "rounded-lg border border-rose-300 px-3 py-1.5 text-sm text-rose-600" %>
    </div>
  </div>
  <dl class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex justify-between py-1"><dt class="text-gray-500">지역</dt><dd><%= @school.region %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">시군구</dt><dd><%= @school.gu %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">NEIS 코드</dt><dd><%= @school.neis_code %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">학급 수</dt><dd><%= @school.classrooms.size %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">사용자 수</dt><dd><%= @school.users.size %></dd></div>
  </dl>
</div>
