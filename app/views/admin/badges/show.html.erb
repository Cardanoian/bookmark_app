<div class="max-w-lg space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900"><%= @badge.name %> <span class="font-mono text-sm text-gray-400">(<%= @badge.key %>)</span></h1>
    <div class="flex gap-2">
      <%= link_to "수정", edit_admin_badge_path(@badge), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
      <%= button_to "삭제", admin_badge_path(@badge), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "rounded-lg border border-rose-300 px-3 py-1.5 text-sm text-rose-600" %>
    </div>
  </div>
  <dl class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex justify-between py-1"><dt class="text-gray-500">아이콘</dt><dd><%= @badge.icon %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">조건</dt><dd><%= @badge.condition_desc %></dd></div>
  </dl>
</div>
