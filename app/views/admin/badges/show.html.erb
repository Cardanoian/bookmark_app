<div class="max-w-lg space-y-4">
  <div class="page-header">
    <h1 class="page-title"><%= @badge.name %> <span class="font-mono text-sm text-steel">(<%= @badge.key %>)</span></h1>
    <div class="page-actions">
      <%= link_to "수정", edit_admin_badge_path(@badge), class: "btn btn-secondary btn-sm" %>
      <%= button_to "삭제", admin_badge_path(@badge), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "btn btn-danger btn-sm" %>
    </div>
  </div>
  <dl class="card text-sm">
    <div class="flex justify-between py-1"><dt class="text-steel">아이콘</dt><dd><%= @badge.icon %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">조건</dt><dd><%= @badge.condition_desc %></dd></div>
  </dl>
</div>
