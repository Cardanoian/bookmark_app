<%# 뱃지 폼. local: badge %>
<%= form_with model: badge, url: (badge.persisted? ? admin_badge_path(badge) : admin_badges_path),
      class: "card max-w-lg space-y-4" do |f| %>
  <% if badge.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <%= ui_icon :warning %>
      <span><%= badge.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div>
    <%= f.label :key, "키(고유)", class: "form-label" %>
    <%= f.text_field :key, class: "form-input" %>
  </div>
  <div>
    <%= f.label :name, "이름", class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>
  <div>
    <%= f.label :icon, "아이콘", class: "form-label" %>
    <%= f.text_field :icon, class: "form-input" %>
  </div>
  <div>
    <%= f.label :condition_desc, "획득 조건 설명", class: "form-label" %>
    <%= f.text_field :condition_desc, class: "form-input" %>
  </div>

  <div class="page-actions">
    <%= f.submit "저장", class: "btn btn-primary" %>
    <%= link_to "취소", admin_badges_path, class: "btn btn-secondary" %>
  </div>
<% end %>
