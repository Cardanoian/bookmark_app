<%# 전역 뱃지 CRUD(P7.3). %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900">뱃지 관리</h1>
    <%= link_to "뱃지 등록", new_admin_badge_path, class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
  </div>

  <table class="w-full text-left text-sm">
    <thead class="border-b border-gray-200 text-gray-500">
      <tr><th class="py-2 pr-4">키</th><th class="py-2 pr-4">이름</th><th class="py-2 pr-4">조건</th><th class="py-2"></th></tr>
    </thead>
    <tbody>
      <% @badges.each do |badge| %>
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-4 font-mono text-gray-900"><%= link_to badge.key, admin_badge_path(badge), class: "hover:underline" %></td>
          <td class="py-2 pr-4"><%= badge.name %></td>
          <td class="py-2 pr-4 text-gray-600"><%= badge.condition_desc %></td>
          <td class="py-2 text-right"><%= link_to "수정", edit_admin_badge_path(badge), class: "text-gray-500 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
