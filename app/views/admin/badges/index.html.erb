<%# 전역 뱃지 CRUD(P7.3). %>
<div class="space-y-6">
  <div class="page-header">
    <h1 class="page-title">뱃지 관리</h1>
    <div class="page-actions">
      <%= link_to "뱃지 등록", new_admin_badge_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-hairline text-steel">
        <tr><th class="py-2 pr-4">키</th><th class="py-2 pr-4">이름</th><th class="py-2 pr-4">조건</th><th class="py-2"></th></tr>
      </thead>
      <tbody>
        <% @badges.each do |badge| %>
          <tr class="border-b border-hairline-soft">
            <td class="py-2 pr-4 font-mono text-ink"><%= link_to badge.key, admin_badge_path(badge), class: "hover:underline" %></td>
            <td class="py-2 pr-4"><%= badge.name %></td>
            <td class="py-2 pr-4 text-slate"><%= badge.condition_desc %></td>
            <td class="py-2 text-right"><%= link_to "수정", edit_admin_badge_path(badge), class: "text-sm text-brand-blue hover:underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
