<div class="page-header">
  <h1 class="page-title"><%= @user.name %> 정보 수정</h1>
</div>
<%= form_with model: @user, url: admin_user_path(@user),
      class: "card max-w-lg space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <%= ui_icon :warning %>
      <span><%= @user.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "이름", class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>
  <div>
    <%= f.label :points, "포인트", class: "form-label" %>
    <%= f.number_field :points, min: 0, step: 1, class: "form-input" %>
    <p class="form-hint">현재 경험치 <%= @user.experience %>XP · 포인트를 올리면 차액만큼 경험치도 오르고, 포인트를 낮춰도 경험치는 유지됩니다.</p>
  </div>
  <p class="form-hint">역할 변경과 계정 정지는 상세 화면의 전용 버튼에서 처리합니다.</p>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "btn btn-primary" %>
    <%= link_to "취소", admin_user_path(@user), class: "btn btn-secondary" %>
  </div>
<% end %>
