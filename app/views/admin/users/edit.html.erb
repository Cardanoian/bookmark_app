<h1 class="mb-4 text-xl font-bold text-gray-900"><%= @user.name %> 정보 수정</h1>
<%= form_with model: @user, url: admin_user_path(@user),
      class: "max-w-lg space-y-4 rounded-lg border border-gray-200 bg-white p-5" do |f| %>
  <% if @user.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
      <%= @user.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "이름", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
  </div>
  <div>
    <%= f.label :points, "포인트", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.number_field :points, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
  </div>
  <p class="text-xs text-gray-500">역할 변경과 계정 정지는 상세 화면의 전용 버튼에서 처리합니다.</p>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "취소", admin_user_path(@user), class: "text-sm text-gray-500" %>
  </div>
<% end %>
