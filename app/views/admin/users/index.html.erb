<%# 사용자 관리 목록(P7.2). 이름·역할·학교 검색. %>
<div class="space-y-6">
  <h1 class="text-xl font-bold text-gray-900">사용자 관리</h1>

  <%= form_with url: admin_users_path, method: :get, class: "flex flex-wrap gap-2" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "이름 검색",
          class: "w-48 rounded-lg border border-gray-300 p-2 text-sm" %>
    <%= f.select :role, options_for_select(User.roles.keys.map { |r| [ r, r ] }, params[:role]),
          { include_blank: "역할 전체" }, class: "rounded-lg border border-gray-300 p-2 text-sm" %>
    <%= f.select :school_id, options_from_collection_for_select(@schools, :id, :name, params[:school_id]),
          { include_blank: "학교 전체" }, class: "rounded-lg border border-gray-300 p-2 text-sm" %>
    <%= f.submit "검색", class: "rounded-lg border border-gray-300 px-4 py-2 text-sm" %>
  <% end %>

  <table class="w-full text-left text-sm">
    <thead class="border-b border-gray-200 text-gray-500">
      <tr><th class="py-2 pr-4">이름</th><th class="py-2 pr-4">역할</th><th class="py-2 pr-4">학교</th><th class="py-2 pr-4">상태</th><th class="py-2"></th></tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr class="border-b border-gray-100">
          <td class="py-2 pr-4 font-medium text-gray-900"><%= link_to user.name, admin_user_path(user), class: "hover:underline" %></td>
          <td class="py-2 pr-4 text-gray-600"><%= user.role %></td>
          <td class="py-2 pr-4 text-gray-600"><%= user.school&.name %></td>
          <td class="py-2 pr-4">
            <% if user.suspended? %>
              <span class="rounded bg-rose-100 px-2 py-0.5 text-xs text-rose-700">정지</span>
            <% else %>
              <span class="rounded bg-emerald-100 px-2 py-0.5 text-xs text-emerald-700">활성</span>
            <% end %>
          </td>
          <td class="py-2 text-right"><%= link_to "관리", admin_user_path(user), class: "text-gray-500 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
