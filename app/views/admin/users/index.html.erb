<%# 사용자 관리 목록(P7.2). 이름·역할·학교 검색. %>
<div class="space-y-6">
  <div class="page-header">
    <h1 class="page-title">사용자 관리</h1>
  </div>

  <%= form_with url: admin_users_path, method: :get, class: "flex flex-wrap gap-2" do |f| %>
    <%= f.text_field :q, value: params[:q], placeholder: "이름 검색",
          class: "form-input w-48" %>
    <%= f.select :role, options_for_select(User.roles.keys.map { |r| [ r, r ] }, params[:role]),
          { include_blank: "역할 전체" }, class: "form-select w-auto" %>
    <%= f.select :school_id, options_from_collection_for_select(@schools, :id, :name, params[:school_id]),
          { include_blank: "학교 전체" }, class: "form-select w-auto" %>
    <%= f.submit "검색", class: "btn btn-secondary" %>
  <% end %>

  <div class="overflow-x-auto">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-hairline text-steel">
        <tr><th class="py-2 pr-4">이름</th><th class="py-2 pr-4">역할</th><th class="py-2 pr-4">학교</th><th class="py-2 pr-4">상태</th><th class="py-2"></th></tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr class="border-b border-hairline-soft">
            <td class="py-2 pr-4 font-medium text-ink"><%= link_to user.name, admin_user_path(user), class: "hover:underline" %></td>
            <td class="py-2 pr-4 text-slate"><%= user.role %></td>
            <td class="py-2 pr-4 text-slate"><%= user.school&.name %></td>
            <td class="py-2 pr-4">
              <% if user.suspended? %>
                <span class="badge badge-danger">정지</span>
              <% else %>
                <span class="badge badge-success">활성</span>
              <% end %>
            </td>
            <td class="py-2 text-right"><%= link_to "관리", admin_user_path(user), class: "text-sm text-brand-blue hover:underline" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "admin/shared/pager", page: @page, has_next: @has_next_page %>
</div>
