<%# 사용자 상세·관리(P7.2). 정지/해제·비밀번호 초기화·역할 부여. %>
<div class="max-w-xl space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-xl font-bold text-gray-900"><%= @user.name %></h1>
    <%= link_to "정보 수정", edit_admin_user_path(@user), class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
  </div>

  <dl class="rounded-lg border border-gray-200 bg-white p-4 text-sm">
    <div class="flex justify-between py-1"><dt class="text-gray-500">역할</dt><dd><%= @user.role %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">학교</dt><dd><%= @user.school&.name %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">포인트</dt><dd><%= @user.points %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-gray-500">상태</dt><dd><%= @user.suspended? ? "정지" : "활성" %></dd></div>
  </dl>

  <div class="flex flex-wrap gap-2 rounded-lg border border-gray-200 bg-white p-4">
    <% if @user.suspended? %>
      <%= button_to "정지 해제", unsuspend_admin_user_path(@user), class: "rounded-lg bg-emerald-600 px-3 py-1.5 text-sm text-white" %>
    <% else %>
      <%= button_to "계정 정지", suspend_admin_user_path(@user), class: "rounded-lg bg-rose-600 px-3 py-1.5 text-sm text-white" %>
    <% end %>
    <%= button_to "비밀번호 초기화", reset_password_admin_user_path(@user),
          form: { data: { turbo_confirm: "임시 비밀번호로 초기화할까요?" } },
          class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm" %>
  </div>

  <%= form_with url: role_admin_user_path(@user), method: :patch, class: "flex items-end gap-2 rounded-lg border border-gray-200 bg-white p-4" do |f| %>
    <div>
      <%= f.label :role, "역할 변경", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.select :role, options_for_select(User.roles.keys.map { |r| [ r, r ] }, @user.role),
            {}, class: "rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <%= f.submit "적용", class: "rounded-lg bg-gray-800 px-3 py-2 text-sm text-white" %>
  <% end %>
</div>
