<%# 사용자 상세·관리(P7.2). 정지/해제·비밀번호 초기화·역할 부여. %>
<div class="max-w-xl space-y-5">
  <div class="page-header">
    <h1 class="page-title"><%= @user.name %></h1>
    <div class="page-actions">
      <%= link_to "정보 수정", edit_admin_user_path(@user), class: "btn btn-secondary btn-sm" %>
    </div>
  </div>

  <dl class="card text-sm">
    <div class="flex justify-between py-1"><dt class="text-steel">역할</dt><dd class="text-ink"><%= @user.role %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">학교</dt><dd class="text-ink"><%= @user.school&.name %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">포인트</dt><dd class="text-ink"><%= @user.points %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">경험치</dt><dd class="text-ink"><%= @user.experience %></dd></div>
    <div class="flex justify-between py-1">
      <dt class="text-steel">상태</dt>
      <dd>
        <% if @user.suspended? %>
          <span class="badge badge-danger">정지</span>
        <% else %>
          <span class="badge badge-success">활성</span>
        <% end %>
      </dd>
    </div>
  </dl>

  <div class="card flex flex-wrap gap-2">
    <% if @user.suspended? %>
      <%= button_to "정지 해제", unsuspend_admin_user_path(@user), class: "btn btn-secondary btn-sm" %>
    <% else %>
      <%= button_to "계정 정지", suspend_admin_user_path(@user), class: "btn btn-danger btn-sm" %>
    <% end %>
    <%= button_to "비밀번호 초기화", reset_password_admin_user_path(@user),
          form: { data: { turbo_confirm: "임시 비밀번호로 초기화할까요?" } },
          class: "btn btn-secondary btn-sm" %>
  </div>

  <%= form_with url: role_admin_user_path(@user), method: :patch, class: "card flex items-end gap-2" do |f| %>
    <div>
      <%= f.label :role, "역할 변경", class: "form-label" %>
      <%= f.select :role, options_for_select(User.roles.keys.map { |r| [ r, r ] }, @user.role),
            {}, class: "form-select" %>
    </div>
    <%= f.submit "적용", class: "btn btn-primary" %>
  <% end %>
</div>
