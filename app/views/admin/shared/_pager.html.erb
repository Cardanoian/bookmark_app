<%# 관리자 목록 공통 페이지네이션(#misc). 검색·필터 파라미터를 유지한 채 page 만 갱신한다. %>
<% if has_next || page > 1 %>
  <nav class="mt-4 flex items-center justify-between">
    <% if page > 1 %>
      <%= link_to icon_text(:arrow_left, "이전"), url_for(request.query_parameters.merge(page: page - 1)), class: "btn btn-secondary btn-sm" %>
    <% else %>
      <span></span>
    <% end %>
    <% if has_next %>
      <%= link_to text_icon("다음", :arrow_right), url_for(request.query_parameters.merge(page: page + 1)), class: "btn btn-secondary btn-sm" %>
    <% else %>
      <span></span>
    <% end %>
  </nav>
<% end %>
