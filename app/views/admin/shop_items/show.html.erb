<div class="max-w-lg space-y-6">
  <div class="page-header">
    <h1 class="page-title"><%= @shop_item.name %></h1>
    <div class="page-actions">
      <%= link_to "수정", edit_admin_shop_item_path(@shop_item), class: "btn btn-secondary btn-sm" %>
      <%= button_to "삭제", admin_shop_item_path(@shop_item), method: :delete,
            form: { data: { turbo_confirm: "정말 삭제할까요?" } },
            class: "btn btn-danger btn-sm" %>
    </div>
  </div>
  <dl class="card text-sm">
    <div class="flex justify-between py-1"><dt class="text-steel">분류</dt><dd class="text-ink"><%= @shop_item.category %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">가격</dt><dd class="text-ink"><%= @shop_item.cost %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">소모품</dt><dd class="text-ink"><%= @shop_item.consumable? ? "예" : "아니오" %></dd></div>
    <div class="flex justify-between py-1"><dt class="text-steel">효과</dt><dd class="font-mono text-xs text-ink"><%= @shop_item.effect %></dd></div>
  </dl>
</div>
