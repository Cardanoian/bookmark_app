<%# 상점 아이템 폼. local: shop_item. effect 는 JSON 텍스트에어리어. %>
<%= form_with model: shop_item, url: (shop_item.persisted? ? admin_shop_item_path(shop_item) : admin_shop_items_path),
      class: "max-w-lg space-y-4 rounded-lg border border-gray-200 bg-white p-5" do |f| %>
  <% if shop_item.errors.any? %>
    <div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700">
      <%= shop_item.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "이름", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :category, "분류", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.select :category, ShopItem.categories.keys.map { |c| [ c, c ] }, {}, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :cost, "가격(포인트)", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.number_field :cost, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :icon, "아이콘", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.text_field :icon, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
    <div>
      <%= f.label :image_key, "이미지 키", class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.text_field :image_key, class: "w-full rounded-lg border border-gray-300 p-2 text-sm" %>
    </div>
  </div>
  <label class="flex items-center gap-2 text-sm text-gray-700">
    <%= f.check_box :consumable %> 소모품
  </label>
  <div>
    <%= f.label :effect_json, "효과(effect) JSON", class: "mb-1 block text-sm font-medium text-gray-700" %>
    <%= f.text_area :effect_json, value: (shop_item.effect.present? ? JSON.pretty_generate(shop_item.effect) : ""),
          rows: 4, class: "w-full rounded-lg border border-gray-300 p-2 font-mono text-xs" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white" %>
    <%= link_to "취소", admin_shop_items_path, class: "text-sm text-gray-500" %>
  </div>
<% end %>
