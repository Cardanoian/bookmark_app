<%# 상점 아이템 폼. local: shop_item. effect 는 JSON 텍스트에어리어. %>
<%= form_with model: shop_item, url: (shop_item.persisted? ? admin_shop_item_path(shop_item) : admin_shop_items_path),
      class: "max-w-lg space-y-4 card" do |f| %>
  <% if shop_item.errors.any? %>
    <div class="state-banner state-banner--error" role="alert">
      <span aria-hidden="true">⚠️</span>
      <span><%= shop_item.errors.full_messages.to_sentence %></span>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "이름", class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= f.label :category, "분류", class: "form-label" %>
      <%= f.select :category, ShopItem.categories.keys.map { |c| [ c, c ] }, {}, class: "form-select" %>
    </div>
    <div>
      <%= f.label :cost, "가격(포인트)", class: "form-label" %>
      <%= f.number_field :cost, class: "form-input" %>
    </div>
    <div>
      <%= f.label :icon, "아이콘", class: "form-label" %>
      <%= f.text_field :icon, class: "form-input" %>
    </div>
    <div>
      <%= f.label :image_key, "이미지 키", class: "form-label" %>
      <%= f.text_field :image_key, class: "form-input" %>
    </div>
  </div>
  <label class="flex items-center gap-2 text-sm text-slate">
    <%= f.check_box :consumable %> 소모품
  </label>
  <div>
    <%= f.label :effect_json, "효과(effect) JSON", class: "form-label" %>
    <%= f.text_area :effect_json, value: (shop_item.effect.present? ? JSON.pretty_generate(shop_item.effect) : ""),
          rows: 4, class: "form-textarea font-mono text-xs" %>
  </div>

  <div class="flex items-center gap-3">
    <%= f.submit "저장", class: "btn btn-primary" %>
    <%= link_to "취소", admin_shop_items_path, class: "text-sm text-steel hover:underline" %>
  </div>
<% end %>
