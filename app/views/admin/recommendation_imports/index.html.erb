<% content_for :title, "추천도서 관리 · 책갈피" %>

<div class="space-y-6">
  <div class="page-header">
    <div>
      <h1 class="page-title">추천도서 관리</h1>
      <p class="mt-1 text-sm text-steel">추천도서 엑셀을 올리면 어린이 분과만 읽어 학생 홈 목록을 교체합니다.</p>
    </div>
  </div>

  <section class="card space-y-4">
    <div>
      <h2 class="text-base font-bold text-ink">새 추천도서 엑셀 업로드</h2>
      <p class="mt-1 text-sm text-steel">
        필수 열: 분과명, 책제목, 저자, 출판사, ISBN · 최대 10MB · XLSX 형식
      </p>
      <p class="mt-1 text-sm text-steel">
        파일을 모두 정상 처리한 뒤에만 기존 목록을 교체하며, 청소년 분과는 자동으로 제외합니다.
      </p>
    </div>
    <%= form_with url: admin_recommendation_imports_path, method: :post,
          html: { multipart: true }, class: "flex flex-col gap-3 sm:flex-row sm:items-end" do |form| %>
      <div class="min-w-0 flex-1">
        <%= form.label :file, "추천도서 XLSX", class: "form-label" %>
        <%= form.file_field :file, accept: ".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              required: true, class: "form-input" %>
      </div>
      <%= form.submit "추천도서 업데이트", class: "btn btn-primary" %>
    <% end %>
  </section>

  <% if @current_import %>
    <section class="card space-y-3">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="text-base font-bold text-ink">현재 추천도서</h2>
          <p class="text-sm text-steel"><%= @current_import.filename %> · <%= @current_import.item_count %>권</p>
        </div>
        <span class="badge badge-success">활성</span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-hairline text-steel">
            <tr><th class="py-2 pr-4">책제목</th><th class="py-2 pr-4">저자</th><th class="py-2 pr-4">분과</th><th class="py-2">호수</th></tr>
          </thead>
          <tbody>
            <% @recommendations.each do |recommendation| %>
              <tr class="border-b border-hairline-soft">
                <td class="py-2 pr-4 font-medium text-ink"><%= recommendation.book.title %></td>
                <td class="py-2 pr-4 text-slate"><%= recommendation.book.author %></td>
                <td class="py-2 pr-4 text-slate"><%= recommendation.section %></td>
                <td class="py-2 text-slate"><%= recommendation.issue %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @current_import.item_count > @recommendations.size %>
        <p class="text-xs text-steel">처음 <%= @recommendations.size %>권을 표시하고 있습니다.</p>
      <% end %>
    </section>
  <% else %>
    <div class="state-banner state-banner--info" role="status">
      <span aria-hidden="true">📚</span>
      <span>아직 등록된 추천도서 파일이 없습니다.</span>
    </div>
  <% end %>

  <% if @imports.any? %>
    <section class="card space-y-3">
      <h2 class="text-base font-bold text-ink">최근 업로드 이력</h2>
      <div class="space-y-2 text-sm">
        <% @imports.each do |recommendation_import| %>
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-hairline-soft py-2 last:border-0">
            <div>
              <span class="font-medium text-ink"><%= recommendation_import.filename %></span>
              <span class="text-steel">· <%= recommendation_import.item_count %>권 · <%= recommendation_import.imported_by&.name || "시스템" %></span>
            </div>
            <span class="text-xs text-steel"><%= l recommendation_import.imported_at, format: :short %></span>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
</div>
