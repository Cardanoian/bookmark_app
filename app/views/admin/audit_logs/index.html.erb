<% content_for :title, "감사 로그 · 관리자 콘솔" %>

<div class="space-y-6">
  <header>
    <h1 class="page-title">감사 로그</h1>
    <p class="page-subtitle">삭제·포인트·비밀번호 초기화·CSV 다운로드 등 중요한 작업의 성공 기록입니다.</p>
  </header>

  <%= form_with url: admin_audit_logs_path, method: :get, class: "card flex flex-wrap items-end gap-3" do |form| %>
    <div>
      <%= form.label :action, "작업", class: "form-label" %>
      <%= form.select :action,
            options_for_select(@actions.map { |value, label| [ label, value ] }, params[:action]),
            { include_blank: "전체 작업" },
            class: "form-input" %>
    </div>
    <div>
      <%= form.label :actor_id, "실행자 ID", class: "form-label" %>
      <%= form.number_field :actor_id, value: params[:actor_id], min: 1, class: "form-input w-32" %>
    </div>
    <div>
      <%= form.label :from, "시작일", class: "form-label" %>
      <%= form.date_field :from, value: params[:from], class: "form-input" %>
    </div>
    <div>
      <%= form.label :to, "종료일", class: "form-label" %>
      <%= form.date_field :to, value: params[:to], class: "form-input" %>
    </div>
    <%= form.submit "조회", class: "btn btn-primary" %>
  <% end %>

  <section class="card overflow-x-auto">
    <table class="w-full min-w-[64rem] text-sm">
      <thead>
        <tr class="border-b border-hairline text-left text-steel">
          <th class="px-2 py-2 font-medium">시각</th>
          <th class="px-2 py-2 font-medium">작업</th>
          <th class="px-2 py-2 font-medium">실행자</th>
          <th class="px-2 py-2 font-medium">대상</th>
          <th class="px-2 py-2 font-medium">범위</th>
          <th class="px-2 py-2 font-medium">세부 정보</th>
          <th class="px-2 py-2 font-medium">IP</th>
        </tr>
      </thead>
      <tbody>
        <% @audit_logs.each do |log| %>
          <tr class="border-b border-hairline-soft align-top last:border-0">
            <td class="whitespace-nowrap px-2 py-3"><%= l(log.created_at, format: :short) %></td>
            <td class="px-2 py-3 font-medium text-ink"><%= log.action_label %></td>
            <td class="px-2 py-3">
              <%= log.actor&.name || "삭제된 계정" %>
              <span class="block text-xs text-steel">#<%= log.actor_id || "—" %> · <%= log.actor_role %></span>
            </td>
            <td class="whitespace-nowrap px-2 py-3"><%= log.target_type || "—" %>#<%= log.target_id || "—" %></td>
            <td class="whitespace-nowrap px-2 py-3 text-steel">학교 <%= log.school_id || "—" %> · 학급 <%= log.classroom_id || "—" %></td>
            <td class="max-w-sm px-2 py-3 text-xs text-steel"><%= log.metadata.to_json %></td>
            <td class="whitespace-nowrap px-2 py-3 text-steel"><%= log.ip_address || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @audit_logs.empty? %>
      <%= render "shared/empty_state", message: "조건에 맞는 감사 로그가 없습니다.", icon: :document %>
    <% end %>
  </section>

  <div class="flex justify-between">
    <% if @page > 1 %>
      <%= link_to "이전", admin_audit_logs_path(request.query_parameters.merge(page: @page - 1)), class: "btn btn-secondary" %>
    <% else %>
      <span></span>
    <% end %>
    <% if @has_next_page %>
      <%= link_to "다음", admin_audit_logs_path(request.query_parameters.merge(page: @page + 1)), class: "btn btn-secondary" %>
    <% end %>
  </div>
</div>
