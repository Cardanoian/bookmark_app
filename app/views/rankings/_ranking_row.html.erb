<%# locals: (user:, rank: nil) %>
<%# 학급 랭킹 한 줄. Pointable 브로드캐스트에서도 재사용. %>
<div id="<%= dom_id(user, :ranking) %>" class="flex items-center justify-between rounded-lg border border-hairline-soft px-4 py-3">
  <div class="flex items-center gap-3">
    <% if rank %>
      <span class="w-6 text-center text-sm font-bold <%= rank <= 3 ? "text-yellow-dark" : "text-muted" %>"><%= rank %></span>
    <% end %>
    <span class="flex h-8 w-8 shrink-0 items-center justify-center text-2xl" aria-hidden="true">
      <%= user.active_monster ? monster_sprite(user.active_monster.species, img_class: "h-8 w-8 object-contain") : "🥚" %>
    </span>
    <span>
      <span class="block text-sm font-medium text-ink"><%= user.name %></span>
      <span class="block text-xs text-steel">Lv.<%= user.trainer_level %> · <%= user.points %>P</span>
    </span>
  </div>
  <span class="badge badge-yellow"><%= user.experience %>XP</span>
</div>
