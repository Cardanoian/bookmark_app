<% content_for :title, "랭킹 · 책갈피" %>

<% tabs = { "class" => "우리 반", "school" => "우리 학교", "nation" => "전국", "challenge" => "챌린지", "hall" => "명예의 전당" } %>

<div class="page-shell page-shell-wide">
  <%= render "shared/student_nav", active: :rankings %>

  <nav class="mb-6 flex flex-wrap gap-2" aria-label="랭킹 탭">
    <% tabs.each do |key, label| %>
      <%= link_to label, rankings_path(tab: key),
            aria: { current: (@tab == key ? "page" : nil) },
            class: "flex min-h-[2.75rem] items-center rounded-full px-4 text-sm font-medium transition #{@tab == key ? "bg-primary text-white" : "border border-hairline text-slate hover:bg-surface"}" %>
    <% end %>
  </nav>

  <% case @tab %>
  <% when "class" %>
    <% if current_user.classroom %>
      <%= turbo_stream_from current_user.classroom, :ranking %>
    <% end %>
    <% if @ranking.any? %>
      <%= render "rankings/podium", podium: @podium %>
      <div class="space-y-2">
        <% @ranking.each_with_index do |student, index| %>
          <%= render "rankings/ranking_row", user: student, rank: index + 1 %>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "아직 학급 랭킹이 없어요.", icon: "🏫" %>
    <% end %>

  <% when "school", "nation" %>
    <% if @ranking.any? %>
      <div class="space-y-2">
        <% @ranking.each_with_index do |entry, index| %>
          <% rank = entry.meta[:rank] || index + 1 %>
          <% if entry.meta[:self] && rank > index + 1 %>
            <div class="py-1 text-center text-muted" aria-hidden="true">⋯</div>
          <% end %>
          <% row_class = entry.meta[:self] ? "border-brand-blue bg-surface-featured" : "border-hairline-soft bg-canvas" %>
          <div class="flex items-center justify-between rounded-lg border px-4 py-3 <%= row_class %>">
            <div class="flex items-center gap-3">
              <span class="w-8 text-center text-sm font-bold <%= rank <= 3 ? "text-yellow-dark" : "text-muted" %>"><%= rank %></span>
              <span class="text-sm font-medium text-ink">
                <%= entry.subject.respond_to?(:label) ? "#{entry.subject.school.name} #{entry.subject.label}" : entry.subject.name %>
                <% if entry.meta[:self] %><span class="badge badge-info ml-1">우리 학교</span><% end %>
              </span>
            </div>
            <span class="text-sm font-bold text-yellow-dark"><%= entry.score %>P</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "집계할 데이터가 아직 없어요.", icon: "📊" %>
    <% end %>

  <% when "challenge" %>
    <% if @challenge && @ranking.any? %>
      <p class="mb-4 text-sm font-medium text-slate"><%= @challenge.title %></p>
      <div class="space-y-2">
        <% @ranking.each_with_index do |entry, index| %>
          <div class="flex items-center justify-between rounded-lg border border-hairline-soft px-4 py-3">
            <div class="flex items-center gap-3">
              <span class="w-6 text-center text-sm font-bold <%= index < 3 ? "text-yellow-dark" : "text-muted" %>"><%= index + 1 %></span>
              <span class="text-sm font-medium text-ink"><%= entry.subject.name %></span>
            </div>
            <span class="text-sm font-bold text-yellow-dark"><%= entry.score %>회 참여</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "진행 중인 챌린지 참여 기록이 없어요.", icon: "🔥" %>
    <% end %>

  <% when "hall" %>
    <% if @ranking.any? %>
      <div class="space-y-2">
        <% @ranking.each_with_index do |entry, index| %>
          <% row_class = index < 3 ? "border-brand-yellow bg-surface-yellow" : "border-hairline-soft bg-canvas" %>
          <div class="flex items-center justify-between rounded-lg border px-4 py-3 <%= row_class %>">
            <div class="flex items-center gap-3">
              <span class="w-6 text-center text-sm font-bold <%= index < 3 ? "text-yellow-dark" : "text-muted" %>"><%= index + 1 %></span>
              <span class="flex h-8 w-8 shrink-0 items-center justify-center text-2xl" aria-hidden="true">
                <%= entry.subject.active_monster ? monster_sprite(entry.subject.active_monster.species, img_class: "h-8 w-8 object-contain") : "🥚" %>
              </span>
              <div>
                <p class="text-sm font-medium text-ink"><%= entry.subject.name %></p>
                <p class="text-xs text-steel">도감 <%= entry.meta[:dex] %> · 완전형 <%= entry.meta[:complete] %></p>
              </div>
            </div>
            <span class="text-sm font-bold text-yellow-dark">성장 <%= entry.score %></span>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", message: "아직 명예의 전당 주인공이 없어요. 도감을 채워 보세요!", icon: "👑" %>
    <% end %>
  <% end %>
</div>
