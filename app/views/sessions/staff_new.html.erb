<%# 교직원(교사·교무관리자·사서·총괄관리자) 로그인 — 이메일·비밀번호. post → login/staff. %>
<div class="w-full max-w-md mx-auto">
  <h1 class="mb-6 text-center text-2xl font-bold text-ink"><span aria-hidden="true">👩‍🏫</span> 선생님 로그인</h1>
  <div class="card">
    <%# flash 오류는 공통 상단 토스트(shared/_flash)가 담당 — 여기서 중복 렌더하지 않음. %>
    <%= form_with url: staff_login_path, method: :post, local: true, class: "space-y-4" do |f| %>
      <div>
        <%= label_tag :email, "이메일", class: "form-label" %>
        <%= email_field_tag :email, nil, autocomplete: "email", autofocus: true,
              class: "form-input" %>
      </div>
      <div>
        <%= label_tag :password, "비밀번호", class: "form-label" %>
        <%= password_field_tag :password, nil, autocomplete: "current-password",
              class: "form-input" %>
      </div>
      <%= submit_tag "로그인", class: "btn btn-primary btn-block" %>
    <% end %>
  </div>
  <%= link_to "선생님 회원가입", new_registration_path,
        class: "btn btn-secondary btn-block mt-4" %>
  <p class="mt-4 text-center text-sm">
    <%= link_to "← 로그인 선택으로", new_session_path, class: "text-steel underline" %>
  </p>
</div>
