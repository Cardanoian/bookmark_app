<%# 교직원(교사·교무관리자·사서·총괄관리자) 로그인 — 이메일·비밀번호. post → login/staff. %>
<div class="w-full max-w-md mx-auto">
  <h1 class="text-2xl font-bold mb-6">👩‍🏫 선생님 로그인</h1>

  <% if flash[:alert] %>
    <div class="mb-4 rounded bg-red-100 px-4 py-2 text-red-800"><%= flash[:alert] %></div>
  <% end %>

  <%= form_with url: staff_login_path, method: :post, local: true, class: "space-y-4" do |f| %>
    <div>
      <%= label_tag :email, "이메일", class: "block text-sm font-medium" %>
      <%= email_field_tag :email, nil, autocomplete: "email", autofocus: true,
            class: "mt-1 block w-full rounded border-gray-300" %>
    </div>

    <div>
      <%= label_tag :password, "비밀번호", class: "block text-sm font-medium" %>
      <%= password_field_tag :password, nil, autocomplete: "current-password",
            class: "mt-1 block w-full rounded border-gray-300" %>
    </div>

    <%= submit_tag "로그인", class: "w-full rounded bg-emerald-600 px-4 py-2 text-white" %>
  <% end %>

  <p class="mt-4 text-sm text-center space-x-3">
    <%= link_to "교사 가입 신청", new_registration_path, class: "text-emerald-700 underline" %>
    <%= link_to "← 로그인 선택으로", new_session_path, class: "text-gray-500 underline" %>
  </p>
</div>
