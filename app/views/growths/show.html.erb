<% content_for :title, "나의 성장 · 책갈피" %>

<div class="page-shell page-shell-wide space-y-6">
  <%= render "shared/student_nav", active: :growth %>

  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-steel">남과 겨루는 점수가 아니라, 지난 나와 견주는 기록이에요</p>
      <h1 class="page-title mt-1">나의 성장</h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "닉네임·공개 설정", edit_ranking_preference_path, class: "btn btn-secondary" %>
      <%= link_to "랭킹 보기", rankings_path, class: "btn btn-primary" %>
    </div>
  </header>

  <section class="grid gap-3 sm:grid-cols-3" aria-label="성장 요약">
    <div class="stat-card">
      <span class="stat-card__label">확인받은 독후감</span>
      <span class="stat-card__value"><%= @timeline.approved_report_count %>편</span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">최근 5축 평균</span>
      <span class="stat-card__value"><%= @timeline.latest ? "#{@timeline.latest.average}/5" : "—" %></span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">마지막 기록</span>
      <span class="stat-card__value text-lg">
        <%= @timeline.latest ? @timeline.latest.report.created_at.strftime("%-m월 %-d일") : "—" %>
      </span>
    </div>
  </section>

  <% if @timeline.entries.empty? %>
    <%= render "shared/empty_state",
          message: "선생님이 확인한 독후감이 생기면 여기에서 나의 변화를 볼 수 있어요.",
          icon: :chart %>
  <% else %>
    <% latest = @timeline.latest %>
    <% previous = @timeline.previous %>
    <% changes = @timeline.changes %>

    <% if (growth = @timeline.strongest_growth_axis) %>
      <p class="state-banner state-banner--success">
        <%= ui_icon :sparkle %>
        지난 글보다 <strong><%= ReadingDomain::AXIS_LABELS.fetch(growth.first) %> 영역이 가장 많이 성장</strong>했어요(+<%= growth.last %>점).
      </p>
    <% end %>

    <section class="card" aria-labelledby="growth-change-title">
      <h2 id="growth-change-title" class="text-lg font-bold text-ink">최근 글과 지난 글 비교</h2>

      <div class="mt-4 flex flex-col items-center gap-6 sm:flex-row sm:items-start">
        <%# 5축 방사형 차트 — 실선=최근 글, 회색 점선=지난 글(있을 때만) %>
        <div class="shrink-0">
          <%= radar_chart_svg(latest.scores,
                              compare: previous&.scores,
                              size: 280,
                              aria_label: "최근 독후감 5축 방사형 차트") %>
        </div>

        <div class="w-full min-w-0 flex-1">
          <p class="mb-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-steel">
            <span class="inline-flex items-center gap-1.5">
              <span class="inline-block h-0.5 w-5 rounded bg-brand-blue"></span>
              최근 「<%= latest.report.book&.title.presence || latest.report.book_title %>」
            </span>
            <% if previous %>
              <span class="inline-flex items-center gap-1.5">
                <span class="inline-block h-0.5 w-5 border-t-2 border-dashed border-stone"></span>
                지난 「<%= previous.report.book&.title.presence || previous.report.book_title %>」
              </span>
            <% end %>
          </p>

          <ul class="space-y-3">
            <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
              <% score = latest.scores.fetch(axis) %>
              <% change = previous ? changes[axis] : nil %>
              <li>
                <div class="mb-1 flex items-baseline justify-between gap-2">
                  <span class="flex items-baseline gap-2">
                    <span class="text-sm font-semibold text-ink"><%= ReadingDomain::AXIS_LABELS.fetch(axis) %></span>
                    <% if change.present? && !change.zero? %>
                      <span class="badge <%= change.positive? ? "badge-success" : "badge-neutral" %>">
                        <%= change.positive? ? "+" : "" %><%= change %>
                      </span>
                    <% end %>
                  </span>
                  <span class="shrink-0 text-sm font-bold text-brand-blue"><%= score %>점</span>
                </div>
                <div class="progress-bar">
                  <div class="progress-bar__fill bg-brand-blue" style="width: <%= (score.to_i * 20) %>%"></div>
                </div>
                <% if (hint = @axis_hints[axis]).present? %>
                  <p class="mt-1 text-sm text-stone"><%= hint %></p>
                <% end %>
              </li>
            <% end %>
          </ul>

          <% unless previous %>
            <p class="mt-4 text-sm text-steel">첫 성장 기준점이 생겼어요. 다음 독후감이 승인되면 지난 글과 견줘 볼 수 있어요.</p>
          <% end %>
        </div>
      </div>
    </section>

    <section class="card" aria-labelledby="growth-timeline-title">
      <div class="mb-4">
        <h2 id="growth-timeline-title" class="text-lg font-bold text-ink">시간에 따른 변화</h2>
        <p class="mt-1 text-sm text-steel">최근 <%= StudentGrowthTimeline::LIMIT %>편까지 시간순으로 보여요. 교사 조정 점수가 있으면 그 점수를 사용해요.</p>
      </div>

      <ul class="space-y-3">
        <% @timeline.entries.each do |entry| %>
          <li>
            <%= link_to report_path(entry.report), class: "group block" do %>
              <div class="mb-1 flex items-baseline justify-between gap-2">
                <span class="min-w-0 truncate text-sm font-medium text-slate group-hover:underline">
                  <%= entry.report.created_at.strftime("%-m월 %-d일") %> ·
                  <%= entry.report.book&.title.presence || entry.report.book_title %>
                </span>
                <span class="shrink-0 text-sm font-bold text-brand-blue"><%= entry.average %></span>
              </div>
              <div class="progress-bar">
                <div class="progress-bar__fill bg-brand-blue" style="width: <%= ((entry.average / 5.0) * 100).round %>%"></div>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>

      <details class="mt-5 border-t border-hairline-soft pt-4">
        <summary class="cursor-pointer text-sm font-medium text-brand-blue">축별 점수를 표로 보기</summary>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[46rem] text-sm">
            <thead>
              <tr class="border-b border-hairline text-left text-steel">
                <th class="px-2 py-2 font-medium">날짜·책</th>
                <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                  <th class="px-2 py-2 text-center font-medium"><%= ReadingDomain::AXIS_LABELS.fetch(axis) %></th>
                <% end %>
                <th class="px-2 py-2 text-center font-medium">평균</th>
              </tr>
            </thead>
            <tbody>
              <% @timeline.entries.each do |entry| %>
                <tr class="border-b border-hairline-soft last:border-0">
                  <td class="px-2 py-3">
                    <%= link_to report_path(entry.report), class: "font-medium text-ink hover:underline" do %>
                      <span class="block"><%= entry.report.book&.title.presence || entry.report.book_title %></span>
                      <span class="block text-xs font-normal text-steel"><%= entry.report.created_at.to_date %></span>
                    <% end %>
                  </td>
                  <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                    <td class="px-2 py-3 text-center">
                      <span class="badge badge-neutral"><%= entry.scores.fetch(axis) %>/5</span>
                    </td>
                  <% end %>
                  <td class="px-2 py-3 text-center font-bold text-brand-blue"><%= entry.average %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </details>
    </section>
  <% end %>
</div>
