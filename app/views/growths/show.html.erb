<% content_for :title, "나의 성장 · 책갈피" %>

<div class="page-shell page-shell-wide space-y-6">
  <%= render "shared/student_nav", active: :growth %>

  <header class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-steel">다른 친구가 아닌 어제의 나와 비교해요</p>
      <h1 class="page-title mt-1">나의 성장</h1>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= link_to "닉네임·참여 설정", edit_ranking_preference_path, class: "btn btn-secondary" %>
      <% if current_user.ranking_opted_in? %>
        <%= link_to "랭킹 보기", rankings_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </header>

  <section class="grid gap-3 sm:grid-cols-3" aria-label="성장 요약">
    <div class="stat-card">
      <span class="stat-card__label">승인된 독후감</span>
      <span class="stat-card__value"><%= @timeline.approved_report_count %>편</span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">최근 5축 평균</span>
      <span class="stat-card__value"><%= @timeline.latest ? "#{@timeline.latest.average}/5" : "—" %></span>
    </div>
    <div class="stat-card">
      <span class="stat-card__label">최근 기록</span>
      <span class="stat-card__value text-lg"><%= @timeline.latest&.report&.created_at&.to_date || "—" %></span>
    </div>
  </section>

  <% if @timeline.entries.empty? %>
    <%= render "shared/empty_state",
          message: "선생님이 확인한 독후감이 생기면 여기에서 나의 변화를 볼 수 있어요.",
          icon: :chart %>
  <% else %>
    <section class="card" aria-labelledby="growth-change-title">
      <h2 id="growth-change-title" class="text-lg font-bold text-ink">최근 글과 지난 글 비교</h2>
      <% if @timeline.previous %>
        <p class="mt-1 text-sm text-steel">
          <%= @timeline.previous.report.book&.title.presence || @timeline.previous.report.book_title %>
          → <%= @timeline.latest.report.book&.title.presence || @timeline.latest.report.book_title %>
        </p>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-5">
          <% @timeline.changes.each do |axis, change| %>
            <% tone = change.positive? ? "text-green-700" : (change.negative? ? "text-red-700" : "text-steel") %>
            <div class="rounded-xl border border-hairline-soft p-3 text-center">
              <p class="text-xs text-steel"><%= ReadingDomain::AXIS_LABELS.fetch(axis) %></p>
              <p class="mt-1 text-lg font-bold <%= tone %>"><%= change.positive? ? "+" : "" %><%= change %></p>
            </div>
          <% end %>
        </div>
        <% if (growth = @timeline.strongest_growth_axis) %>
          <p class="mt-4 state-banner state-banner--success">
            <%= ui_icon :sparkle %>
            최근 글에서 <%= ReadingDomain::AXIS_LABELS.fetch(growth.first) %> 영역이 가장 많이 성장했어요.
          </p>
        <% end %>
      <% else %>
        <p class="mt-2 text-sm text-steel">첫 성장 기준점이 생겼어요. 다음 독후감이 승인되면 변화를 비교해 드릴게요.</p>
      <% end %>
    </section>

    <section class="card" aria-labelledby="growth-timeline-title">
      <div class="mb-4">
        <h2 id="growth-timeline-title" class="text-lg font-bold text-ink">최근 독후감 5축 기록</h2>
        <p class="mt-1 text-sm text-steel">최근 <%= StudentGrowthTimeline::LIMIT %>편까지 시간순으로 보여요. 교사 조정 점수가 있으면 그 점수를 사용해요.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[46rem] text-sm">
          <thead>
            <tr class="border-b border-hairline text-left text-steel">
              <th class="px-2 py-2 font-medium">날짜·책</th>
              <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                <th class="px-2 py-2 text-center font-medium"><%= ReadingDomain::AXIS_LABELS.fetch(axis) %></th>
              <% end %>
              <th class="px-2 py-2 text-center font-medium">평균</th>
            </tr>
          </thead>
          <tbody>
            <% @timeline.entries.each do |entry| %>
              <tr class="border-b border-hairline-soft last:border-0">
                <td class="px-2 py-3">
                  <%= link_to report_path(entry.report), class: "font-medium text-ink hover:underline" do %>
                    <span class="block"><%= entry.report.book&.title.presence || entry.report.book_title %></span>
                    <span class="block text-xs font-normal text-steel"><%= entry.report.created_at.to_date %></span>
                  <% end %>
                </td>
                <% ReadingDomain::RUBRIC_AXES.each do |axis| %>
                  <td class="px-2 py-3 text-center">
                    <span class="badge badge-neutral"><%= entry.scores.fetch(axis) %>/5</span>
                  </td>
                <% end %>
                <td class="px-2 py-3 text-center font-bold text-brand-blue"><%= entry.average %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
